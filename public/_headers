# Netlify response headers. (Vercel gets the same rules from vercel.json.)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'
  Permissions-Policy: camera=(), microphone=(), payment=(), usb=()

# Built files have a fingerprint in their name, so browsers can keep them for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Photos and logos: keep for a week. (Not /team/*: the agent pages live there too, and pages must stay fresh.)
/hero/*
  Cache-Control: public, max-age=604800
/people/*
  Cache-Control: public, max-age=604800
/brand/*
  Cache-Control: public, max-age=604800

# Alert email templates for Repliers (email-templates/): each link downloads the file instead of opening it as a page,
# and search engines are told not to list them.
/files/email-templates/*
  Content-Disposition: attachment
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache

# Facebook catalog feed (src/pages/feeds/meta-home-listings.csv.ts): for Meta only, not for Google.
/feeds/*
  X-Robots-Tag: noindex
