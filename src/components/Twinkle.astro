---
// Starlight over the skyline photo: small four-point sparkles that slowly fade in and out.
// Pure CSS (no script, nothing to download). Stays still for visitors who turn off motion.
// Spots are fixed (not random) so every visit looks the same: [left %, top %, size px, delay s, duration s].
const stars: [number, number, number, number, number][] = [
  [6, 8, 9, 0, 3.6], [14, 22, 6, 1.4, 4.2], [22, 6, 7, 2.6, 3.2], [29, 30, 5, 0.8, 4.8], [36, 14, 10, 3.1, 3.9],
  [44, 4, 6, 1.9, 4.4], [52, 24, 8, 0.3, 3.4], [58, 10, 5, 2.2, 5.0], [63, 34, 7, 3.6, 3.8], [69, 18, 11, 1.1, 4.1],
  [75, 5, 6, 2.9, 3.5], [81, 27, 8, 0.6, 4.6], [86, 12, 5, 3.3, 3.7], [91, 32, 9, 1.7, 4.3], [96, 7, 6, 2.4, 3.3],
  [40, 38, 5, 4.0, 4.9], [18, 40, 6, 2.0, 4.0], [73, 42, 5, 1.2, 4.5],
];
---
<div class="twinkle" aria-hidden="true">
  {stars.map(([x, y, s, d, t]) => (
    <span class:list={[(x <= 8 || x >= 86 || y <= 8) && 'edge']} style={`left:${x}%;top:${y}%;--s:${s}px;animation-delay:${d}s;animation-duration:${t}s`}></span>
  ))}
</div>

<style>
  .twinkle { position: absolute; inset: 0; pointer-events: none; z-index: 0; }
  .twinkle span {
    position: absolute; width: var(--s); height: var(--s); margin: calc(var(--s) / -2) 0 0 calc(var(--s) / -2);
    background: radial-gradient(circle, #fff 0 18%, rgba(255, 244, 214, .55) 32%, transparent 70%);
    border-radius: 50%; opacity: .35; animation: twinkle 4s ease-in-out infinite;
  }
  /* The two thin rays that make each light a four-point star */
  .twinkle span::before, .twinkle span::after {
    content: ""; position: absolute; left: 50%; top: 50%; width: calc(var(--s) * 3.2); height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 250, 235, .85), transparent);
    transform: translate(-50%, -50%);
  }
  .twinkle span::after { transform: translate(-50%, -50%) rotate(90deg); }
  @keyframes twinkle {
    0%, 100% { opacity: .2; transform: scale(.6) rotate(0deg); }
    50% { opacity: 1; transform: scale(1.15) rotate(20deg); }
  }
  /* On phones the words cover the whole photo, so only the sparkles along the top and sides stay. */
  @media (max-width: 700px) { .twinkle span:not(.edge) { display: none; } }
  @media (prefers-reduced-motion: reduce) { .twinkle span { animation: none; opacity: .7; } }
</style>
