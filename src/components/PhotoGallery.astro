---
// A listing's photos: the main photo with arrows and a "3 / 42" counter; clicking a photo opens a full-screen viewer
// with next/previous arrows, keyboard arrows, swipe and Esc. Every photo from the MLS is included (src/lib/mls-feed.mjs);
// only the first loads right away, the rest as they're needed.
interface Props { photos: string[]; alt: string }
const { photos, alt } = Astro.props;
const src = (p: string, size: string) => `${p}?class=${size}`;
---
{photos.length > 0 ? (
  <div class="gal" data-gal>
    <div class="gal__main">
      <ul class="gal__track" data-track tabindex="0" aria-label={`${photos.length} photos. Use the arrows to see more.`}>
        {photos.map((p, i) => (
          <li><button type="button" class="gal__open" data-open={i} aria-label={`Open photo ${i + 1} of ${photos.length} full screen`}>
            <img src={src(p, i ? 'medium' : 'large')} alt={`Photo ${i + 1} of ${photos.length}: ${alt}`} width="1200" height="800" loading={i ? 'lazy' : 'eager'} fetchpriority={i ? undefined : 'high'} decoding="async" />
          </button></li>
        ))}
      </ul>
      {photos.length > 1 && <>
        <button type="button" class="gal__arrow gal__arrow--prev" data-step="-1" aria-label="Previous photo">‹</button>
        <button type="button" class="gal__arrow gal__arrow--next" data-step="1" aria-label="Next photo">›</button>
      </>}
      <span class="gal__count" data-count>1 / {photos.length}</span>
      <button type="button" class="gal__all" data-open="0">See all {photos.length} photos</button>
    </div>
    <dialog class="gal__box" data-box aria-label="Photos">
      <button type="button" class="gal__x" data-close aria-label="Close photos">×</button>
      <img class="gal__big" data-big alt="" />
      {photos.length > 1 && <>
        <button type="button" class="gal__arrow gal__arrow--prev" data-big-step="-1" aria-label="Previous photo">‹</button>
        <button type="button" class="gal__arrow gal__arrow--next" data-big-step="1" aria-label="Next photo">›</button>
      </>}
      <span class="gal__count gal__count--big" data-big-count></span>
    </dialog>
    <script type="application/json" data-photos set:html={JSON.stringify(photos.map((p) => src(p, 'large')))} />
  </div>
) : <div class="gal__none">Photos coming soon</div>}

<script>
  for (const gal of document.querySelectorAll<HTMLElement>('[data-gal]')) {
    const big: string[] = JSON.parse(gal.querySelector('[data-photos]')!.textContent!);
    const track = gal.querySelector<HTMLElement>('[data-track]')!;
    const count = gal.querySelector<HTMLElement>('[data-count]')!;
    const box = gal.querySelector<HTMLDialogElement>('[data-box]')!;
    const img = box.querySelector<HTMLImageElement>('[data-big]')!;
    const bigCount = box.querySelector<HTMLElement>('[data-big-count]')!;
    const n = big.length;
    let at = 0;
    // Inline gallery: arrows scroll one photo; the counter follows the scroll.
    const current = () => Math.round(track.scrollLeft / (track.firstElementChild as HTMLElement).offsetWidth);
    track.addEventListener('scroll', () => { count.textContent = `${Math.min(n, current() + 1)} / ${n}`; }, { passive: true });
    gal.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) => b.addEventListener('click', () => {
      const i = (current() + Number(b.dataset.step) + n) % n;
      track.scrollTo({ left: (track.children[i] as HTMLElement).offsetLeft - track.offsetLeft, behavior: 'smooth' });
    }));
    // Full-screen viewer.
    const show = (i: number) => {
      at = (i + n) % n;
      img.src = big[at];
      img.alt = `Photo ${at + 1} of ${n}`;
      bigCount.textContent = `${at + 1} / ${n}`;
      new Image().src = big[(at + 1) % n]; // have the next one ready
    };
    gal.querySelectorAll<HTMLElement>('[data-open]').forEach((b) => b.addEventListener('click', () => {
      show(b.dataset.open === '0' && b.classList.contains('gal__all') ? 0 : Number(b.dataset.open));
      box.showModal();
    }));
    box.querySelectorAll<HTMLButtonElement>('[data-big-step]').forEach((b) => b.addEventListener('click', () => show(at + Number(b.dataset.bigStep))));
    box.querySelector('[data-close]')!.addEventListener('click', () => box.close());
    box.addEventListener('click', (e) => { if (e.target === box) box.close(); });
    box.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') show(at + 1); if (e.key === 'ArrowLeft') show(at - 1); });
    let x0: number | null = null;
    box.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    box.addEventListener('touchend', (e) => { if (x0 == null) return; const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 40) show(at + (dx < 0 ? 1 : -1)); x0 = null; });
    box.addEventListener('close', () => { const el = track.children[at] as HTMLElement | undefined; if (el) track.scrollTo({ left: el.offsetLeft - track.offsetLeft }); });
  }
</script>

<style>
  .gal { margin-bottom: 2rem; }
  .gal__main { position: relative; }
  .gal__track { display: flex; gap: .5rem; margin: 0; padding: 0; list-style: none; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .gal__track::-webkit-scrollbar { display: none; }
  .gal__track li { flex: 0 0 100%; scroll-snap-align: start; }
  .gal__open { display: block; width: 100%; padding: 0; border: 0; background: var(--sand); cursor: zoom-in; }
  .gal__open img { display: block; width: 100%; aspect-ratio: 3 / 2; height: auto; object-fit: cover; }
  .gal__arrow { position: absolute; top: 50%; transform: translateY(-50%); z-index: 2; display: grid; place-items: center; width: 3rem; height: 3rem;
    border: 0; border-radius: 50%; background: rgba(255, 255, 255, .92); color: var(--text); font: 400 2rem/1 var(--ui); cursor: pointer; box-shadow: 0 2px 10px rgba(0, 0, 0, .3); }
  .gal__arrow:hover { background: #fff; color: var(--crimson); }
  .gal__arrow--prev { left: .75rem; }
  .gal__arrow--next { right: .75rem; }
  .gal__count { position: absolute; left: .75rem; bottom: .75rem; padding: .35rem .6rem; border-radius: 999px; background: rgba(21, 18, 19, .75); color: #fff; font: 600 .85rem/1 var(--ui); }
  .gal__all { position: absolute; right: .75rem; bottom: .75rem; padding: .55rem .8rem; border: 0; border-radius: 6px; background: #fff; color: var(--text); font: 700 .85rem/1 var(--ui); cursor: pointer; box-shadow: 0 2px 10px rgba(0, 0, 0, .3); }
  .gal__none { display: grid; place-items: center; aspect-ratio: 3 / 1; margin-bottom: 2rem; background: var(--sand); color: var(--text-soft); }
  .gal__box { width: 100vw; height: 100vh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgba(10, 9, 9, .96); }
  .gal__box::backdrop { background: rgba(10, 9, 9, .96); }
  .gal__box[open] { display: grid; place-items: center; }
  .gal__big { max-width: 94vw; max-height: 86vh; object-fit: contain; }
  .gal__x { position: absolute; top: .75rem; right: 1rem; z-index: 3; border: 0; background: none; color: #fff; font: 300 2.6rem/1 var(--ui); cursor: pointer; }
  .gal__count--big { left: 50%; bottom: 1.25rem; transform: translateX(-50%); }
</style>
