---
// YouTube Shorts in a sideways-scrolling row; each plays right on the page.
import { youtubeHtml } from '../lib/youtube.mjs';
import type { Video } from '../data/youtube';
interface Props { shorts: Video[] }
const { shorts } = Astro.props;
---
<ul class="shorts">
  {shorts.map((v) => (
    <li>
      <Fragment set:html={youtubeHtml(v.id, v.title, { short: true })} />
      <p>{v.title}</p>
    </li>
  ))}
</ul>

<style>
  .shorts { list-style: none; margin: 0; padding: 0 0 .75rem; display: flex; gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory; }
  .shorts li { flex: 0 0 clamp(9.5rem, 40vw, 12rem); scroll-snap-align: start; display: grid; gap: .5rem; align-content: start; }
  .shorts p { font: 600 .88rem/1.35 var(--sans); color: var(--text); }
  :global(.section--dark) .shorts p { color: var(--on-dark); }
</style>
