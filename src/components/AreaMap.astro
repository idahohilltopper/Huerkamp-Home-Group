---
// Interactive MapLibre map of community or lake outlines.
//   mode="hub"   all areas; hover highlights, click opens the area's page
//   mode="focus" zooms to one area (focus=slug); others shown faintly and still clickable
// Map imagery: MapTiler when PUBLIC_MAPTILER_KEY is set at build time, otherwise OpenFreeMap.
interface Feature { type: 'Feature'; properties: { slug: string; [k: string]: unknown }; geometry: unknown }
interface Props {
  geojson?: { type: 'FeatureCollection'; features: Feature[] };  // inline outlines (small sets)
  src?: string;                                                    // or a URL to a GeoJSON file (large sets)
  info: Record<string, { name: string; detail: string; href: string }>;
  mode?: 'hub' | 'focus';
  focus?: string;
  label?: string;
  height?: string;
}
const { geojson, src = '', info, mode = 'hub', focus = '', label = 'Hover an area', height = '520px' } = Astro.props;
const key = import.meta.env.PUBLIC_MAPTILER_KEY ?? '';
const style = key
  ? `https://api.maptiler.com/maps/dataviz-light/style.json?key=${key}`
  : 'https://tiles.openfreemap.org/styles/positron';

---
<div class="area-map" style={`--map-h:${height}`}>
  <div class="area-map__canvas" data-map data-style={style} data-mode={mode} data-focus={focus} data-src={src} data-info={JSON.stringify(info)}
    data-geojson={geojson ? JSON.stringify(geojson) : undefined}></div>
  <div class="area-map__panel" aria-live="polite">
    <span class="area-map__hint" data-hint hidden={!!info[focus]}>{label} —</span>
    <strong data-name>{info[focus]?.name}</strong>
    <span data-detail>{info[focus]?.detail}</span>
  </div>
  <noscript><p class="area-map__noscript">Turn on JavaScript to use the map.</p></noscript>
</div>

<script>
  // Load the map library only when a map comes within ~600px of the screen.
  const maps = document.querySelectorAll<HTMLElement>('[data-map]');
  const io = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      io.unobserve(entry.target);
      import('../scripts/area-map').then(({ initMap }) => initMap(entry.target as HTMLElement));
    });
  }, { rootMargin: '600px 0px' });
  maps.forEach((el) => io.observe(el));
</script>

<style>
  .area-map { position: relative; border: 1px solid var(--line); background: #eeeae3; }
  .area-map__canvas { width: 100%; height: var(--map-h); }
  .area-map__panel {
    position: absolute; left: 12px; bottom: 12px; z-index: 2; max-width: calc(100% - 24px);
    display: grid; gap: .1rem; padding: .7rem 1rem; background: rgba(255,255,255,.95); color: #1d1813;
    border: 1px solid #e8e2d6; box-shadow: 0 6px 20px rgba(0,0,0,.08); pointer-events: none;
  }
  .area-map__panel strong { font: 500 1.2rem/1.2 var(--serif); }
  .area-map__panel span { font-size: .9rem; color: #4d4538; }
  .area-map__hint { font: 700 .75rem/1.2 var(--ui) !important; letter-spacing: .12em; text-transform: uppercase; color: #d11241 !important; }
  .area-map__noscript { padding: 1rem; }
</style>
