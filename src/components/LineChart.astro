---
// Single-series line chart (change over time). One hue, 2px line, 8px markers,
// labels on the first and last points, hover/focus tooltip on every point, and a
// table view for screen readers and anyone who prefers numbers.
interface Point { label: string; value: number; display: string }
interface Props { points: Point[]; title: string; caption?: string; valueName: string }
const { points, title, caption, valueName } = Astro.props;

const W = 640, H = 240, padL = 56, padR = 24, padT = 28, padB = 36;
const vals = points.map((p) => p.value);
let lo = Math.min(...vals), hi = Math.max(...vals);
const span = hi - lo || hi * 0.05;
lo -= span * 0.35; hi += span * 0.35;
// Round the axis to tidy steps.
const step = (() => {
  const raw = (hi - lo) / 3, pow = 10 ** Math.floor(Math.log10(raw));
  return [1, 2, 2.5, 5, 10].map((m) => m * pow).find((s) => s >= raw)!;
})();
lo = Math.floor(lo / step) * step; hi = Math.ceil(hi / step) * step;
const x = (i: number) => padL + (i * (W - padL - padR)) / (points.length - 1);
const y = (v: number) => padT + ((hi - v) * (H - padT - padB)) / (hi - lo);
const ticks: number[] = [];
for (let t = lo; t <= hi + 1e-9; t += step) ticks.push(t);
const short = (v: number) => (v >= 1000 ? `${Math.round(v / 100) / 10}k` : String(v));
const path = points.map((p, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(p.value).toFixed(1)}`).join(' ');
---
<figure class="lc">
  <figcaption class="lc__title">{title}</figcaption>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${title}: ${points.map((p) => `${p.label} ${p.display}`).join(', ')}`}>
    {ticks.map((t) => (
      <g class="lc__grid">
        <line x1={padL} x2={W - padR} y1={y(t)} y2={y(t)} />
        <text x={padL - 10} y={y(t) + 4} text-anchor="end">{short(t)}</text>
      </g>
    ))}
    {points.map((p, i) => <text class="lc__x" x={x(i)} y={H - 10} text-anchor="middle">{p.label}</text>)}
    <path class="lc__line" d={path} />
    {points.map((p, i) => (
      <g class="lc__pt" tabindex="0" aria-label={`${p.label}: ${p.display}`}>
        <circle class="lc__hit" cx={x(i)} cy={y(p.value)} r="18" />
        <circle class="lc__dot" cx={x(i)} cy={y(p.value)} r="5" />
        {(i === 0 || i === points.length - 1) && (
          <text class="lc__label" x={x(i)} y={y(p.value) - 14} text-anchor={i === 0 ? 'start' : 'end'}>{p.display}</text>
        )}
        <g class="lc__tip">
          <rect x={Math.min(Math.max(x(i) - 62, 4), W - 128)} y={Math.max(y(p.value) - 58, 2)} width="124" height="40" rx="4" />
          <text x={Math.min(Math.max(x(i), 66), W - 66)} y={Math.max(y(p.value) - 58, 2) + 17} text-anchor="middle">{p.label}</text>
          <text class="lc__tipv" x={Math.min(Math.max(x(i), 66), W - 66)} y={Math.max(y(p.value) - 58, 2) + 33} text-anchor="middle">{p.display}</text>
        </g>
      </g>
    ))}
  </svg>
  {caption && <p class="lc__caption">{caption}</p>}
  <details class="lc__table">
    <summary>Show as a table</summary>
    <table><thead><tr><th scope="col">Year</th><th scope="col">{valueName}</th></tr></thead>
      <tbody>{points.map((p) => <tr><td>{p.label}</td><td>{p.display}</td></tr>)}</tbody></table>
  </details>
</figure>

<style>
  .lc { margin: 0; display: grid; gap: .75rem; padding: 1.5rem; background: var(--surface); border: 1px solid var(--line); }
  .lc__title { font: 700 .75rem/1.2 var(--ui); letter-spacing: .12em; text-transform: uppercase; color: var(--text-soft); }
  .lc svg { width: 100%; height: auto; overflow: visible; }
  .lc__grid line { stroke: var(--line); stroke-width: 1; }
  .lc__grid text, .lc__x { fill: var(--text-soft); font: 500 12px var(--sans); font-variant-numeric: tabular-nums; }
  .lc__line { fill: none; stroke: var(--chart-1); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  .lc__dot { fill: var(--chart-1); stroke: var(--surface); stroke-width: 2; }
  .lc__hit { fill: transparent; }
  .lc__label { fill: var(--text); font: 600 13px var(--sans); font-variant-numeric: tabular-nums; }
  .lc__pt { outline: none; cursor: default; }
  .lc__tip { opacity: 0; pointer-events: none; transition: opacity .12s; }
  .lc__tip rect { fill: var(--espresso-deep); }
  .lc__tip text { fill: #efe8dc; font: 500 12px var(--sans); }
  .lc__tip .lc__tipv { font-weight: 700; font-variant-numeric: tabular-nums; }
  .lc__pt:hover .lc__tip, .lc__pt:focus-visible .lc__tip { opacity: 1; }
  .lc__pt:hover .lc__dot, .lc__pt:focus-visible .lc__dot { r: 7; }
  .lc__caption { font-size: .85rem; color: var(--text-soft); }
  .lc__table summary { cursor: pointer; font-size: .9rem; color: var(--eyebrow); }
  .lc__table table { margin-top: .5rem; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  .lc__table th, .lc__table td { padding: .3rem 1rem .3rem 0; text-align: left; border-bottom: 1px solid var(--line); color: var(--text); }
</style>
