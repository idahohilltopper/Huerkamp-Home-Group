---
// The page-hero photo, sized for each screen (a phone downloads ~25 KB, not 400 KB). It is the largest thing on screen
// when a page opens, so it loads first. Default: the Minneapolis skyline; a city or team photo when the page passes one
// (src/data/hero-photos.ts).
import type { HeroPhoto } from '../data/hero-photos';
interface Props { class?: string; photo?: HeroPhoto }
const { class: cls, photo } = Astro.props;
const name = photo?.name ?? 'minneapolis-skyline';
const widths = photo?.widths ?? [640, 960, 1280, 1920, 2560];
const w = photo?.width ?? 1920, h = photo?.height ?? 1280;
---
<picture>
  <source type="image/webp" srcset={widths.map((x) => `/hero/${name}-${x}.webp ${x}w`).join(', ')} sizes="100vw" />
  <img class={cls} src={`/hero/${name}-1920.jpg`} alt={photo?.alt ?? ''} width={w} height={h} fetchpriority="high" decoding="async" />
</picture>
