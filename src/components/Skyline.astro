---
// Stand-in for the licensed Minneapolis skyline photo (see docs/site-plan.md).
// Simplified silhouette: Capella Tower (ring crown), IDS Center (stepped),
// Wells Fargo Center (gabled crown), plus the surrounding downtown blocks.
---
<svg class="skyline" viewBox="0 0 1440 360" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
  <defs>
    <linearGradient id="sky-fade" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#1a1410" stop-opacity=".55" />
      <stop offset="1" stop-color="#1a1410" stop-opacity="1" />
    </linearGradient>
  </defs>
  <g fill="url(#sky-fade)">
    <rect x="0" y="300" width="1440" height="60" />
    <rect x="40" y="250" width="70" height="110" />
    <rect x="120" y="226" width="54" height="134" />
    <rect x="186" y="262" width="90" height="98" />
    <rect x="290" y="190" width="62" height="170" />
    <rect x="360" y="232" width="80" height="128" />
    <rect x="452" y="170" width="58" height="190" />
    <!-- Capella Tower -->
    <rect x="530" y="92" width="64" height="268" />
    <rect x="540" y="74" width="44" height="18" />
    <circle cx="562" cy="64" r="16" fill="none" stroke="#1a1410" stroke-opacity=".6" stroke-width="5" />
    <!-- IDS Center -->
    <polygon points="610,360 610,70 622,70 622,58 634,58 634,46 670,46 670,58 682,58 682,70 694,70 694,360" />
    <rect x="708" y="150" width="70" height="210" />
    <!-- Wells Fargo Center -->
    <polygon points="792,360 792,92 804,92 804,76 818,64 832,76 832,92 844,92 844,360" />
    <rect x="858" y="184" width="66" height="176" />
    <rect x="936" y="136" width="50" height="224" />
    <rect x="998" y="212" width="84" height="148" />
    <rect x="1094" y="178" width="58" height="182" />
    <rect x="1164" y="240" width="96" height="120" />
    <rect x="1272" y="206" width="60" height="154" />
    <rect x="1344" y="258" width="96" height="102" />
  </g>
</svg>

<style>
  .skyline { position: absolute; inset: auto 0 0 0; width: 100%; height: 62%; }
</style>
