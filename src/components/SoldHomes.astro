---
// "Recently sold" homes in one community (NorthstarMLS sold content), loaded from /api/sold once the visitor has
// agreed to the listing license this visit. Shown only when the site's own MLS feed is on. With the Broker
// Reciprocity disclosures and the required "not an appraisal" sentence (src/lib/sold.mjs).
import { OWN } from '../data/search';
import { BR_THUMB } from '../data/mls-logos';
import { SOLD_DISCLAIMER, DEFAULT_MONTHS } from '../lib/sold.mjs';
import { ownSearchHref } from '../data/search';
import IdxDisclosure from './IdxDisclosure.astro';
interface Props { place?: string; name: string; agent?: string; months?: number }
const { place, name, agent, months } = Astro.props;
const lake = place?.startsWith('lake:');
// Greater Minnesota towns ("mn:<slug>") aren't in the map search, so they get no "see every sale" link.
const all = place && !place.startsWith('mn:') ? `${ownSearchHref({ places: [place] })}${ownSearchHref({ places: [place] }).includes('?') ? '&' : '?'}status=sold&view=map` : null;
// An agent's page: their own sales over 12 months. A community page: everything sold there in the last 6 months.
const query = agent ? `agent=${encodeURIComponent(agent)}&months=12` : `place=${encodeURIComponent(place ?? '')}${months ? `&months=${months}` : ''}`;
---
{OWN && (
  <section class="section section--paper sold" aria-labelledby="sold-title" data-sold={query} data-br-thumb={BR_THUMB ?? undefined} hidden>
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">Recently sold</p>
        {agent
          ? <><h2 id="sold-title">Homes <em>{name}</em> sold</h2><p>{name}'s listings that sold in the last 12 months, from NorthstarMLS.</p></>
          : lake
            ? <><h2 id="sold-title">What did homes on {name} <em>sell for?</em></h2><p>Lakefront homes sold on {name} in the last {months ?? DEFAULT_MONTHS} months, from NorthstarMLS: homes the MLS marks as lakefront, inside 200 meters of the DNR shoreline.</p></>
            : <><h2 id="sold-title">What did homes in {name} <em>sell for?</em></h2><p>Homes sold in {name} in the last {months ?? DEFAULT_MONTHS} months, from NorthstarMLS.</p></>}
      </div>
      <div data-idx><ul class="lcards" data-sold-list></ul></div>
      {all && <p class="sold__more"><a class="link-arrow" href={all}>See every {name} sale on the map</a></p>}
      <p class="sold__note">{SOLD_DISCLAIMER}</p>
      <IdxDisclosure />
    </div>
  </section>
)}

<script>
  import { soldCardHtml, soldHeaders, signInNote, type Sold } from '../scripts/sold-card';
  for (const box of document.querySelectorAll<HTMLElement>('[data-sold]')) {
    const load = async () => {
      try {
        const r = await fetch(`/api/sold?${box.dataset.sold}`, { headers: soldHeaders() });
        const a = await r.json();
        if (!a.ok || (!a.results?.length && !a.signInFor)) return; // nothing to show: the section stays hidden
        const listEl = box.querySelector('[data-sold-list]')!;
        listEl.innerHTML = (a.results as Sold[]).slice(0, 6).map((l) => soldCardHtml(l, box.dataset.brThumb)).join('');
        listEl.insertAdjacentHTML('afterend', signInNote(a.signInFor ?? 0));
        box.hidden = false;
      } catch { /* the section stays hidden */ }
    };
    if (document.documentElement.classList.contains('idx-ok')) load();
    else window.addEventListener('idx-agreed', load, { once: true });
  }
</script>

<style>
  .sold__more { margin-top: 1.25rem; }
  .sold__note { margin-top: 1rem; font-size: 1rem; color: var(--text-soft); }
</style>
