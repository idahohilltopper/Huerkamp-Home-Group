---
// Live MLS listings. Until the MLS feed is on: the team's Ylopo search (Ylopo's official results widget, same as
// Mark Z's site), whose script loads only when listings scroll near the screen. Once it's on (src/data/search.ts,
// OWN): the same homes from the site's own feed, rendered into the page at build time, with no Ylopo code at all.
// `search` uses Ylopo's search fields: locations, propertyTypes, minPrice, maxPrice, featured ("t" = the team's own
// listings), amenities, limit; `own` overrides how it's read for the site's own search.
import { site } from '../data/site';
import { OWN, ownFromWidget, ownSearchHref, type OwnQuery } from '../data/search';
import ListingCard from './ListingCard.astro';
import IdxDisclosure from './IdxDisclosure.astro';
interface Props {
  search: Record<string, unknown>;
  own?: OwnQuery;
  layout?: 'grid' | 'scroll';
  /** Link to the full results; shown under the cards and if the widget can't load. */
  moreHref: string;
  moreLabel: string;
  /** Set false when the page already has its own "see all" button. */
  showMore?: boolean;
}
const { search, own, layout = 'grid', moreHref, moreLabel, showMore = true } = Astro.props;
const domain = new URL(site.searchUrl).host;
const data = JSON.stringify({ propertyTypes: ['house', 'condo', 'townhouse'], sortBy: 'listDate', sortOrder: 'desc', limit: 12, ...search });
// The site's own listings (only loaded when the feed is on, so a build without it never touches the feed).
const q = OWN ? { ...ownFromWidget(search), ...own } : null;
const own$ = q ? await import('../data/own-listings') : null;
const homes = own$ && q ? own$.ownListings(q, (q as { limit?: number }).limit ?? 12) : [];
const feedAt = own$?.feedAt ?? null;
const ownMore = q ? ownSearchHref({ ...q, limit: undefined } as OwnQuery) : moreHref;
---
{OWN ? (
  <>
    {homes.length
      ? <div data-idx><ul class:list={['lcards', 'lcards--own', layout === 'scroll' && 'lcards--scroll']}>{homes.map((l) => <ListingCard l={l} />)}</ul></div>
      : <p class="olist__none">No homes match this search right now. New listings are added several times a day.</p>}
    {showMore && <p class="ylopo__more"><a class="link-arrow" href={ownMore}>{moreLabel}</a></p>}
    {homes.length > 0 && <IdxDisclosure at={feedAt} />}
  </>
) : (
<>
<div class:list={['ylopo', `ylopo--${layout}`]} data-ylopo={domain}>
  <div class="YLOPO_resultsWidget" data-search={data}></div>
  <p class="ylopo__loading" aria-hidden="true">Loading listings…</p>
</div>
{showMore && <p class="ylopo__more"><a class="link-arrow" href={moreHref} rel="noopener">{moreLabel}</a></p>}
</>
)}

<script>
  // (Does nothing on pages without a Ylopo box, e.g. once the site's own listings replace the widget.)
  // One loader for every widget on the page: add Ylopo's script the first time listings come near view.
  const boxes = document.querySelectorAll<HTMLElement>('[data-ylopo]');
  let loaded = false;
  const load = () => {
    if (loaded || !boxes.length) return;
    loaded = true;
    (window as any).YLOPO_WIDGETS = { domain: boxes[0].dataset.ylopo };
    const s = document.createElement('script');
    s.src = `https://${boxes[0].dataset.ylopo}/build/js/widgets-1.0.0.js`;
    s.async = true;
    document.head.append(s);
    // Hide the loading note once cards appear (or after a while if the widget can't load).
    const done = () => boxes.forEach((b) => b.classList.add('is-ready'));
    const mo = new MutationObserver(() => { if (document.querySelector('.YLOPO-widget')) { done(); mo.disconnect(); } });
    mo.observe(document.body, { childList: true, subtree: true });
    setTimeout(done, 15000);
  };
  const io = new IntersectionObserver((entries) => {
    if (entries.some((e) => e.isIntersecting)) { load(); io.disconnect(); }
  }, { rootMargin: '800px 0px' });
  boxes.forEach((b) => io.observe(b));
</script>

<style is:global>
  /* The site's own listings (feed on) */
  .lcards--scroll { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: .75rem; }
  .lcards--scroll > li { flex: 0 0 min(85%, 19rem); scroll-snap-align: start; }
  @media (max-width: 700px) { .lcards--own { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: .75rem; } .lcards--own > li { flex: 0 0 85%; scroll-snap-align: start; } }
  .olist__none { padding: 2rem 0; color: var(--text-soft); }
  /* Ylopo widget, restyled to match the site */
  .ylopo { position: relative; min-height: 22rem; }
  .ylopo.is-ready { min-height: 0; }
  .ylopo__loading { position: absolute; inset: 0; display: grid; place-items: center; color: var(--text-soft); font: 600 .9rem/1 var(--ui); letter-spacing: .1em; text-transform: uppercase; }
  .ylopo.is-ready .ylopo__loading { display: none; }
  .ylopo__more { margin-top: 1.75rem; text-align: center; }
  .ylopo .YLOPO-widget, .ylopo .YLOPO-widget *:not(.fa) { font-family: var(--sans) !important; }
  .ylopo .widget-gallery-container { display: grid !important; grid-template-columns: repeat(auto-fill, minmax(min(100%, 17.5rem), 1fr)); gap: 1.5rem; float: none !important; width: 100% !important; }
  .ylopo .widget-gallery-container::before, .ylopo .widget-gallery-container::after { display: none !important; }
  .ylopo .grid-view-item { width: auto !important; max-width: none !important; margin: 0 !important; padding: 0 !important; float: none !important; }
  .ylopo .gallery-card-b { margin: 0 !important; border: 1px solid var(--line) !important; background: var(--paper); box-shadow: none !important; }
  .ylopo .gallery-card-b-address-block .layout > div:first-child { font: 600 1.05rem/1.3 var(--sans) !important; color: var(--text); }
  .ylopo .listing-status-flag { background: rgba(21, 18, 19, .82) !important; color: #fff !important; font: 700 .72rem/1 var(--ui) !important; letter-spacing: .1em; text-transform: uppercase; padding: .45rem .7rem !important; top: .75rem !important; left: .75rem !important; }
  .ylopo .gallery-card-b-generate-sort-block { color: var(--text) !important; }
  .ylopo .idx-compliance { font-size: .72rem !important; color: var(--text-soft) !important; }
  /* Featured listings scroll sideways, like Mark Z's "Properties we're proud to represent" */
  .ylopo--scroll .widget-gallery-container { display: flex !important; flex-wrap: nowrap !important; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: .75rem; }
  .ylopo--scroll .grid-view-item { flex: 0 0 min(85%, 19rem); scroll-snap-align: start; }
  /* On phones every listing row swipes sideways instead of stacking twelve cards */
  @media (max-width: 700px) {
    .ylopo .widget-gallery-container { display: flex !important; flex-wrap: nowrap !important; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: .75rem; }
    .ylopo .grid-view-item { flex: 0 0 85% !important; scroll-snap-align: start; }
  }
</style>
