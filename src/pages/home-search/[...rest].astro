---
// /home-search: the site's own home search, on the MLS feed (Repliers / NorthstarMLS). Built only once the feed is on
// (src/data/search.ts, OWN); until then every search link still goes to Ylopo. Filters live in the address
// (?place=burnsville&max=400000&beds=3 ...), so every link on the site can open a ready-made search. The first page of
// newest homes is in the HTML; everything after that comes from /api/search (netlify/functions/search.mjs).
// Kept out of search engines: the homes-for-sale pages are the ones built to rank.
import Base from '../../layouts/Base.astro';
import ListingCard from '../../components/ListingCard.astro';
import { OWN, SEARCH_PATH } from '../../data/search';
import { site } from '../../data/site';
import { BR_THUMB } from '../../data/mls-logos';
import IdxDisclosure from '../../components/IdxDisclosure.astro';
import { SOLD_DISCLAIMER, DEFAULT_MONTHS } from '../../lib/sold.mjs';
import { communities } from '../../data/areas';
import { hoods, hoodKey, CITY_NAME } from '../../data/neighborhoods';
import { lakes } from '../../data/lakes';
import { TYPE_LABEL, homesHref, type Listing } from '../../data/listings';
import { SORTS, TYPES, PAGE_SIZE } from '../../lib/search-index.mjs';

export function getStaticPaths() {
  return OWN ? [{ params: { rest: undefined } }] : [];
}

const { ownIndex, ownListings, ownCount, feedAt } = await import('../../data/own-listings');
const first = ownListings({}, PAGE_SIZE) as Listing[];
const total = ownIndex.rows.length;
const count = (place: string) => ownCount({ places: [place] });
const groups = [
  { label: 'Cities', items: communities.map((c) => ({ v: c.slug, label: c.name, n: count(c.slug) })) },
  { label: 'Minneapolis neighborhoods', items: hoods.filter((h) => h.city === 'minneapolis').map((h) => ({ v: `hood:${hoodKey(h)}`, label: h.name, n: count(`hood:${hoodKey(h)}`) })) },
  { label: 'Saint Paul neighborhoods', items: hoods.filter((h) => h.city === 'saint-paul').map((h) => ({ v: `hood:${hoodKey(h)}`, label: h.name, n: count(`hood:${hoodKey(h)}`) })) },
  { label: 'Lakes (lakefront homes)', items: lakes.map((l) => ({ v: `lake:${l.slug}`, label: l.name, n: count(`lake:${l.slug}`) })) },
].map((g) => ({ ...g, items: g.items.filter((i) => i.n > 0).sort((a, b) => a.label.localeCompare(b.label)) })).filter((g) => g.items.length);
const prices = [100000, 150000, 200000, 250000, 300000, 350000, 400000, 450000, 500000, 600000, 700000, 800000, 900000, 1000000, 1250000, 1500000, 2000000, 3000000, 5000000];
const money = (n: number) => (n >= 1e6 ? `$${(n / 1e6).toString().replace(/\.0+$/, '')}M` : `$${n / 1000}K`);
const key = import.meta.env.PUBLIC_MAPTILER_KEY ?? '';
// A colorful street map (parks, water, roads and town names), like the portals' maps.
const mapStyle = key ? `https://api.maptiler.com/maps/streets-v2/style.json?key=${key}` : 'https://tiles.openfreemap.org/styles/liberty';
const typeName = (t: string) => TYPE_LABEL[t]?.replace(/^./, (c) => c.toUpperCase()) ?? t;
const names = Object.fromEntries(groups.flatMap((g) => g.items.map((i) => [i.v, i.label])));
---
<Base breadcrumbs={[{ name: 'Home search', href: SEARCH_PATH }]} noindex
  title={`Search Homes for Sale in the Twin Cities | ${site.name}`}
  description="Search every home for sale in the Twin Cities communities we serve, by city, neighborhood, lake, price, bedrooms and home type, on a map. Listings from NorthstarMLS.">
  <section class="hs" data-hs data-br-thumb={BR_THUMB ?? undefined} data-map-style={mapStyle} data-types={JSON.stringify(TYPE_LABEL)} data-names={JSON.stringify(names)} data-default-months={DEFAULT_MONTHS}>
    <form class="hs-bar" id="hs-form" data-search action={SEARCH_PATH} method="get" role="search">
      <div class="hs-mode" role="group" aria-label="Show homes">
        <button type="button" data-mode="" aria-pressed="true">For sale</button>
        <button type="button" data-mode="sold" aria-pressed="false">Sold</button>
      </div>
      <input type="hidden" name="status" value="" />
      <div class="hs-where">
        <label class="visually-hidden" for="hs-where">City, neighborhood, lake or ZIP</label>
        <input id="hs-where" type="search" list="hs-places" placeholder="City, neighborhood, lake or ZIP" autocomplete="off" data-where />
        <datalist id="hs-places">{groups.flatMap((g) => g.items).map((i) => <option value={i.label} />)}</datalist>
        <input type="hidden" name="place" value="" />
        <button type="submit" aria-label="Search"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.4" /><path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" /></svg></button>
      </div>
      <details class="hs-pill" data-pill="price">
        <summary data-pill-label="Price">Price</summary>
        <div class="hs-pop">
          <div class="hs-f"><label for="hs-min">Minimum</label><select id="hs-min" name="min"><option value="">No min</option>{prices.map((p) => <option value={p}>{money(p)}</option>)}</select></div>
          <div class="hs-f"><label for="hs-max">Maximum</label><select id="hs-max" name="max"><option value="">No max</option>{prices.map((p) => <option value={p}>{money(p)}</option>)}</select></div>
        </div>
      </details>
      <details class="hs-pill" data-pill="months" data-sold-only hidden>
        <summary data-pill-label="Sold in the last">Sold in the last</summary>
        <div class="hs-pop">
          <div class="hs-f"><label for="hs-months">Sold within</label><select id="hs-months" name="months">{[3, 6, 12, 24].map((m) => <option value={m === DEFAULT_MONTHS ? '' : m} selected={m === DEFAULT_MONTHS}>{m < 12 ? `${m} months` : `${m / 12} year${m > 12 ? 's' : ''}`}</option>)}</select></div>
        </div>
      </details>
      <details class="hs-pill" data-pill="rooms">
        <summary data-pill-label="Beds & baths">Beds &amp; baths</summary>
        <div class="hs-pop">
          <div class="hs-f"><label for="hs-beds">Bedrooms</label><select id="hs-beds" name="beds"><option value="">Any</option>{[1, 2, 3, 4, 5].map((n) => <option value={n}>{n}+</option>)}</select></div>
          <div class="hs-f"><label for="hs-baths">Bathrooms</label><select id="hs-baths" name="baths"><option value="">Any</option>{[1, 2, 3, 4].map((n) => <option value={n}>{n}+</option>)}</select></div>
        </div>
      </details>
      <details class="hs-pill" data-pill="type" data-sale-only>
        <summary data-pill-label="Home type">Home type</summary>
        <div class="hs-pop">
          <div class="hs-f"><label for="hs-type">Home type</label><select id="hs-type" name="type"><option value="">All types</option>{TYPES.map((t) => <option value={t}>{typeName(t)}</option>)}</select></div>
        </div>
      </details>
      <details class="hs-pill" data-pill="more" data-sale-only>
        <summary data-pill-label="More">More</summary>
        <fieldset class="hs-pop hs-checks"><legend class="visually-hidden">More filters</legend>
          <label><input type="checkbox" name="lakefront" value="1" /> Lakefront</label>
          <label><input type="checkbox" name="new" value="1" /> New construction</label>
          <label><input type="checkbox" name="acres" value="1" /> 1+ acre</label>
          <label><input type="checkbox" name="open" value="1" /> Open houses</label>
          <label><input type="checkbox" name="team" value="1" /> Our team’s listings</label>
        </fieldset>
      </details>
      <a class="btn hs-save" href="#alerts">Save search</a>
      <input type="hidden" name="bbox" value="" />
      <input type="hidden" name="page" value="" />
      <noscript><button class="btn" type="submit">Search</button></noscript>
    </form>

    <div class="hs-split" data-idx>
      <div class="hs-map" data-mapbox>
        <div class="hs-map__canvas" data-map></div>
        <p class="hs-map__count" data-mapcount hidden></p>
        <label class="hs-map__follow"><input type="checkbox" data-follow checked /> Search as I move the map</label>
        <button class="hs-map__clear" type="button" data-clear-area hidden>Clear map area</button>
      </div>
      <div class="hs-panel">
        <div class="hs-head">
          <div>
            <h1 data-h1>Twin Cities homes for sale</h1>
            <p class="hs-count" aria-live="polite" data-count>{total.toLocaleString('en-US')} homes for sale</p>
          </div>
          <div class="hs-sort" data-sale-only><label for="hs-sort">Sort</label><select id="hs-sort" name="sort" form="hs-form">{Object.entries(SORTS).map(([v, l]) => <option value={v}>{l}</option>)}</select></div>
        </div>
        <ul class="lcards" data-results>{first.map((l, i) => <ListingCard l={l} eager={i < 4} />)}</ul>
        <p class="hs-empty" data-empty hidden>No homes match these filters. Try a wider price range, move the map, or <a href="#alerts">ask us to watch for one</a>.</p>
        <p class="hs-error" data-error hidden>Search is temporarily unavailable. Browse <a href={homesHref()}>homes for sale by city</a> or call <a href={site.phoneHref}>{site.phone}</a>.</p>
        <nav class="hs-pages" aria-label="Results pages" data-pages>
          <button type="button" data-prev disabled>← Previous</button>
          <span data-pageinfo>Page 1 of {Math.max(1, Math.ceil(total / PAGE_SIZE))}</span>
          <button type="button" data-next disabled={total <= PAGE_SIZE}>Next →</button>
        </nav>
        <p class="hs-sold-note" data-sold-only hidden>{SOLD_DISCLAIMER} Sold homes are shown for the last 2 years at most, without homes whose sellers asked not to be advertised.</p>
        <IdxDisclosure at={feedAt} />
      </div>
    </div>
    <button class="hs-toggle" type="button" data-toggle aria-pressed="false">Map</button>
  </section>

  <section class="section section--dark" id="alerts" aria-labelledby="alerts-title">
    <div class="wrap hs-alert">
      <div class="prose">
        <p class="eyebrow">Never miss a listing</p>
        <h2 id="alerts-title">Get new homes <em>like these.</em></h2>
        <p>We’ll save this search and let you know when a new home matches, often before the weekend rush. A {site.name} agent can also set up showings and answer questions about any home.</p>
        <p class="hs-alert__search" data-alert-summary>Your search: all homes for sale</p>
      </div>
      <form class="form" data-lead="community-alert">
        <input type="hidden" name="savedSearch" value="" data-saved-search />
        <div class="form__row">
          <div class="field"><label for="al-first">First name</label><input id="al-first" name="firstName" autocomplete="given-name" required /></div>
          <div class="field"><label for="al-last">Last name</label><input id="al-last" name="lastName" autocomplete="family-name" required /></div>
        </div>
        <div class="form__row">
          <div class="field"><label for="al-email">Email</label><input id="al-email" name="email" type="email" autocomplete="email" required /></div>
          <div class="field"><label for="al-phone">Phone</label><input id="al-phone" name="phone" type="tel" autocomplete="tel" /></div>
        </div>
        <div class="field"><label for="al-freq">Email me new homes</label><select id="al-freq" name="alertFrequency"><option value="instant">As soon as they’re listed</option><option value="daily" selected>Once a day</option><option value="weekly">Once a week</option></select></div>
        <div class="field"><label for="al-msg">Anything else? (optional)</label><textarea id="al-msg" name="message" rows="2"></textarea></div>
        <button class="btn" type="submit">Send me new listings</button>
        <p class="form__status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</Base>

<script>
  import { initSearch } from '../../scripts/home-search';
  const root = document.querySelector<HTMLElement>('[data-hs]');
  if (root) initSearch(root);
</script>

<style>
  /* Zillow-style layout: filter bar on top, map on the left, list on the right. Phones: the list, with a Map button. */
  .hs { --hs-nav: 4.6rem; }
  .hs-bar { position: relative; z-index: 6; display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; padding: .7rem clamp(.75rem, 2vw, 1.25rem); border-bottom: 1px solid var(--line); background: #fff; }
  .hs-mode { display: inline-flex; border: 1px solid #a7a1a2; border-radius: 6px; overflow: hidden; }
  .hs-mode button { padding: .62rem .9rem; border: 0; background: #fff; font: 600 .92rem/1.2 var(--ui); color: var(--text); cursor: pointer; }
  .hs-mode button[aria-pressed='true'] { background: var(--crimson); color: #fff; }
  [data-sold-only][hidden], [data-sale-only][hidden] { display: none !important; }
  .hs-panel :global(.hs-editbar) { display: grid; gap: .6rem; justify-items: start; margin-bottom: 1rem; padding: 1rem 1.1rem; border: 2px solid var(--crimson); border-radius: 8px; background: #fff6f6; }
  .hs-panel :global(.hs-editbar p) { margin: 0; }
  :global(.hs-home) { position: fixed; inset: 0; z-index: 60; display: grid; grid-template-rows: auto 1fr; width: min(72rem, 100vw); margin-inline: auto; background: #fff; box-shadow: 0 0 0 100vmax rgba(21, 18, 19, .45), 0 20px 60px rgba(0, 0, 0, .35); }
  :global(.hs-home[hidden]) { display: none; }
  :global(.hs-home__bar) { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: .5rem; padding: .55rem 1rem; border-bottom: 1px solid var(--line); }
  :global(.hs-home__logo img) { display: block; height: 32px; width: auto; }
  :global(.hs-home__acts) { display: flex; justify-content: flex-end; align-items: center; gap: .25rem; }
  :global(.hs-home__act) { display: inline-flex; align-items: center; gap: .3rem; padding: .45rem .6rem; border: 0; border-radius: 6px; background: none; color: var(--text); font: 600 .9rem/1 var(--ui); text-decoration: none; cursor: pointer; }
  :global(.hs-home__act:hover) { background: var(--sand); color: var(--crimson); }
  :global(.hs-home__act[hidden]) { display: none; }
  :global(.hs-home__act[aria-pressed='true'] [data-save-icon]) { color: var(--crimson); }
  @media (max-width: 600px) {
    :global(.hs-home__bar) { padding: .45rem .5rem; }
    :global(.hs-home__full), :global(.hs-home__act [data-save-text]), :global(.hs-home__act [data-share-text]) { display: none; }
    :global(.hs-home__act) { font-size: 1.2rem; padding: .45rem; }
  }
  :global(.hs-home__back) { justify-self: start; border: 0; background: none; font: 700 1rem/1 var(--ui); color: var(--text); cursor: pointer; padding: .4rem .2rem; }
  :global(.hs-home__back:hover) { color: var(--crimson); }
  :global(.hs-home__frame) { width: 100%; height: 100%; border: 0; }
  :global(html.hs-home-open) { overflow: hidden; }
  .hs-sold-note { margin-top: 1.25rem; font-size: 1rem; color: var(--text-soft); }
  .hs-panel :global(.lcard__box) { border-radius: 8px; overflow: hidden; background: #fff; box-shadow: 0 2px 8px rgba(0, 0, 0, .08); }
  .hs-where { position: relative; flex: 1 1 18rem; max-width: 30rem; display: flex; }
  .hs-where input { width: 100%; padding: .7rem 2.8rem .7rem .9rem; border: 1px solid #a7a1a2; border-radius: 6px; font: 500 1rem/1.2 var(--ui); color: var(--text); background: #fff; }
  .hs-where input:focus { outline: 2px solid var(--crimson); outline-offset: 0; border-color: transparent; }
  .hs-where button { position: absolute; right: .3rem; top: 50%; transform: translateY(-50%); display: grid; place-items: center; width: 2.3rem; height: 2.3rem; border: 0; background: none; color: var(--text); cursor: pointer; }
  .hs-pill { position: relative; }
  .hs-pill summary { list-style: none; display: inline-flex; gap: .45rem; align-items: center; padding: .62rem .95rem; border: 1px solid #a7a1a2; border-radius: 6px; background: #fff; font: 600 .92rem/1.2 var(--ui); color: var(--text); cursor: pointer; white-space: nowrap; user-select: none; }
  .hs-pill summary::-webkit-details-marker { display: none; }
  .hs-pill summary::after { content: ''; width: .45rem; height: .45rem; border: solid currentColor; border-width: 0 2px 2px 0; transform: translateY(-2px) rotate(45deg); }
  .hs-pill[open] summary::after { transform: translateY(1px) rotate(-135deg); }
  .hs-pill.is-set summary { border-color: var(--crimson); color: var(--crimson); background: #fff6f6; }
  .hs-pop { position: absolute; top: calc(100% + .4rem); left: 0; z-index: 10; display: grid; grid-template-columns: repeat(2, minmax(9rem, 1fr)); gap: .8rem; min-width: 19rem; margin: 0; padding: 1rem; border: 1px solid var(--line); border-radius: 8px; background: #fff; box-shadow: 0 12px 30px rgba(0, 0, 0, .16); }
  .hs-pill[data-pill='type'] .hs-pop { grid-template-columns: 1fr; min-width: 15rem; }
  .hs-f { display: grid; gap: .3rem; min-width: 0; }
  .hs-f label, .hs-sort label { font: 700 .7rem/1 var(--ui); letter-spacing: .08em; text-transform: uppercase; color: var(--text-soft); }
  .hs-f select, .hs-sort select { width: 100%; padding: .55rem .5rem; border: 1px solid var(--line); border-radius: 4px; background: #fff; font: 500 .95rem/1.2 var(--ui); color: var(--text); }
  .hs-checks { grid-template-columns: 1fr; min-width: 14rem; font: 500 .95rem/1.2 var(--ui); }
  .hs-checks label { display: flex; gap: .55rem; align-items: center; cursor: pointer; }
  .hs-checks input { width: 1.1rem; height: 1.1rem; accent-color: var(--crimson); }
  .hs-save { padding: .65rem 1.1rem; border-radius: 6px; font-size: .92rem; }
  @media (max-width: 1100px) { .hs-save { margin-left: auto; } }

  .hs-split { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(30rem, 1fr); align-items: start; }
  .hs-map { position: sticky; top: var(--hs-nav); height: calc(100vh - var(--hs-nav)); min-height: 420px; background: #e9eef0; }
  .hs-map__canvas { position: absolute; inset: 0; }
  .hs-map__count { position: absolute; top: .9rem; left: .9rem; z-index: 2; margin: 0; padding: .45rem .8rem; border-radius: 999px; background: rgba(21, 18, 19, .82); color: #fff; font: 600 .85rem/1.2 var(--ui); pointer-events: none; }
  .hs-map__follow { position: absolute; left: 50%; bottom: 1.1rem; z-index: 2; transform: translateX(-50%); display: inline-flex; gap: .45rem; align-items: center; padding: .5rem .85rem; border-radius: 999px; background: #fff; box-shadow: 0 4px 14px rgba(0, 0, 0, .18); font: 600 .85rem/1 var(--ui); cursor: pointer; white-space: nowrap; }
  .hs-map__follow input { accent-color: var(--crimson); }
  .hs-map__clear { position: absolute; top: .9rem; right: 3.4rem; z-index: 2; padding: .45rem .8rem; border: 1px solid var(--crimson); border-radius: 999px; background: #fff; color: var(--crimson); font: 600 .82rem/1 var(--ui); cursor: pointer; }
  .hs-panel { min-width: 0; padding: 1.1rem clamp(.9rem, 1.6vw, 1.4rem) 2.5rem; border-left: 1px solid var(--line); background: #fff; }
  .hs-head { display: flex; flex-wrap: wrap; gap: .75rem 1rem; justify-content: space-between; align-items: end; margin-bottom: 1rem; }
  .hs-head h1 { margin: 0 0 .25rem; font: 600 clamp(1.35rem, 2vw, 1.6rem)/1.15 var(--ui); letter-spacing: -.01em; }
  .hs-count { margin: 0; font: 600 .95rem/1.2 var(--ui); color: var(--text-soft); }
  .hs-sort { display: grid; gap: .25rem; min-width: 11rem; }
  .hs-panel .lcards { grid-template-columns: repeat(auto-fill, minmax(min(100%, 14.5rem), 1fr)); gap: 1rem; }
  .hs-panel .lcard a { border-radius: 8px; overflow: hidden; background: #fff; box-shadow: 0 2px 8px rgba(0, 0, 0, .08); transition: box-shadow .15s; }
  .hs-panel .lcard a:hover, .hs-panel .lcard.is-hot a { box-shadow: 0 6px 18px rgba(0, 0, 0, .18); }
  .hs-toggle { display: none; }
  @media (max-width: 900px) {
    .hs-split { display: block; }
    .hs-map { display: none; height: 72vh; top: 0; position: relative; }
    .hs.is-map .hs-map { display: block; }
    .hs.is-map .hs-panel { display: none; }
    .hs-panel { border-left: 0; }
    .hs-toggle { position: fixed; left: 50%; bottom: 1.2rem; z-index: 15; transform: translateX(-50%); display: inline-flex; padding: .75rem 1.4rem; border: 0; border-radius: 999px; background: var(--ink, #151213); color: #fff; font: 700 .95rem/1 var(--ui); box-shadow: 0 6px 18px rgba(0, 0, 0, .3); cursor: pointer; }
    .hs-map__follow { top: 3.4rem; bottom: auto; left: .9rem; transform: none; }
    .hs-pop { position: fixed; top: auto; left: .75rem; right: .75rem; bottom: .75rem; min-width: 0; }
  }
  .hs-empty, .hs-error { padding: 2rem 0; font-size: 1.05rem; }
  .hs-pages { display: flex; gap: 1rem; align-items: center; justify-content: center; margin: 2rem 0 1rem; font: 600 .95rem/1 var(--ui); }
  .hs-pages button { padding: .6rem 1rem; border: 1px solid var(--line); border-radius: 6px; background: #fff; font: inherit; cursor: pointer; color: var(--text); }
  .hs-pages button:disabled { opacity: .4; cursor: default; }
  .hs-alert { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  @media (max-width: 900px) { .hs-alert { grid-template-columns: 1fr; } }
  .hs-alert__search { font-weight: 600; }
  .lcards.is-loading { opacity: .45; transition: opacity .15s; }
  :global(.hs-hover) { pointer-events: none; }
  :global(.hs-hover .maplibregl-popup-content) { padding: .3rem .55rem; border-radius: 6px; background: var(--crimson); color: #fff; font: 700 .85rem/1 var(--ui); box-shadow: 0 3px 10px rgba(0, 0, 0, .25); }
  :global(.hs-hover .maplibregl-popup-tip) { display: none; }
  :global(.hs-popup .maplibregl-popup-content) { padding: 0; border-radius: 8px; overflow: hidden; box-shadow: 0 8px 24px rgba(0, 0, 0, .22); }
  :global(.hs-mappop) { position: relative; }
  :global(.hs-mappop__fav) { position: absolute; top: .45rem; right: .45rem; z-index: 2; }
  :global(.hs-pop-card) { display: grid; gap: .2rem; width: 240px; padding-bottom: .7rem; font: 500 .85rem/1.3 var(--ui); color: var(--text); text-decoration: none; }
  :global(.hs-pop-card > :not(.hs-pop-card__photo)) { padding-inline: .75rem; }
  :global(.hs-pop-card__photo) { display: grid; place-items: center; aspect-ratio: 3 / 2; margin-bottom: .35rem; background: var(--sand); color: var(--text-soft); font: 600 .75rem/1 var(--ui); overflow: hidden; }
  :global(.hs-pop-card__photo img) { width: 100%; height: 100%; object-fit: cover; }
  :global(.hs-pop-card strong) { font: 700 1.1rem/1.2 var(--ui); }
  :global(.hs-pop-card small) { display: flex; gap: .35rem; align-items: center; color: var(--text-soft); font-size: .75rem; }
  :global(.hs-pop-card:hover strong) { color: var(--crimson); }
</style>
