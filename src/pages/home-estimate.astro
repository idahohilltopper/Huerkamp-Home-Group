---
// "What's my home worth?" Instant estimate: the visitor describes their home and leaves their contact details (a
// "Home value request" lead in Follow Up Boss, like /sell#value), then sees a price range from recent sales nearby
// (netlify/functions/estimate.mjs, src/lib/estimate.mjs). It's an ESTIMATE, never an appraisal, CMA or home
// valuation; the sales shown follow the NorthstarMLS sold rules (src/lib/sold.mjs) and appear only after I AGREE.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import IdxDisclosure from '../components/IdxDisclosure.astro';
import { site } from '../data/site';
import { BR_THUMB } from '../data/mls-logos';
import { SOLD_DISCLAIMER } from '../lib/sold.mjs';
---
<Base title={`What's my home worth? Instant home value estimate | ${site.name}`} description="Get an instant price range for your Twin Cities home from recent sales nearby, then a free, accurate value from a local agent." breadcrumbs={[{ name: 'Sell', href: '/sell' }, { name: 'Instant home value estimate', href: '/home-estimate' }]}>
  <PageHero eyebrow="Sell" title="What's my home worth?" lede="Get an instant price range from homes like yours that sold nearby. Then one of our agents can fine-tune it for your home's updates and condition, free." />
  <section class="section">
    <div class="wrap est">
      <form class="form est__form" data-lead="home-value" data-estimate-form>
        <h2>Tell us about your home</h2>
        <div class="field"><label for="es-address">Street address</label><input id="es-address" name="address" autocomplete="street-address" required /></div>
        <div class="form__row">
          <div class="field"><label for="es-zip">ZIP code</label><input id="es-zip" name="zip" inputmode="numeric" pattern="[0-9]{5}" maxlength="5" autocomplete="postal-code" required title="Your 5-digit ZIP code" /></div>
          <div class="field"><label for="es-type">Kind of home</label><select id="es-type" name="homeType"><option value="single-family">House</option><option value="townhome">Townhome</option><option value="condo">Condo</option></select></div>
        </div>
        <div class="form__row est__three">
          <div class="field"><label for="es-beds">Bedrooms</label><select id="es-beds" name="beds">{[1, 2, 3, 4, 5, 6].map((n) => <option selected={n === 3}>{n === 6 ? '6+' : n}</option>)}</select></div>
          <div class="field"><label for="es-baths">Bathrooms</label><select id="es-baths" name="baths">{[1, 1.5, 2, 2.5, 3, 3.5, 4].map((n) => <option selected={n === 2}>{n === 4 ? '4+' : n}</option>)}</select></div>
          <div class="field"><label for="es-sqft">Finished sq ft (optional)</label><input id="es-sqft" name="sqft" inputmode="numeric" placeholder="e.g. 1,850" /></div>
        </div>
        <h3>Where should we send it?</h3>
        <div class="form__row">
          <div class="field"><label for="es-first">First name</label><input id="es-first" name="firstName" autocomplete="given-name" required /></div>
          <div class="field"><label for="es-last">Last name</label><input id="es-last" name="lastName" autocomplete="family-name" required /></div>
        </div>
        <div class="form__row">
          <div class="field"><label for="es-email">Email</label><input id="es-email" name="email" type="email" autocomplete="email" required /></div>
          <div class="field"><label for="es-phone">Phone</label><input id="es-phone" name="phone" type="tel" autocomplete="tel" required pattern="[^0-9]*([0-9][^0-9]*){10,}" title="Please enter your phone number, including area code." /></div>
        </div>
        <div class="field">
          <label for="es-timeline">When might you sell?</label>
          <select id="es-timeline" name="timeline"><option value="">Choose one</option><option>Within 3 months</option><option>3 to 6 months</option><option>6 to 12 months</option><option>Just curious</option></select>
        </div>
        <button class="btn" type="submit">See my home's estimate</button>
        <p class="form__status" role="status" aria-live="polite"></p>
      </form>

      <div class="est__result" data-est-result data-br-thumb={BR_THUMB ?? undefined} hidden>
        <div data-idx>
          <div data-est-out><p>Working out your estimate…</p></div>
        </div>
        <p class="est__note">{SOLD_DISCLAIMER} This is an automated estimate from recent sales nearby. It can't see your home's condition, updates or lot, so the real value can be higher or lower. For a value you can plan around, one of our agents will compare your home with the right sales and walk through it with you, free and with no obligation.</p>
        <p><a class="btn" href={site.phoneHref}>Call or text {site.phone}</a> <a class="btn btn--ghost" href="/calculators/seller-net-proceeds">What would I walk away with?</a></p>
        <IdxDisclosure />
      </div>
    </div>
  </section>
</Base>

<script>
  // After the lead is sent (src/layouts/Base.astro fires 'lead-sent'), ask for the estimate and show it.
  const form = document.querySelector<HTMLFormElement>('[data-estimate-form]')!;
  // Arrived from the home page spotlight (/home-estimate?address=&zip=): fill those in and start at the next box.
  const q = new URLSearchParams(location.search);
  for (const [id, key] of [['es-address', 'address'], ['es-zip', 'zip']] as const) {
    const v = (q.get(key) ?? '').slice(0, 120);
    const input = document.getElementById(id) as HTMLInputElement | null;
    if (v && input && !input.value) input.value = key === 'zip' ? v.replace(/\D/g, '').slice(0, 5) : v;
  }
  if (q.get('address')) (document.getElementById('es-type') as HTMLElement | null)?.focus({ preventScroll: false });
  const box = document.querySelector<HTMLElement>('[data-est-result]')!;
  const out = box.querySelector<HTMLElement>('[data-est-out]')!;
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  const money = (n: number) => `$${Math.round(n).toLocaleString('en-US')}`;
  const soldOn = (d: string) => new Date(`${d}T12:00:00`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  const comp = (c: any) => {
    const addr = c.addressHidden || !c.street ? `${c.city}, MN ${c.zip}` : `${c.street}, ${c.city}`;
    const by = `${!c.ownBrokerage && box.dataset.brThumb ? `<img src="${esc(box.dataset.brThumb)}" alt="Broker Reciprocity listing" height="14" /> ` : ''}Listing courtesy of ${esc(c.office)}`;
    return `<li class="est-comp">${c.photo ? `<img class="est-comp__photo" src="${esc(c.photo)}?class=small" alt="${esc(addr)}" width="240" height="160" loading="lazy" />` : '<span class="est-comp__photo est-comp__none">No photo</span>'}`
      + `<strong>${money(c.soldPrice)}</strong><span>Sold ${esc(soldOn(c.soldDate))}</span><span>${esc(addr)}</span><small>${by}</small></li>`;
  };
  async function show(f: Record<string, string>) {
    box.hidden = false;
    box.scrollIntoView({ behavior: 'smooth', block: 'start' });
    const r = await fetch('/api/estimate', { method: 'POST', headers: { 'content-type': 'application/json', 'x-idx-eula': 'agreed' },
      body: JSON.stringify({ zip: f.zip, type: f.homeType, beds: f.beds, baths: f.baths, sqft: f.sqft,
        address: f.address, firstName: f.firstName, lastName: f.lastName, email: f.email, phone: f.phone }) }).catch(() => null);
    const a = r ? await r.json().catch(() => ({})) : {};
    const mailed = a.emailed && f.email ? `<p class="est__mailed">We also emailed this to ${esc(f.email)}.</p>` : '';
    if (!a.ok) {
      out.innerHTML = a.error === 'not-enough-sales'
        ? `<h2>We'll prepare your value by hand</h2><p>There haven't been enough recent sales of homes like yours in ${esc(f.zip)} for an instant estimate. We got your details, and one of our agents will send you a value based on the best comparable sales.</p>${mailed}`
        : `<h2>We got your request</h2><p>The instant estimate isn't available right now, but one of our agents will send you a value for your home shortly.</p>${mailed}`;
      return;
    }
    out.innerHTML = `<p class="eyebrow">Instant estimate for ${esc(f.address)}</p>`
      + `<p class="est__range">${money(a.low)} – ${money(a.high)}</p>`
      + `<p class="est__mid">Middle of the range: <strong>${money(a.mid)}</strong></p>`
      + `<p>Based on ${a.n} similar homes that sold in ZIP ${esc(a.zip)} in the last ${a.months} months, using their ${esc(a.method)}${a.method === 'price per square foot' ? ` and your ${Number(String(f.sqft).replace(/\D/g, '')).toLocaleString('en-US')} square feet` : ''}.</p>`
      + mailed
      + `<h3>Recent sales we used</h3><ul class="est-comps">${(a.comps ?? []).map(comp).join('')}</ul>`;
  }
  window.addEventListener('lead-sent', (e: Event) => {
    const { el, fields } = (e as CustomEvent).detail ?? {};
    if (el !== form) return;
    // Sold data shows only after I AGREE (the license gate covers the result until then).
    if (document.documentElement.classList.contains('idx-ok')) show(fields);
    else { box.hidden = false; window.addEventListener('idx-agreed', () => show(fields), { once: true }); }
  });
</script>

<style>
  .est { display: grid; gap: 2.5rem; max-width: 48rem; }
  .est__form h2 { margin: 0 0 .5rem; }
  .est__form h3 { margin: 1rem 0 .25rem; font-size: 1.1rem; }
  @media (min-width: 640px) { .est__three { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .est__result { padding: 1.5rem; border: 1px solid var(--line); background: var(--paper); }
  .est__result :global(.est__range) { margin: .25rem 0; font: 600 clamp(2rem, 6vw, 3rem)/1.1 var(--serif); color: var(--crimson); }
  .est__result :global(.est__mid) { margin: 0 0 1rem; font-size: 1.1rem; }
  .est__note { font-size: .95rem; color: var(--text-soft); }
  .est__result :global(.est-comps) { list-style: none; margin: 1rem 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr)); gap: 1rem; }
  .est__result :global(.est-comp) { display: grid; gap: .2rem; font-size: .92rem; }
  .est__result :global(.est-comp__photo) { width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 6px; background: var(--sand); display: grid; place-items: center; color: var(--text-soft); }
  .est__result :global(.est-comp strong) { font-size: 1.1rem; }
  .est__result :global(.est-comp small) { display: flex; flex-wrap: wrap; gap: .3rem; align-items: center; color: var(--text-soft); }
</style>
