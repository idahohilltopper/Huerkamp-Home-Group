---
// One free guide: what's inside, and the form (name, email, phone) that sends a "free-guide" lead and then shows the
// download link (src/data/free-guides.ts).
import Base from '../../layouts/Base.astro';
import { freeGuides } from '../../data/free-guides';
import { site } from '../../data/site';

export function getStaticPaths() {
  return freeGuides.map((g) => ({ params: { slug: g.slug }, props: { g } }));
}
const { g } = Astro.props;
---
<Base breadcrumbs={[{ name: 'Free guides', href: '/free-guides' }, { name: g.title, href: `/free-guides/${g.slug}` }]}
  title={`${g.title}: Free Guide | ${site.name}`} description={g.blurb} image={`${g.cover}-1200.jpg`}>
  <section class="section fg">
    <div class="wrap fg__grid">
      <header class="fg__head">
        <p class="eyebrow">Free guide · for {g.audience.toLowerCase()}</p>
        <h1>{g.title}</h1>
      </header>
      <div class="fg__about">
        <picture>
          <source type="image/webp" srcset={`${g.cover}-600.webp 600w, ${g.cover}-1200.webp 1200w`} sizes="(max-width: 900px) 100vw, 34rem" />
          <img class="fg__cover" src={`${g.cover}-1200.jpg`} alt={`${g.title}: the free guide`} width="600" height="600" fetchpriority="high" />
        </picture>
        <p class="fg__blurb">{g.blurb}</p>
        <h2>What's inside</h2>
        <ul class="fg__points">{g.points.map((p) => <li>{p}</li>)}</ul>
        <p class="fg__meta">{g.pages}-page PDF · written by {site.name}, {site.brokerage}</p>
      </div>
      <div class="fg__side">
        <form class="form" data-lead="free-guide" id="guide-form">
          <h2>Get the free guide</h2>
          <p class="form__note">Tell us where to send it. The download opens right away.</p>
          <input type="hidden" name="guide" value={g.tag} />
          {g.interest && <input type="hidden" name="interest" value={g.interest} />}
          <div class="form__row">
            <div class="field"><label for="fg-first">First name</label><input id="fg-first" name="firstName" autocomplete="given-name" required /></div>
            <div class="field"><label for="fg-last">Last name</label><input id="fg-last" name="lastName" autocomplete="family-name" required /></div>
          </div>
          <div class="field"><label for="fg-email">Email</label><input id="fg-email" name="email" type="email" autocomplete="email" required /></div>
          <div class="field"><label for="fg-phone">Phone</label><input id="fg-phone" name="phone" type="tel" autocomplete="tel" required pattern="[^0-9]*([0-9][^0-9]*){10,}" title="Please enter your phone number, including area code." /></div>
          <button class="btn" type="submit">Get my free guide</button>
          <p class="form__status" role="status" aria-live="polite"></p>
        </form>
        <div class="fg__done" data-guide-done hidden>
          <h2>Your guide is ready</h2>
          <p>Thanks! Here's your copy of {g.title}. An agent may reach out in case you have questions.</p>
          <a class="btn" href={g.pdf} target="_blank" rel="noopener" data-guide-pdf>Download the guide (PDF)</a>
          <p class="fg__more"><a class="link-arrow" href="/free-guides">See all free guides</a></p>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // After the form is sent (Base.astro dispatches "lead-sent"), swap the form for the download.
  addEventListener('lead-sent', (e: Event) => {
    const d = (e as CustomEvent).detail || {};
    if (d.form !== 'free-guide') return;
    const form = document.getElementById('guide-form');
    const done = document.querySelector<HTMLElement>('[data-guide-done]');
    if (!form || !done) return;
    form.hidden = true;
    done.hidden = false;
    done.querySelector<HTMLElement>('[data-guide-pdf]')?.focus();
  });
</script>

<style>
  .fg__grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 1.5rem clamp(2rem, 5vw, 4rem); align-items: start; }
  @media (max-width: 900px) { .fg__grid { grid-template-columns: 1fr; } }
  .fg__about { display: grid; gap: 1rem; }
  .fg__head { grid-column: 1 / -1; }
  .fg__head .eyebrow { margin-bottom: .6rem; }
  .fg__head h1 { font: 400 clamp(2.1rem, 4.5vw, 3.2rem)/1.08 var(--serif-display); margin: 0; }
  .fg__cover { display: block; width: 100%; max-width: 34rem; height: auto; border: 1px solid var(--line); }
  .fg__blurb { font-size: 1.12rem; margin: 0; }
  .fg__about h2 { font: 500 1.4rem/1.2 var(--serif); margin: .5rem 0 0; }
  .fg__points { margin: 0; padding-left: 1.2rem; display: grid; gap: .4rem; }
  .fg__meta { color: var(--text-soft); font-size: .9rem; margin: 0; }
  .fg__side { position: sticky; top: 1.5rem; }
  .fg__side .form h2, .fg__done h2 { font: 500 1.6rem/1.2 var(--serif); margin: 0; }
  .fg__done { display: grid; gap: 1rem; padding: clamp(1.5rem, 4vw, 2.25rem); background: var(--surface); border: 1px solid var(--line); border-top: 3px solid var(--crimson); }
  .fg__done p { margin: 0; }
  .fg__done .btn { justify-self: start; }
  @media (max-width: 900px) { .fg__side { position: static; order: 1; } .fg__about { order: 2; } .fg__head { order: 0; } }
</style>
