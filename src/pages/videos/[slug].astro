---
// Watch page for one video: the video is the main content (what Google needs to show it in video
// results), with its summary, chapters (shown by Google as "key moments"), the communities it covers,
// and related videos.
import Base from '../../layouts/Base.astro';
import VideoCard from '../../components/VideoCard.astro';
import { youtubeHtml } from '../../lib/youtube.mjs';
import { channel, watchable, longVideos, videosAbout, youtubeUrl, clock, isoDuration, views, type Video } from '../../data/youtube';
import { communities } from '../../data/areas';
import { videoNotes } from '../../data/videoNotes';
import { business, origin } from '../../data/schema';
import { site } from '../../data/site';

export function getStaticPaths() {
  return watchable.map((v) => ({ params: { slug: v.slug }, props: { v } }));
}
const { v } = Astro.props as { v: Video };
const url = `${origin}/videos/${v.slug}`;
const date = new Date(v.published!);
const dateText = date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const description = v.summary.join(' ');
const metaDescription = description.length > 158 ? description.slice(0, 155).replace(/\s+\S*$/, '') + '…' : description;
// Community guides this video talks about.
const inTitle = (c: { name: string }) => videosAbout([c.name], 400).some((x) => x.id === v.id && x.title === v.title && new RegExp(`\\b${c.name.replace(/^St\. /, '(St\\.|Saint) ')}\\b`, 'i').test(v.title));
const note = videoNotes.get(v.id);
const noted = communities.filter((c) => note?.places?.includes(c.slug));
const places = [...noted, ...communities.filter((c) => !noted.includes(c) && videosAbout([c.name], 400).some((x) => x.id === v.id))
  .sort((a, b) => Number(inTitle(b)) - Number(inTitle(a)))].slice(0, 8);
const related = longVideos.filter((x) => x.id !== v.id && x.topic === v.topic).slice(0, 6);
const chapters = v.chapters.map((c, i) => ({ ...c, end: v.chapters[i + 1]?.t ?? v.seconds ?? undefined }));

const ld = JSON.stringify([{
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  '@id': `${url}#video`,
  name: v.title,
  description,
  thumbnailUrl: [`https://i.ytimg.com/vi/${v.id}/maxresdefault.jpg`, `https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`],
  uploadDate: v.published,
  duration: isoDuration(v.seconds),
  embedUrl: `https://www.youtube.com/embed/${v.id}`,
  url,
  sameAs: youtubeUrl(v),
  inLanguage: 'en-US',
  ...(v.views != null && { interactionStatistic: { '@type': 'InteractionCounter', interactionType: { '@type': 'WatchAction' }, userInteractionCount: v.views } }),
  author: { '@type': 'Person', name: 'Jason Huerkamp', url: `${origin}/team` },
  publisher: { '@id': business['@id'] },
  ...(places.length && { about: places.map((c) => ({ '@type': 'City', name: `${c.name}, Minnesota`, url: `${origin}/communities/${c.slug}` })) }),
  ...(chapters.length > 1 && {
    hasPart: chapters.map((c) => ({ '@type': 'Clip', name: c.label, startOffset: c.t, ...(c.end && { endOffset: c.end }), url: `${youtubeUrl(v)}&t=${c.t}s` })),
  }),
}, ...(note?.faq.length ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: note.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : [])]);
---
<Base
  breadcrumbs={[{ name: 'Videos', href: '/videos' }, { name: v.title, href: `/videos/${v.slug}` }]}
  title={v.title.length > 50 ? v.title : `${v.title} | Living in Minneapolis`}
  description={metaDescription}
  image={`https://i.ytimg.com/vi/${v.id}/hq720.jpg`}
  article={{ published: date }}>
  <script slot="head" type="application/ld+json" set:html={ld} />

  <article class="watch">
    <div class="wrap watch__wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/videos">Videos</a><span aria-hidden="true">/</span><span>{v.topic}</span></nav>
      <h1>{v.title}</h1>
      <p class="watch__meta">
        <span>Jason Huerkamp · Living in Minneapolis</span>
        <time datetime={v.published}>{dateText}</time>
        {v.seconds && <span>{clock(v.seconds)}</span>}
        {v.views != null && <span>{views(v.views)}</span>}
      </p>
      <div class="watch__player" set:html={youtubeHtml(v.id, v.title, { eager: true })} />

      <div class="watch__grid">
        <div class="watch__body">
          <h2>About this video</h2>
          {v.summary.map((p) => <p>{p}</p>)}
          {note && (
            <>
              <h2>Key takeaways</h2>
              <ul class="takeaways">{note.takeaways.map((t) => <li>{t}</li>)}</ul>
              {note.faq.length > 0 && (
                <>
                  <h2>Questions this video answers</h2>
                  <div class="vfaq">{note.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
                </>
              )}
              {note.links && note.links.length > 0 && <p class="vlinks">Read more: {note.links.map(([t, h], i) => <>{i > 0 && ' · '}<a href={h}>{t}</a></>)}</p>}
              <p class="vnote">Notes written by Huerkamp Home Group from this video. Figures are as stated in the video on {dateText}; check the current numbers in our <a href="/market">market reports</a>.</p>
            </>
          )}
          {chapters.length > 1 && (
            <>
              <h2>Chapters</h2>
              <ol class="chapters">
                {chapters.map((c) => <li><a href={`${youtubeUrl(v)}&t=${c.t}s`} rel="noopener"><span>{clock(c.t)}</span>{c.label}</a></li>)}
              </ol>
            </>
          )}
          <p class="watch__yt"><a class="link-arrow" href={youtubeUrl(v)} rel="noopener">Watch on YouTube</a> · <a class="link-arrow" href={`${channel.url}?sub_confirmation=1`} rel="noopener">Subscribe</a></p>
        </div>
        <aside class="watch__aside">
          {places.length > 0 && (
            <div class="box">
              <h2>Community guides</h2>
              <ul>{places.map((c) => <li><a href={`/communities/${c.slug}`}>{c.name}, MN</a></li>)}</ul>
            </div>
          )}
          <div class="box box--dark">
            <h2>Thinking about a move?</h2>
            <p>Talk with Jason, Brooke and the team. No cost, no pressure.</p>
            <a class="btn" href="/contact">Talk to us</a>
            <a class="phone" href={site.phoneHref}>{site.phone}</a>
          </div>
        </aside>
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="section section--paper" aria-labelledby="related-title">
      <div class="wrap">
        <div class="head"><p class="eyebrow">Keep watching</p><h2 id="related-title">More on {v.topic.toLowerCase()}</h2></div>
        <ul class="vgrid">{related.map((x) => <li><VideoCard video={x} /></li>)}</ul>
        <p class="more"><a class="link-arrow" href="/videos">All videos</a></p>
      </div>
    </section>
  )}
</Base>

<style>
  .watch { padding-block: clamp(2rem, 5vw, 3.5rem) clamp(3rem, 6vw, 4.5rem); }
  .watch__wrap { display: grid; gap: 1.1rem; max-width: 64rem; }
  .crumbs { display: flex; gap: .5rem; font: 700 .72rem/1.3 var(--ui); letter-spacing: .14em; text-transform: uppercase; color: var(--text-soft); }
  .crumbs a { color: var(--crimson); text-decoration: none; }
  .watch h1 { font: 500 clamp(2rem, 4.5vw, 3.1rem)/1.1 var(--serif-display); }
  .watch__meta { display: flex; flex-wrap: wrap; gap: .3rem 1.25rem; color: var(--text-soft); font-size: .95rem; }
  .watch__player { margin-top: .5rem; }
  .watch__grid { display: grid; grid-template-columns: minmax(0, 1fr) 19rem; gap: clamp(1.5rem, 4vw, 3rem); margin-top: 1.5rem; align-items: start; }
  @media (max-width: 860px) { .watch__grid { grid-template-columns: 1fr; } }
  .watch__body { display: grid; gap: 1rem; font-size: 1.05rem; line-height: 1.7; }
  .watch__body h2, .box h2 { font: 600 1.5rem/1.2 var(--serif); }
  .chapters { list-style: none; margin: 0; padding: 0; display: grid; border-top: 1px solid var(--line); }
  .chapters a { display: grid; grid-template-columns: 4.5rem 1fr; padding: .6rem 0; border-bottom: 1px solid var(--line); color: var(--text); text-decoration: none; }
  .chapters a:hover { color: var(--crimson); }
  .chapters span { font: 700 .9rem/1.7 var(--ui); color: var(--crimson); font-variant-numeric: tabular-nums; }
  .watch__yt { margin-top: .5rem; }
  .takeaways { margin: 0; padding-left: 1.2rem; display: grid; gap: .55rem; }
  .vfaq { display: grid; gap: .6rem; }
  .vfaq details { padding: .85rem 1rem; background: var(--paper); border: 1px solid var(--line); }
  .vfaq summary { cursor: pointer; font: 600 1.08rem/1.35 var(--serif); }
  .vfaq details p { margin-top: .5rem; font-size: 1rem; }
  .vlinks a { color: var(--crimson); font-weight: 600; }
  .vnote { font-size: .85rem; color: var(--text-soft); }
  .watch__aside { display: grid; gap: 1.25rem; }
  .box { display: grid; gap: .75rem; padding: 1.5rem; background: var(--paper); border: 1px solid var(--line); }
  .box ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .45rem; }
  .box ul a { color: var(--crimson-deep); }
  .box--dark { background: var(--night); border-color: var(--night); color: var(--on-dark); }
  .box--dark h2 { color: #fff; }
  .box--dark .phone { color: var(--on-dark); }
  .vgrid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr)); gap: 2rem 1.5rem; }
  .more { margin-top: 1.75rem; }
</style>
