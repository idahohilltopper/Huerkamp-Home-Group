---
// Detached townhomes for sale in Minnesota (/detached-townhomes-for-sale-mn): every listing whose own description calls it a
// detached townhome or townhouse, a detached villa or an association-maintained single-family home, from the live MLS feed
// (Twin Cities communities) and the Greater Minnesota towns. Open SEO, Nov 18, 2026: "detached townhomes for sale mn" 70
// searches a month (140 a month June to August 2026), keyword difficulty 0; page one is Zillow's Blaine filter page, a
// Facebook post and Trulia. Listing facts only (nothing about who lives there). Rebuilt with every build.
import FeedTopicPage from '../components/FeedTopicPage.astro';
import { listingsData, median, money } from '../data/listings';
import { communities } from '../data/areas';
import { loadMnCities, mnTowns } from '../lib/mn-cities.mjs';
import { site } from '../data/site';

const RE = /\b(detached (town ?homes?|town ?houses?|villas?|twin ?homes?)|(association|hoa)[- ]maintained (single[- ]family|detached|villa|home)|villa[- ]style (detached|single[- ]family))\b/i;
const ONE = /\b(one[- ]level|single[- ]level|main[- ]floor living|rambler|one[- ]story)\b/i;
const ok = (l: any) => l.price > 1000 && l.type !== 'land' && RE.test(`${l.description ?? ''} ${l.style ?? ''}`);
const data = await listingsData;
const mn = await loadMnCities();
const metro = data.mode === 'off' ? [] : data.listings.filter(ok);
const towns = Object.values(mn.towns).flat().filter(ok) as any[];
const seen = new Set(metro.map((l) => l.mls));
const homes = [...metro, ...towns.filter((l) => !seen.has(l.mls))];
const day = data.at ? new Date(data.at).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'America/Chicago' }) : '';
const placeOf = (l: any) => (l.mnTown ? mnTowns.find((t) => t.slug === l.mnTown)?.name : communities.find((c) => c.slug === l.community)?.name) ?? l.city;
const prices = homes.map((l) => l.price);
const row = (label: string, list: typeof homes) => ({ label, n: list.length, med: median(list.map((l) => l.price)) });
const byPlace = [...new Set(homes.map(placeOf))].map((p) => row(p, homes.filter((l) => placeOf(l) === p))).sort((a, b) => b.n - a.n);
const BANDS: [string, number, number][] = [['Under $400,000', 0, 400000], ['$400,000 to $550,000', 400000, 550000], ['$550,000 to $750,000', 550000, 750000], ['$750,000 and up', 750000, Infinity]];
const byPrice = BANDS.map(([label, lo, hi]) => row(label, homes.filter((l) => l.price >= lo && l.price < hi))).filter((r) => r.n);
const one = homes.filter((l) => ONE.test(`${l.description ?? ''} ${l.style ?? ''}`)).length;
const nc = homes.filter((l) => l.newConstruction).length;
const fees = homes.map((l) => l.hoa).filter((h): h is number => !!h && h > 0 && h < 5000);
const answer = homes.length
  ? `${homes.length} detached townhomes and villas are for sale in Minnesota in NorthstarMLS as of ${day}, by Huerkamp Home Group's count, from ${money(Math.min(...prices))} to ${money(Math.max(...prices))}, median ${money(median(prices)!)}.${one ? ` ${one} describe one-level living or a rambler layout.` : ''}${nc ? ` ${nc} are new construction.` : ''}${fees.length ? ` The median association fee is ${money(median(fees)!)} a month, as listed.` : ''}`
  : '';
const shown = [...homes].sort((a, b) => Number(ONE.test(b.description ?? '')) - Number(ONE.test(a.description ?? '')) || a.price - b.price).slice(0, 48);
const faq = [
  ...(answer ? [{ q: 'How many detached townhomes are for sale in Minnesota?', a: answer }] : []),
  { q: 'What is a detached townhome?', a: 'A free-standing house, with no shared walls, in a neighborhood where an association handles outside upkeep such as lawn care and snow removal, and sometimes more. Builders also call them detached villas or association-maintained homes. Legally, many are single-family homes on their own lots; others are set up as townhome or common-interest communities. The listing and the association documents say which.' },
  { q: 'What does the association fee cover?', a: 'It varies by neighborhood. Common items are lawn mowing, snow removal from driveways and walks, trash, and sometimes irrigation, exterior painting or roof replacement. Read the association\'s budget, reserves and rules, and ask what the fee has done over the last few years, before you write an offer.' },
  { q: 'How do I hear about new detached townhomes first?', a: `Tell us below which cities you like, and we'll email you new detached townhomes the moment they're listed, including new-construction releases. Or call or text ${site.phone}.` },
];
---
<FeedTopicPage path="/detached-townhomes-for-sale-mn" crumb="Detached townhomes" at={data.at} noindex={data.preview || !homes.length}
  title={`Detached Townhomes for Sale in MN${homes.length ? ` (${homes.length})` : ''}: Villas & Association-Maintained Homes | ${site.name}`}
  description={answer || 'Detached townhomes, villas and association-maintained homes for sale in Minnesota, from NorthstarMLS.'}
  eyebrow="Detached townhomes" h1="Detached townhomes for sale in Minnesota" answer={answer}
  lede={`Every listing in NorthstarMLS that calls itself a detached townhome, a detached villa or an association-maintained single-family home, in the Twin Cities and <a href="/minnesota-homes-for-sale">Greater Minnesota towns</a>, updated ${day}. One-level homes first. Prefer shared walls and a lower price? See <a href="/townhomes-for-sale-mn">all townhomes for sale</a>.`}
  tables={[{ h: 'By city', col: 'City', rows: byPlace }, { h: 'By price', col: 'List price', rows: byPrice }]}
  note={`Listings whose own description uses one of these terms; read each listing and the association documents for what the fee covers. Updated ${day}.`}
  shown={shown} shownH="Detached townhomes for sale, one-level first"
  ask={{ eyebrow: 'Want the yard work done for you?', h2: 'Get detached townhomes <em>first.</em>', p: "Tell us the cities you like and your budget. We'll email new detached townhomes and villas the moment they're listed, including new-construction releases.", interest: 'Detached townhome', msg: 'Cities, one-level or not, budget (optional)' }}
  faq={faq} faqH="Detached townhomes"
  links={[['Townhomes for sale', '/townhomes-for-sale-mn'], ['New construction', '/new-construction'], ['Downsizing', '/downsizing'], ['Condos for sale', '/condos-for-sale-mn']]} />
