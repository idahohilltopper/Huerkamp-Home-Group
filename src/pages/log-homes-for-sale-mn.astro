---
// Log homes for sale in Minnesota (/log-homes-for-sale-mn): every listing whose style or description calls it a log home,
// log cabin, full-log or log-sided home, from the live MLS feed (Twin Cities communities), the Greater Minnesota towns
// (src/lib/mn-cities.mjs) and the northern Minnesota lake areas (src/lib/north-lakes.mjs). Open SEO, Nov 18, 2026:
// "log homes for sale minnesota" 210 searches a month and "log homes for sale mn" 170, keyword difficulty 0.
// Listing facts only. Rebuilt with every build.
import FeedTopicPage from '../components/FeedTopicPage.astro';
import { listingsData, median, money } from '../data/listings';
import { communities } from '../data/areas';
import { loadMnCities, mnTowns } from '../lib/mn-cities.mjs';
import { loadNorthLakes, north } from '../lib/north-lakes.mjs';
import { site } from '../data/site';

const LOG = /\b(log (home|house|cabin|sided|siding|construction|exterior|walls?|style)|full[- ]log|scribe[- ]fit(ted)?|hand[- ]?(hewn|scribed|peeled) logs?|log[- ]sided)\b/i;
const SIDED = /\blog[- ]sid(ed|ing)\b/i;
const ok = (l: any) => l.price > 1000 && l.type !== 'land' && LOG.test(`${l.style ?? ''} ${l.description ?? ''}`);
const data = await listingsData;
const mn = await loadMnCities();
const lakes = await loadNorthLakes();
const groupName = new Map(north.regions.filter((r: any) => r.state === 'MN').flatMap((r: any) => r.groups.map((g: any) => [g.slug, g.name])));
const seen = new Set<string>();
const homes: any[] = [];
const add = (l: any, area: string) => { if (!seen.has(l.mls) && ok(l)) { seen.add(l.mls); homes.push({ ...l, area }); } };
if (data.mode !== 'off') for (const l of data.listings) add(l, communities.find((c) => c.slug === l.community)?.name ?? l.city);
for (const t of mnTowns) for (const l of (mn.towns[t.slug] ?? []) as any[]) add(l, t.name);
for (const [slug, g] of Object.entries((lakes as any).groups ?? {}) as [string, any][]) { const name = groupName.get(slug); if (name) for (const l of g.active ?? []) add(l, name); }
const day = data.at ? new Date(data.at).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'America/Chicago' }) : '';
const prices = homes.map((l) => l.price);
const row = (label: string, list: any[]) => ({ label, n: list.length, med: median(list.map((l) => l.price)) });
const byArea = [...new Set(homes.map((l) => l.area))].map((a) => row(a, homes.filter((l) => l.area === a))).sort((a, b) => b.n - a.n);
const BANDS: [string, number, number][] = [['Under $300,000', 0, 300000], ['$300,000 to $500,000', 300000, 500000], ['$500,000 to $800,000', 500000, 800000], ['$800,000 and up', 800000, Infinity]];
const byPrice = BANDS.map(([label, lo, hi]) => row(label, homes.filter((l) => l.price >= lo && l.price < hi))).filter((r) => r.n);
const sided = homes.filter((l) => SIDED.test(l.description ?? '')).length;
const lakefront = homes.filter((l) => l.lakefront).length;
const acres = homes.filter((l) => (l.lotAcres ?? 0) >= 5).length;
const answer = homes.length
  ? `${homes.length} log homes are for sale in Minnesota in NorthstarMLS as of ${day}, by Huerkamp Home Group's count, from ${money(Math.min(...prices))} to ${money(Math.max(...prices))}, median ${money(median(prices)!)}.${lakefront ? ` ${lakefront} are lakefront` : ''}${lakefront && acres ? ` and ${acres} sit on 5 acres or more.` : lakefront ? '.' : acres ? ` ${acres} sit on 5 acres or more.` : ''}${sided ? ` ${sided} describe log siding rather than solid log walls.` : ''}`
  : '';
const shown = [...homes].sort((a, b) => Number(SIDED.test(a.description ?? '')) - Number(SIDED.test(b.description ?? '')) || a.price - b.price).slice(0, 48);
const faq = [
  ...(answer ? [{ q: 'How many log homes are for sale in Minnesota?', a: answer }] : []),
  { q: 'What should I check before buying a log home?', a: 'Rot and insect damage, especially in the bottom logs and around windows, doors and decks; when the logs were last stained or sealed; gaps in the chinking or caulking; and settling around windows and doors. Hire an inspector who has inspected log homes before, and ask the seller for maintenance records.' },
  { q: 'Is a log home harder to insure or finance?', a: 'Sometimes. Some insurers and lenders treat log homes differently, and a rural log home with few nearby log-home sales can be harder to appraise. Get an insurance quote and talk with your lender before you write an offer, not after.' },
  { q: 'What is the difference between a log home and a log-sided home?', a: 'A full-log home has solid log walls that are the structure. A log-sided home is a standard framed house with half-log siding on the outside. They look alike from the street, but the upkeep, insulation and inspection are different, so read the listing and ask.' },
];
---
<FeedTopicPage path="/log-homes-for-sale-mn" crumb="Log homes" at={data.at} noindex={data.preview || !homes.length}
  title={`Log Homes for Sale in MN${homes.length ? ` (${homes.length})` : ''}: Log Cabins & Homes by Area | ${site.name}`}
  description={answer || 'Log homes and log cabins for sale in Minnesota, from NorthstarMLS, by area and price.'}
  eyebrow="Log homes" h1="Log homes for sale in Minnesota" answer={answer}
  lede={`Every listing in NorthstarMLS that calls itself a log home, log cabin, full-log or log-sided home: in the Twin Cities, <a href="/minnesota-homes-for-sale">Greater Minnesota towns</a> and the northern lake areas, updated ${day}. Solid log homes first, lowest price first. Looking for any cabin? See <a href="/cabins-for-sale-mn">cabins for sale in Minnesota</a>.`}
  tables={[{ h: 'By area', col: 'Area', rows: byArea }, { h: 'By price', col: 'List price', rows: byPrice }]}
  note={`Listings whose own style or description says log home, log cabin, full-log or log-sided; read each listing for how it's built. Updated ${day}.`}
  shown={shown} shownH="Log homes for sale"
  ask={{ eyebrow: 'Dreaming of a log home?', h2: 'Get log homes <em>first.</em>', p: "Tell us the area, lake or acreage you want. We'll email new log homes the moment they're listed, and help you line up an inspector who knows log construction.", interest: 'Log home', msg: 'Area, lake or acreage, budget (optional)' }}
  faq={faq} faqH="Log homes in Minnesota"
  links={[['Cabins for sale', '/cabins-for-sale-mn'], ['Lake homes', '/lake-homes'], ['Hobby farms and acreage', '/hobby-farms-for-sale-mn'], ['Greater Minnesota homes for sale', '/minnesota-homes-for-sale']]} />
