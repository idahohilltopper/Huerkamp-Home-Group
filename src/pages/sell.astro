---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Quotes from '../components/Quotes.astro';
import { site } from '../data/site';
import closings from '../data/team-closings.json';
import { communities } from '../data/areas';

// Our closings by city (src/data/team-closings.json), the cities with the most, for the "sold where you live" strip.
const topCities = Object.entries(closings.cities as Record<string, { n: number; seller: number }>)
  .filter(([, v]) => v.n >= 5).sort((a, b) => b[1].n - a[1].n).slice(0, 12)
  .map(([s, v]) => ({ s, v, name: communities.find((c) => c.slug === s)?.name })).filter((x) => x.name);

---
<Base
  breadcrumbs={[{ name: 'Sell', href: '/sell' }]}
  title="Sell Your Home in the Twin Cities | Huerkamp Home Group"
  description="Find out what your Twin Cities home is worth and how Huerkamp Home Group markets it to buyers.">
  <PageHero eyebrow="Selling" title="Sell Your Twin Cities Home"
    lede="Start with a free, local estimate of what your home is worth, then get a plan to sell it." />

  <section class="section" id="value" aria-labelledby="value-title">
    <div class="wrap split-2">
      <div class="prose">
        <p class="eyebrow">Home value</p>
        <h2 id="value-title">What is your home <em>worth today?</em></h2>
        <p>An online estimate can't see your kitchen update or the new roof. One of our agents will compare your home with recent sales nearby and send you a price range you can plan around.</p>
        <p>There's no cost and no obligation to list with us.</p>
        <p>Want a number right now? Try our <a href="/home-estimate">instant home value estimate</a> from recent sales near you.</p>
        <p>Curious what you'd walk away with? Try the <a href="/calculators/seller-net-proceeds">seller net proceeds calculator</a>, with Minnesota's deed tax built in, and see <a href="/selling-in-minnesota">what your city requires before you sell</a>.</p>
      </div>
      <form class="form" data-lead="home-value">
        <h3>Request your home value</h3>
        <div class="field"><label for="val-address">Home address</label><input id="val-address" name="address" autocomplete="street-address" required /></div>
        <div class="form__row">
          <div class="field"><label for="val-first">First name</label><input id="val-first" name="firstName" autocomplete="given-name" required /></div>
          <div class="field"><label for="val-last">Last name</label><input id="val-last" name="lastName" autocomplete="family-name" required /></div>
        </div>
        <div class="form__row">
          <div class="field"><label for="val-email">Email</label><input id="val-email" name="email" type="email" autocomplete="email" required /></div>
          <div class="field"><label for="val-phone">Phone</label><input id="val-phone" name="phone" type="tel" autocomplete="tel" required pattern="[^0-9]*([0-9][^0-9]*){10,}" title="Please enter your phone number, including area code." /></div>
        </div>
        <div class="field">
          <label for="val-timeline">When might you sell?</label>
          <select id="val-timeline" name="timeline">
            <option value="">Choose one</option>
            <option>Within 3 months</option>
            <option>3 to 6 months</option>
            <option>6 to 12 months</option>
            <option>Just curious</option>
          </select>
        </div>
        <button class="btn" type="submit">Get my home value</button>
        <p class="form__status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="sold-here-title">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">Sold where you live</p>
        <h2 id="sold-here-title">{closings.total.n.toLocaleString('en-US')} homes sold in the last 3 years, <em>{closings.total.seller} for sellers.</em></h2>
        <p>From the team's closing records, city by city. Pick yours:</p>
      </div>
      <ul class="sold-here">{topCities.map((c) => <li><a href={`/real-estate-agents/${c.s}-mn`}><strong>{c.name}</strong> <span>{c.v.n} sold</span></a></li>)}<li><a href="/real-estate-agents"><strong>Every city</strong> <span>see all</span></a></li></ul>
    </div>
  </section>

  <!-- Section copy below is verbatim from huerkamphomegroup.com/why-list-with-us -->
  <section class="section section--dark" aria-labelledby="why-list-title">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">Why list with us</p>
        <h2 id="why-list-title">A complete <em>marketing solution.</em></h2>
      </div>
      <div class="why-grid">
        <div class="prose">
          <p>We offer a comprehensive marketing solution designed to help our clients achieve their real estate goals. We are dedicated to providing personalized support and guidance throughout the entire process and understand the importance of building solid relationships with clients in the real estate industry. Our customized approach allows us to connect with our desired clients, increase brand awareness, drive sales, and boost engagement. Our comprehensive marketing solution is designed to help our clients succeed in a competitive real estate market by providing tailored strategies, proactive support, and effective marketing. Our expertise and dedication help our clients achieve their real estate goals.</p>
          <ul>
            <li>Aggressive marketing and re-marketing across the entire digital landscape</li>
            <li>Precise demographic targeting</li>
            <li>Highly advanced and proactive customer support</li>
          </ul>
        </div>
        <div class="prose">
          <h3>Outstanding service</h3>
          <p>We know that your property means a lot to you, and this is why you can trust our team of dedicated agents to have your best interests at heart. Our agents are some of the best and most thoroughly trained in the industry – and they have built their careers doing whatever it takes to find the right buyers and land the best deals for each and every one of our clients. More than that, our agents are hardworking researchers who are always prepared to leverage relevant information to raise the demand of your property – regardless of price, type, and location.</p>
          <h3>Transparency and integrity</h3>
          <p>Our agents are committed to keeping you informed about all relevant aspects of the sales process – from lead generation to actual sale. Simply put, our agents will keep you posted every step of the way.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="cash" aria-labelledby="cash-title">
    <div class="wrap cash">
      <div class="prose">
        <p class="eyebrow">Another option</p>
        <!-- Heading and paragraph verbatim from huerkamphomegroup.com/sell -->
        <h2 id="cash-title">Get a Cash Offer for Your Home in Just 24 Hours!</h2>
        <p>Sell your home fast and hassle-free with our team of experienced agents. No repairs, no staging, no open houses. Just a fair, all-cash offer.</p>
      </div>
      <p class="cash__btns"><a class="btn btn--dark" href="/cash-offer">Get my cash offer</a> <a class="link-arrow" href="/expired-listing">Listing expired? Get a free second look</a> <a class="link-arrow" href="/when-to-sell">Sell now or wait for spring? See the numbers</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="downsize-title">
    <div class="wrap">
      <div class="head"><p class="eyebrow">Downsizing & 55+</p><h2 id="downsize-title">Selling the family home?</h2>
        <p>Plain-English guides for the move to one-level, 55+ or maintenance-free living, the taxes, the timing, and selling a parent's home.</p></div>
      <p class="links"><a class="link-arrow" href="/downsizing">All downsizing guides</a> <a class="link-arrow" href="/downsizing/how-to-downsize">How to downsize, step by step</a> <a class="link-arrow" href="/downsizing/selling-a-parents-home">Selling a parent's home</a> <a class="link-arrow" href="/downsizing/checklist">Printable checklist</a></p>
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="fsbo-sell-title">
    <div class="wrap">
      <div class="head"><p class="eyebrow">Selling it yourself?</p><h2 id="fsbo-sell-title">The free FSBO guide</h2>
        <p>The same plan, paperwork list and pricing data an agent uses, with the Minnesota rules behind each step, plus a free second opinion when you want one.</p></div>
      <p class="links"><a class="link-arrow" href="/for-sale-by-owner">FSBO guide</a> <a class="link-arrow" href="/for-sale-by-owner/how-to-sell-your-home-by-owner">Step by step</a> <a class="link-arrow" href="/for-sale-by-owner/fsbo-paperwork">Paperwork checklist</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="fc-sell-title">
    <div class="wrap">
      <div class="head"><p class="eyebrow">Short sales & foreclosure</p><h2 id="fc-sell-title">Behind on your mortgage?</h2>
        <p>Minnesota law gives you time and choices, including selling before or after a sheriff's sale. Here's how it works, privately and in plain English.</p></div>
      <p class="links"><a class="link-arrow" href="/foreclosure">All short sale & foreclosure guides</a> <a class="link-arrow" href="/foreclosure/behind-on-your-mortgage">Your options</a> <a class="link-arrow" href="/foreclosure/minnesota-foreclosure-process">The Minnesota foreclosure timeline</a> <a class="link-arrow" href="/foreclosure/short-sale">How a short sale works</a></p>
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="seller-reviews-title">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">From our sellers</p>
        <h2 id="seller-reviews-title">Sold, <em>in their words.</em></h2>
      </div>
      <Quotes reviewers={['Erin Johnson', 'Stephanie Peterson', 'Lauren Hughes']} />
    </div>
  </section>
</Base>

<style>
  .sold-here { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 11rem), 1fr)); gap: .6rem; }
  .sold-here a { display: flex; justify-content: space-between; gap: .5rem; padding: .75rem 1rem; background: #fff; border: 1px solid var(--line); color: var(--text); text-decoration: none; }
  .sold-here a:hover { border-color: var(--crimson); }
  .sold-here span { color: var(--crimson); font-weight: 700; white-space: nowrap; }
  .why-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 4rem); }
  .why-grid .prose { max-width: none; }
  @media (max-width: 860px) { .why-grid { grid-template-columns: 1fr; } }
  .cash__btns { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem; margin: 0; }
  .cash { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 2rem; }
  .links { display: flex; flex-wrap: wrap; gap: 1rem 2rem; }
</style>
