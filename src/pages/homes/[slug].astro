  .tour__day span { display: grid; gap: .3rem; padding: 1rem .5rem; border: 1px solid #c9c1b6; border-radius: 6px; background: #fff; text-align: center; font: 400 1rem/1.2 var(--ui); }
  .tour__day b { font: 700 .82rem/1 var(--ui); text-transform: uppercase; letter-spacing: .04em; }
  .tour__day input:checked + span { border: 2px solid var(--crimson); padding: calc(1rem - 1px) calc(.5rem - 1px); background: #fdf2f2; }
  .tour__day input:focus-visible + span { outline: 2px solid var(--ink); outline-offset: 2px; }
  .tour__step { flex: none; width: 2rem; height: 3rem; border: 0; background: none; color: var(--crimson); font-size: 2rem; line-height: 1; cursor: pointer; }
  .tour__next { width: 100%; border-radius: 6px; }
