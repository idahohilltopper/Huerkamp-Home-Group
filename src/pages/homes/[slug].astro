  .home__afford-btns { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: .9rem !important; }
  .home__afford-btns .btn { padding: .75rem 1.2rem; border-radius: 6px; }
  .home__afford-btns .btn--ghost, .home__travel .btn--ghost { color: var(--crimson); box-shadow: inset 0 0 0 1.5px var(--crimson); }

  .home__tour .tour__days { display: flex; align-items: center; gap: .4rem; margin: 1rem 0; padding: 0; border: 0; min-width: 0; }
  .tour__strip { position: relative; display: flex; gap: .6rem; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; flex: 1; min-width: 0; padding: 2px; }
