  .home__afford { display: flex; gap: 1.25rem; align-items: flex-start; margin-top: 1rem; padding: 1.25rem; border: 1px solid var(--line); border-radius: 10px; background: #fff; box-shadow: 0 2px 10px rgba(0,0,0,.04); }
  .home__afford svg { flex: none; }
  .home__afford h3 { margin: 0 0 .3rem; font: 700 1.15rem/1.2 var(--ui); }
