---
// One page per home builder selling in our communities (src/data/builders.ts): its homes for sale now, by development,
// from the live MLS feed (homes listed by the builder's own sales company). Rebuilt with every build.
import Base from '../../../layouts/Base.astro';
import ListingCard from '../../../components/ListingCard.astro';
import IdxDisclosure from '../../../components/IdxDisclosure.astro';
import { buildersData, type Builder } from '../../../data/builders';
import { money } from '../../../data/listings';
import { site } from '../../../data/site';

export async function getStaticPaths() {
  const { list, mode } = await buildersData;
  if (mode === 'off') return [];
  return list.map((b) => ({ params: { slug: b.slug }, props: { b } }));
}
const { b } = Astro.props as { b: Builder };
const { at, preview, list } = await buildersData;
const day = at ? new Date(at).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'America/Chicago' }) : '';
const join = (a: string[]) => (a.length < 2 ? a.join('') : `${a.slice(0, -1).join(', ')} and ${a.at(-1)}`);
const n = b.listings.length;
const answer = `${n} new ${n === 1 ? 'home' : 'homes'} by ${b.name} ${n === 1 ? 'is' : 'are'} for sale in the Twin Cities as of ${day}, from ${money(b.min)} to ${money(b.max)} (median ${money(b.median!)})${b.devs.length ? `, in ${b.devs.length} ${b.devs.length === 1 ? 'development' : 'developments'}` : ''}${b.cities.length === 1 ? ` in ${b.cities[0]}` : ` across ${b.cities.length} cities`}.`;
const faq = [
  { q: `How much is a new ${b.name} home in the Twin Cities?`, a: answer },
  { q: `Where is ${b.name} building in Minnesota?`, a: `${b.name} homes are for sale in ${join(b.cities.slice(0, 12))}${b.cities.length > 12 ? ` and ${b.cities.length - 12} more cities` : ''}${b.devs.length ? `, including ${join(b.devs.slice(0, 5).map((d) => `${d.name} in ${d.city}`))}` : ''}.` },
  { q: `Can I use my own agent to buy a ${b.name} home?`, a: `Yes. Many builders ask that your agent come with you, or register you, on your first visit to a model or sales office, so call us before you go. We can compare ${b.name}'s plans, lots and incentives with other builders' and review the purchase agreement and warranty with you.` },
];
const ld = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
---
<Base breadcrumbs={[{ name: 'New construction', href: '/new-construction' }, { name: b.name, href: `/new-construction/builders/${b.slug}` }]}
  title={`${b.name} Homes for Sale in Minnesota (${n}): Twin Cities New Homes | ${site.name}`}
  description={answer.slice(0, 300)} noindex={preview}>
  <script slot="head" type="application/ld+json" set:html={ld} />

  <section class="nhead">
    <div class="wrap">
      <p class="eyebrow">New construction · Builders</p>
      <h1>{b.name} homes for sale in the Twin Cities</h1>
      <p class="answer">{answer}</p>
      <p class="lede">Homes listed in NorthstarMLS by {b.brokerage}, {b.name}'s sales company. We're an independent brokerage, not affiliated with {b.name}.</p>
      <p class="hero-btns"><a class="btn" href="#ask">Talk to us before you visit a model</a> <a class="btn btn--ghost" href={site.phoneHref}>Call or text {site.phone}</a></p>
    </div>
  </section>

  {b.devs.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="head"><p class="eyebrow">By development</p><h2>Where {b.name} is selling now</h2></div>
        <div class="table-scroll">
          <table class="data">
            <thead><tr><th scope="col">Development</th><th scope="col">City</th><th scope="col" class="num">{b.name} homes for sale</th><th scope="col" class="num">From</th></tr></thead>
            <tbody>{b.devs.map((d) => <tr><th scope="row"><a href={`/new-construction/${d.path}`}>{d.name}</a></th><td>{d.city}</td><td class="num">{d.n}</td><td class="num">{money(d.min)}</td></tr>)}</tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  <section class="section section--paper">
    <div class="wrap">
      <div class="head"><p class="eyebrow">For sale now</p><h2>{b.name} homes for sale, lowest price first</h2></div>
      <div data-idx><ul class="lcards">{b.listings.slice(0, 60).map((l, i) => <ListingCard l={l} eager={i < 3} />)}</ul></div>
      <IdxDisclosure at={at} />
    </div>
  </section>

  <section class="section section--dark" id="ask" aria-labelledby="ask-title">
    <div class="wrap split">
      <div class="prose">
        <p class="eyebrow">Buying new construction</p>
        <h2 id="ask-title">Compare {b.name} <em>with other builders.</em></h2>
        <p>Many builders ask that your agent come with you, or register you, on your first visit. We'll compare plans, lots, upgrades and incentives across builders, and review the contract and warranty with you.</p>
        <p>Call or text <a href={site.phoneHref}>{site.phone}</a>.</p>
      </div>
      <form class="form" data-lead="new-construction">
        <input type="hidden" name="interest" value={`${b.name} (builder page)`} />
        <div class="form__row">
          <div class="field"><label for="bd-first">First name</label><input id="bd-first" name="firstName" autocomplete="given-name" required /></div>
          <div class="field"><label for="bd-last">Last name</label><input id="bd-last" name="lastName" autocomplete="family-name" required /></div>
        </div>
        <div class="form__row">
          <div class="field"><label for="bd-email">Email</label><input id="bd-email" name="email" type="email" autocomplete="email" required /></div>
          <div class="field"><label for="bd-phone">Phone</label><input id="bd-phone" name="phone" type="tel" autocomplete="tel" required pattern="[^0-9]*([0-9][^0-9]*){10,}" title="Please enter your phone number, including area code." /></div>
        </div>
        <div class="field"><label for="bd-msg">Which development or plan? (optional)</label><textarea id="bd-msg" name="message" rows="3"></textarea></div>
        <button class="btn" type="submit">Send</button>
        <p class="form__status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="wrap faq">
      <div class="head"><p class="eyebrow">Quick answers</p><h2 id="faq-title">{b.name} questions</h2></div>
      {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      <p class="links">{list.filter((x) => x.slug !== b.slug).map((x) => <a class="link-arrow" href={`/new-construction/builders/${x.slug}`}>{x.name}</a>)} <a class="link-arrow" href="/new-construction">All developments</a></p>
    </div>
  </section>
</Base>

<style>
  .nhead { padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(2rem, 4vw, 3rem); background: var(--night); color: var(--on-dark); }
  .nhead h1 { font: 500 clamp(2.2rem, 5vw, 3.6rem)/1.05 var(--serif-display); color: #fff; }
  .nhead .eyebrow { color: var(--rose); }
  .answer { max-width: 52rem; margin: .9rem 0 .4rem; color: #fff; font: 500 clamp(1.05rem, 2.2vw, 1.25rem)/1.5 var(--ui); }
  .lede { color: var(--on-dark); font-size: .95rem; }
  .hero-btns { display: flex; flex-wrap: wrap; gap: .65rem; margin-top: 1.25rem; }
  .head { margin-bottom: 1.25rem; }
  .table-scroll { overflow-x: auto; }
  table.data { width: 100%; border-collapse: collapse; font-size: .98rem; }
  table.data th, table.data td { padding: .55rem .7rem; border-bottom: 1px solid var(--line); text-align: left; }
  table.data .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  @media (max-width: 900px) { .split { grid-template-columns: 1fr; } }
  .split .prose a { color: #fff; font-weight: 700; }
  .faq { display: grid; gap: .75rem; max-width: 52rem; }
  .faq details { padding: 1rem 1.2rem; background: var(--paper); border: 1px solid var(--line); }
  .faq summary { cursor: pointer; font: 600 1.15rem/1.3 var(--serif); }
  .links { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; margin-top: 1rem; }
</style>
