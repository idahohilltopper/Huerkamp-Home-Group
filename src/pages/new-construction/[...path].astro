---
// New-construction developments (src/data/developments.ts): a hub (/new-construction) and one page per development
// (/new-construction/<city>/<development>), built from the live MLS feed at every build, so a development appears while
// its builder is selling and drops off when it sells out. Listings sit inside the I AGREE block with the MLS
// disclosures, like every listing display on the site.
import Base from '../../layouts/Base.astro';
import ListingCard from '../../components/ListingCard.astro';
import IdxDisclosure from '../../components/IdxDisclosure.astro';
import { developmentsData, type Development } from '../../data/developments';
import { homesHref, money, TYPE_LABEL, listingsData } from '../../data/listings';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const { list, mode } = await developmentsData;
  if (mode === 'off') return [];
  return [{ params: { path: undefined }, props: { d: null } }, ...list.map((d) => ({ params: { path: d.path }, props: { d } }))];
}
const { d } = Astro.props as { d: Development | null };
const { list, at, preview } = await developmentsData;
const feed = await listingsData;
const year = new Date().getFullYear();
const day = at ? new Date(at).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'America/Chicago' }) : '';
const plural = (n: number, one: string, many = `${one}s`) => `${n} ${n === 1 ? one : many}`;
const kinds = (x: Development) => x.types.map(([t, n]) => `${n} ${TYPE_LABEL[t] ?? t}`).join(', ');
const span = (r: [number, number] | null, unit: string, fmt = (n: number) => n.toLocaleString('en-US')) => (r ? (r[0] === r[1] ? `${fmt(r[0])} ${unit}` : `${fmt(r[0])} to ${fmt(r[1])} ${unit}`) : '');
const cityNew = (slug: string) => (feed.collections.some((k) => k.path === `${slug}/new-construction`) ? homesHref(`${slug}/new-construction`) : homesHref(slug));

// One development
const answer = d ? [
  `${plural(d.listings.length, 'home')} ${d.listings.length === 1 ? 'is' : 'are'} for sale in ${d.name}, ${d.city}, as of ${day}`,
  d.min === d.max ? `, at ${money(d.min)}.` : `, from ${money(d.min)} to ${money(d.max)} (median ${money(d.median!)}).`,
  ` ${d.newCount === d.listings.length ? 'All are' : `${d.newCount} are`} new construction, built ${year - 1} or later.`,
  d.beds ? ` They have ${span(d.beds, 'bedrooms')}` : '', d.beds && d.sqft ? ` and ${span(d.sqft, 'finished square feet')}.` : d.beds ? '.' : '',
].join('') : '';
const others = d ? list.filter((x) => x.community === d.community && x.path !== d.path) : [];
const faq = d ? [
  { q: `How much are new homes in ${d.name}?`, a: answer },
  { q: `What kinds of homes are for sale in ${d.name}?`, a: `${kinds(d).replace(/^./, (c) => c.toUpperCase())}, listed in NorthstarMLS as of ${day}.` },
  ...(d.brokerages.length ? [{ q: `Who is selling the homes in ${d.name}?`, a: `The homes for sale are listed by ${d.brokerages.length === 1 ? d.brokerages[0] : `${d.brokerages.slice(0, -1).join(', ')} and ${d.brokerages.at(-1)}`}. Builders often sell through their own sales office; you can still have your own agent represent you.` }] : []),
  { q: `Can I use my own agent to buy a new home in ${d.name}?`, a: `Yes. Many builders ask that your agent come with you, or register you, on your first visit to the model or sales office, so call us before you go. Your agent can help compare builders, lots, upgrades and incentives, and review the builder's purchase agreement and warranty.` },
] : [
  { q: 'Where are new homes being built in the Twin Cities?', a: `As of ${day}, ${plural(list.length, 'development')} in ${new Set(list.map((x) => x.city)).size} of our communities ${list.length === 1 ? 'has' : 'have'} new-construction homes for sale: ${[...new Set(list.map((x) => x.city))].join(', ')}.` },
  { q: 'Should I bring my own agent to a builder\'s model home?', a: 'Yes, if you want representation. Many builders ask that your agent come with you, or register you, on your first visit, so line that up before you go.' },
];
const ld = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
const title = d ? `${d.name} New Homes for Sale in ${d.city}, MN (${d.listings.length})` : 'New Construction Homes for Sale in the Twin Cities by Development';
const description = d ? answer : `New-construction developments with homes for sale now across the Twin Cities, by city: prices, kinds of homes and every listing, updated from NorthstarMLS.`;
const crumbs = [{ name: 'New construction', href: '/new-construction' }, ...(d ? [{ name: `${d.name}, ${d.city}`, href: `/new-construction/${d.path}` }] : [])];
const byCity = [...new Set(list.map((x) => x.community))].map((slug) => ({ slug, city: list.find((x) => x.community === slug)!.city, devs: list.filter((x) => x.community === slug) }));
---
<Base breadcrumbs={crumbs} title={`${title} | ${site.name}`} description={description.slice(0, 300)} noindex={preview || (!d && !list.length)}>
  <script slot="head" type="application/ld+json" set:html={ld} />

  <section class="nhead">
    <div class="wrap">
      <p class="eyebrow">New construction{d ? ` · ${d.city}, MN` : ''}</p>
      <h1>{d ? `${d.name} new homes for sale` : 'New construction homes by development'}</h1>
      <p class="answer">{d ? answer : `${plural(list.length, 'development')} with new-construction homes for sale now, from NorthstarMLS, updated ${day}.`}</p>
      <p class="hero-btns"><a class="btn" href="#ask">{d ? `Ask about ${d.name}` : 'Talk to us before you visit a model'}</a> <a class="btn btn--ghost" href={site.phoneHref}>Call or text {site.phone}</a></p>
    </div>
  </section>

  {d ? (
    <>
      <section class="section">
        <div class="wrap">
          <div class="head"><p class="eyebrow">For sale now</p><h2>Homes for sale in {d.name}</h2><p>{kinds(d).replace(/^./, (c) => c.toUpperCase())}, lowest price first.</p></div>
          <div data-idx><ul class="lcards">{d.listings.map((l, i) => <ListingCard l={l} eager={i < 3} />)}</ul></div>
          <IdxDisclosure at={at} />
        </div>
      </section>
      <section class="section section--paper">
        <div class="wrap">
          <p class="chains">
            <a class="link-arrow" href={cityNew(d.community)}>All new construction in {d.city}</a>
            {others.map((o) => <a class="link-arrow" href={`/new-construction/${o.path}`}>{o.name}</a>)}
            <a class="link-arrow" href={`/communities/${d.community}`}>{d.city} community guide</a>
            <a class="link-arrow" href="/new-construction">All developments</a>
          </p>
        </div>
      </section>
    </>
  ) : (
    <section class="section">
      <div class="wrap">
        {byCity.map((c) => (
          <div class="city">
            <h2><a href={cityNew(c.slug)}>{c.city}</a></h2>
            <div class="table-scroll">
              <table class="data">
                <thead><tr><th scope="col">Development</th><th scope="col" class="num">For sale</th><th scope="col" class="num">Price range</th><th scope="col">Kinds of homes</th></tr></thead>
                <tbody>{c.devs.map((x) => <tr><th scope="row"><a href={`/new-construction/${x.path}`}>{x.name}</a></th><td class="num">{x.listings.length}</td><td class="num">{x.min === x.max ? money(x.min) : `${money(x.min)}–${money(x.max)}`}</td><td>{kinds(x)}</td></tr>)}</tbody>
              </table>
            </div>
          </div>
        ))}
        <p class="source">Developments are MLS subdivisions with at least 3 homes for sale, at least half of them built {year - 1} or later. Plat phases are grouped under one name.</p>
      </div>
    </section>
  )}

  <section class="section section--dark" id="ask" aria-labelledby="ask-title">
    <div class="wrap split">
      <div class="prose">
        <p class="eyebrow">Buying new construction</p>
        <h2 id="ask-title">Talk to us <em>before the model home.</em></h2>
        <p>Many builders ask that your agent come with you, or register you, on your first visit. We'll compare builders, lots, upgrades and incentives, and review the builder's contract and warranty with you.</p>
        <p>Call or text <a href={site.phoneHref}>{site.phone}</a>.</p>
      </div>
      <form class="form" data-lead="new-construction">
        <input type="hidden" name="interest" value={d ? `${d.name}, ${d.city}` : 'New construction'} />
        <div class="form__row">
          <div class="field"><label for="nc-first">First name</label><input id="nc-first" name="firstName" autocomplete="given-name" required /></div>
          <div class="field"><label for="nc-last">Last name</label><input id="nc-last" name="lastName" autocomplete="family-name" required /></div>
        </div>
        <div class="form__row">
          <div class="field"><label for="nc-email">Email</label><input id="nc-email" name="email" type="email" autocomplete="email" required /></div>
          <div class="field"><label for="nc-phone">Phone</label><input id="nc-phone" name="phone" type="tel" autocomplete="tel" required pattern="[^0-9]*([0-9][^0-9]*){10,}" title="Please enter your phone number, including area code." /></div>
        </div>
        <div class="field"><label for="nc-msg">Anything we should know? (optional)</label><textarea id="nc-msg" name="message" rows="3"></textarea></div>
        <button class="btn" type="submit">{d ? `Ask about ${d.name}` : 'Get in touch'}</button>
        <p class="form__status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="wrap faq">
      <div class="head"><p class="eyebrow">Quick answers</p><h2 id="faq-title">{d ? `${d.name} questions` : 'New construction questions'}</h2></div>
      {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </div>
  </section>
</Base>

<style>
  .nhead { padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(2rem, 4vw, 3rem); background: var(--night); color: var(--on-dark); }
  .nhead h1 { font: 500 clamp(2.2rem, 5vw, 3.6rem)/1.05 var(--serif-display); color: #fff; }
  .nhead .eyebrow { color: var(--rose); }
  .answer { max-width: 52rem; margin: .9rem 0 .4rem; color: #fff; font: 500 clamp(1.05rem, 2.2vw, 1.25rem)/1.5 var(--ui); }
  .hero-btns { display: flex; flex-wrap: wrap; gap: .65rem; margin-top: 1.25rem; }
  .head { margin-bottom: 1.25rem; }
  .city { margin-bottom: 2rem; }
  .city h2 { font: 500 1.6rem/1.2 var(--serif); margin-bottom: .6rem; }
  .table-scroll { overflow-x: auto; }
  table.data { width: 100%; border-collapse: collapse; font-size: .98rem; }
  table.data th, table.data td { padding: .55rem .7rem; border-bottom: 1px solid var(--line); text-align: left; }
  table.data .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .source { margin-top: 1rem; font-size: .9rem; color: var(--text-soft); }
  .chains { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; }
  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  @media (max-width: 900px) { .split { grid-template-columns: 1fr; } }
  .split .prose a { color: #fff; font-weight: 700; }
  .faq { display: grid; gap: .75rem; max-width: 52rem; }
  .faq details { padding: 1rem 1.2rem; background: var(--paper); border: 1px solid var(--line); }
  .faq summary { cursor: pointer; font: 600 1.15rem/1.3 var(--serif); }
</style>
