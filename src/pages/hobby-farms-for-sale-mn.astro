---
// Hobby farms and homes on acreage (/hobby-farms-for-sale-mn): homes (not bare land) on 5+ acres in our communities,
// from the live MLS feed, by city and by acreage, with the ones whose listing mentions a barn or outbuilding, or horses
// and pasture, counted separately. Rebuilt with every build. Bare land is on /land-for-sale.
import Base from '../layouts/Base.astro';
import ListingCard from '../components/ListingCard.astro';
import IdxDisclosure from '../components/IdxDisclosure.astro';
import { listingsData, homesHref, median, money } from '../data/listings';
import { communities } from '../data/areas';
import { site } from '../data/site';

const MIN_ACRES = 5;
const data = await listingsData;
const homes = data.mode === 'off' ? [] : data.listings.filter((l) => l.type !== 'land' && (l.lotAcres ?? 0) >= MIN_ACRES && l.price > 1000);
const BARN = /\b(barns?|pole (barn|building|shed)|outbuildings?|machine shed|shop building|heated shop|quonset)\b/i;
const HORSE = /\b(horses?|equestrian|paddocks?|pastures?|stalls|riding arena|fenced pasture|hobby farm)\b/i;
const withBarn = homes.filter((l) => BARN.test(l.description));
const horse = homes.filter((l) => HORSE.test(l.description));
const day = data.at ? new Date(data.at).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'America/Chicago' }) : '';
const name = (slug: string) => communities.find((c) => c.slug === slug)?.name ?? slug;
const page = (p: string) => (data.collections.some((k) => k.path === p) ? homesHref(p) : null);
const prices = homes.map((l) => l.price);
const byCity = [...new Set(homes.map((l) => l.community))].map((slug) => {
  const list = homes.filter((l) => l.community === slug);
  return { city: name(slug), n: list.length, med: median(list.map((l) => l.price)), href: page(`${slug}/homes-with-acreage`) };
}).sort((a, b) => b.n - a.n);
const BANDS: [string, number, number][] = [['5 to 10 acres', 5, 10], ['10 to 20 acres', 10, 20], ['20 to 40 acres', 20, 40], ['40 acres or more', 40, Infinity]];
const byAcres = BANDS.map(([label, lo, hi]) => { const list = homes.filter((l) => l.lotAcres! >= lo && l.lotAcres! < hi); return { label, n: list.length, med: median(list.map((l) => l.price)) }; }).filter((r) => r.n);
const answer = homes.length
  ? `${homes.length.toLocaleString('en-US')} homes on ${MIN_ACRES} acres or more are for sale in our Minnesota communities as of ${day}, from ${money(Math.min(...prices))} to ${money(Math.max(...prices))}, with a median list price of ${money(median(prices)!)}. ${withBarn.length} of the listings mention a barn or outbuilding, and ${horse.length} mention horses or pasture.`
  : '';
const shown = [...homes].sort((a, b) => Number(BARN.test(b.description) || HORSE.test(b.description)) - Number(BARN.test(a.description) || HORSE.test(a.description))).slice(0, 48);
const faq = [
  ...(answer ? [{ q: 'How many hobby farms are for sale in Minnesota right now?', a: answer }] : []),
  { q: 'Can I keep horses or other animals on my property?', a: 'It depends on the city or township: most set how many animals you can keep per acre (often in "animal units"), how far barns and manure storage must be from wells and property lines, and whether the zoning allows livestock at all. Ask the city or county planning office about the specific parcel before you buy; we can help you find out.' },
  { q: 'What should I check before buying a home on acreage?', a: 'The well and septic system (age, condition and any required inspection), zoning and animal rules, the condition of barns and outbuildings, fencing, easements and the survey, whether any land is wetland or floodplain, and how the property is classified for property taxes. Rural homes can also take longer to insure and appraise, so start early with your lender and insurer.' },
];
const ld = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
---
<Base breadcrumbs={[{ name: 'Homes for sale', href: '/homes-for-sale' }, { name: 'Hobby farms and acreage', href: '/hobby-farms-for-sale-mn' }]}
  title={`Hobby Farms & Homes on Acreage for Sale in MN${homes.length ? ` (${homes.length.toLocaleString('en-US')})` : ''} | ${site.name}`}
  description={(answer || 'Hobby farms and homes on 5+ acres for sale around the Twin Cities, by city and acreage, from NorthstarMLS.').slice(0, 300)}
  noindex={data.preview || !homes.length}>
  <script slot="head" type="application/ld+json" set:html={ld} />

  <section class="nhead">
    <div class="wrap">
      <p class="eyebrow">Hobby farms and acreage</p>
      <h1>Hobby farms and homes on acreage for sale in Minnesota</h1>
      {answer && <p class="answer">{answer}</p>}
      <p class="lede">Homes on {MIN_ACRES}+ acres in our communities around the Twin Cities, from NorthstarMLS. Looking for bare land? See <a href="/land-for-sale">land and lots for sale</a>.</p>
      <p class="hero-btns"><a class="btn" href="#ask">Tell us what you're looking for</a> <a class="btn btn--ghost" href={site.phoneHref}>Call or text {site.phone}</a></p>
    </div>
  </section>

  {homes.length > 0 && (
    <section class="section">
      <div class="wrap two">
        <div>
          <h2>By city</h2>
          <div class="table-scroll">
            <table class="data">
              <thead><tr><th scope="col">City</th><th scope="col" class="num">For sale</th><th scope="col" class="num">Median price</th></tr></thead>
              <tbody>{byCity.map((r) => <tr><th scope="row">{r.href ? <a href={r.href}>{r.city}</a> : r.city}</th><td class="num">{r.n}</td><td class="num">{money(r.med!)}</td></tr>)}</tbody>
            </table>
          </div>
        </div>
        <div>
          <h2>By acreage</h2>
          <div class="table-scroll">
            <table class="data">
              <thead><tr><th scope="col">Land</th><th scope="col" class="num">For sale</th><th scope="col" class="num">Median price</th></tr></thead>
              <tbody>{byAcres.map((r) => <tr><th scope="row">{r.label}</th><td class="num">{r.n}</td><td class="num">{money(r.med!)}</td></tr>)}</tbody>
            </table>
          </div>
          <p class="source">"Barn or outbuilding" and "horses or pasture" are counted from the words in each listing's description, so check the listing for what's actually there. Updated {day}.</p>
        </div>
      </div>
    </section>
  )}

  {shown.length > 0 && (
    <section class="section section--paper">
      <div class="wrap">
        <div class="head"><p class="eyebrow">For sale now</p><h2>Homes on acreage, barns and outbuildings first</h2></div>
        <div data-idx><ul class="lcards">{shown.map((l, i) => <ListingCard l={l} eager={i < 3} />)}</ul></div>
        <IdxDisclosure at={data.at} />
      </div>
    </section>
  )}

  <section class="section section--dark" id="ask" aria-labelledby="ask-title">
    <div class="wrap split">
      <div class="prose">
        <p class="eyebrow">Room to spread out</p>
        <h2 id="ask-title">Horses, a shop, <em>a big garden?</em></h2>
        <p>Tell us how much land you want, what you'd keep on it and how far you'll drive. We'll watch for it, including homes that come up before they hit the websites, and check zoning, well, septic and outbuildings with you.</p>
        <p>Call or text <a href={site.phoneHref}>{site.phone}</a>.</p>
      </div>
      <form class="form" data-lead="community-alert">
        <input type="hidden" name="interest" value="Hobby farm / homes on acreage" />
        <div class="form__row">
          <div class="field"><label for="hf2-first">First name</label><input id="hf2-first" name="firstName" autocomplete="given-name" required /></div>
          <div class="field"><label for="hf2-last">Last name</label><input id="hf2-last" name="lastName" autocomplete="family-name" required /></div>
        </div>
        <div class="form__row">
          <div class="field"><label for="hf2-email">Email</label><input id="hf2-email" name="email" type="email" autocomplete="email" required /></div>
          <div class="field"><label for="hf2-phone">Phone</label><input id="hf2-phone" name="phone" type="tel" autocomplete="tel" required pattern="[^0-9]*([0-9][^0-9]*){10,}" title="Please enter your phone number, including area code." /></div>
        </div>
        <div class="field"><label for="hf2-msg">Acres, animals, outbuildings, area (optional)</label><textarea id="hf2-msg" name="message" rows="3"></textarea></div>
        <button class="btn" type="submit">Send</button>
        <p class="form__status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="wrap faq">
      <div class="head"><p class="eyebrow">Quick answers</p><h2 id="faq-title">Buying a hobby farm in Minnesota</h2></div>
      {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      <p class="links"><a class="link-arrow" href="/land-for-sale">Land and lots for sale</a> <a class="link-arrow" href="/lake-homes">Minnesota lake homes</a> <a class="link-arrow" href="/new-construction">New construction</a></p>
    </div>
  </section>
</Base>

<style>
  .nhead { padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(2rem, 4vw, 3rem); background: var(--night); color: var(--on-dark); }
  .nhead h1 { font: 500 clamp(2.2rem, 5vw, 3.6rem)/1.05 var(--serif-display); color: #fff; }
  .nhead .eyebrow { color: var(--rose); }
  .nhead .lede { color: var(--on-dark); }
  .nhead .lede a { color: #fff; font-weight: 700; }
  .answer { max-width: 52rem; margin: .9rem 0 .4rem; color: #fff; font: 500 clamp(1.05rem, 2.2vw, 1.25rem)/1.5 var(--ui); }
  .hero-btns { display: flex; flex-wrap: wrap; gap: .65rem; margin-top: 1.25rem; }
  .head { margin-bottom: 1.25rem; }
  .two { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr)); gap: 2rem; }
  .two h2 { font: 500 1.6rem/1.2 var(--serif); margin-bottom: .6rem; }
  .table-scroll { overflow-x: auto; }
  table.data { width: 100%; border-collapse: collapse; font-size: .98rem; }
  table.data th, table.data td { padding: .55rem .7rem; border-bottom: 1px solid var(--line); text-align: left; }
  table.data .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .source { margin-top: 1rem; font-size: .9rem; color: var(--text-soft); }
  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  @media (max-width: 900px) { .split { grid-template-columns: 1fr; } }
  .split .prose a { color: #fff; font-weight: 700; }
  .faq { display: grid; gap: .75rem; max-width: 52rem; }
  .faq details { padding: 1rem 1.2rem; background: var(--paper); border: 1px solid var(--line); }
  .faq summary { cursor: pointer; font: 600 1.15rem/1.3 var(--serif); }
  .links { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; margin-top: 1rem; }
</style>
