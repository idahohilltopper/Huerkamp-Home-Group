---
// /zip-codes: every community in our guides with its main ZIP codes, A to Z, each linking to its own ZIP code page.
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { communities } from '../../data/areas';
import detailData from '../../data/community-details.json';
import zipTowns from '../../data/zip-towns.json';
import { site } from '../../data/site';

const D = detailData.communities as Record<string, { zips?: { zip: string; pctOfCityLand: number }[] }>;
const town = (z: string): string | undefined => (zipTowns.towns as Record<string, string>)[z];
const rows = communities.filter((c) => (D[c.slug]?.zips ?? []).length)
  .map((c) => ({ c, zips: [...D[c.slug].zips!].sort((a, b) => b.pctOfCityLand - a.pctOfCityLand).map((z) => z.zip) }))
  .sort((a, b) => a.c.name.localeCompare(b.c.name));
const lede = `The main ZIP codes for ${rows.length} Twin Cities-area cities, A to Z. Many suburbs share a ZIP code with a neighbor or carry a bigger city's post office name, so each city's page shows which is which.`;
---
<Base breadcrumbs={[{ name: 'ZIP codes', href: '/zip-codes' }]} title={`Twin Cities ZIP Codes by City (${rows.length} Cities) | ${site.name}`} description={lede}>
  <PageHero eyebrow="ZIP codes" title="Twin Cities ZIP codes by city" lede={lede} />
  <section class="section">
    <div class="wrap">
      <div class="table-scroll">
        <table class="data">
          <thead><tr><th scope="col">City</th><th scope="col">Main ZIP codes</th></tr></thead>
          <tbody>{rows.map(({ c, zips }) => <tr><th scope="row"><a href={`/zip-codes/${c.slug}-mn`}>{c.name}</a></th><td>{zips.map((z) => (town(z) && town(z) !== c.name ? `${z} (${town(z)})` : z)).join(', ')}</td></tr>)}</tbody>
        </table>
      </div>
      <p class="source">ZIP code areas covering at least 5% of each city, US Census Bureau 2020 ZCTA-to-place relationship file; post office name in parentheses when it isn't the city's own (<a href="https://www.geonames.org/">GeoNames</a>, CC BY 4.0).</p>
    </div>
  </section>
</Base>

<style>
  .source { margin-top: .9rem; font-size: .9rem; color: var(--text-soft); }
</style>
