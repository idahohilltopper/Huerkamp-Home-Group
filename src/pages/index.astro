---
// Home page, laid out after markzproperties.com with Huerkamp Home Group's own facts.
// Every number here has a source; homes-sold and sales-volume cards wait on Jason's figures.
import { homeSearchHref, mapSearchHref } from '../data/search';
import Base from '../layouts/Base.astro';
import AreaMap from '../components/AreaMap.astro';
import TeamPhoto from '../components/TeamPhoto.astro';
import PostCard from '../components/PostCard.astro';
import YlopoListings from '../components/YlopoListings.astro';
import VideoCard from '../components/VideoCard.astro';
import ShortsRow from '../components/ShortsRow.astro';
import { longVideos, shorts, channel } from '../data/youtube';
import { searchUrl, ylopoPlace } from '../data/ylopo';
import { getPosts } from '../data/blog';
import { site } from '../data/site';
import team from '../data/team.json';
import reviewData from '../data/reviews.json';
import { communities, communityGeoUrl, communityInfo, regions } from '../data/areas';

const google = reviewData.summary.google;
const latest = (await getPosts()).slice(0, 3);
const members = team.members;
const founders = members.filter((m) => m.name === 'Jason Huerkamp' || m.name === 'Brooke Huerkamp');

// Complete 5-star reviews short enough for a card; the first is the featured quote.
const fits = (r: any) => r.textComplete && r.rating === 5 && r.text.length >= 150 && r.text.length <= 380;
const pool = reviewData.reviews.filter(fits);
const featured = pool.find((r: any) => r.reviewer === 'Sam Brownell')!;
const cards = [
  ...pool.filter((r: any) => r.source === 'Google' && r !== featured).slice(0, 4),
  ...pool.filter((r: any) => r.source === 'Zillow').slice(0, 2),
];

const record = [
  { value: google.rating.toFixed(1), unit: '★', label: 'Google rating', note: `Across ${google.count} reviews from Twin Cities buyers and sellers.`, source: `Google Business Profile, ${google.asOf.slice(0, 7)}` },
  { value: '2002', label: 'Founded', note: 'Jason and Brooke Huerkamp joined forces and started the team.', source: 'Huerkamp Home Group' },
  { value: String(members.length), label: 'Agents and staff', note: 'Licensed REALTORS® plus listing, transaction and client-care staff.', source: 'Team roster' },
  { value: '15', unit: '+', label: 'Years as a Ramsey ELP', note: 'Recommended to Ramsey listeners as an Endorsed Local Provider.', source: 'Ramsey Endorsed Local Provider program' },
  { value: String(communities.length), label: 'Communities covered', note: 'Every city in the seven-county metro, plus southern Minnesota.', source: 'Community guides on this site' },
];

const regionCounts = regions.map((r) => ({ name: r, count: communities.filter((c) => c.region === r).length }));
const popular = ['minneapolis', 'saint-paul', 'burnsville', 'lakeville', 'eagan', 'apple-valley', 'edina', 'woodbury', 'prior-lake', 'northfield']
  .map((s) => communities.find((c) => c.slug === s)!).filter(Boolean);
// Live listings across the cities the team works most.
const marketPlaces = popular.map((c) => ylopoPlace(c.slug)).filter((w) => w.city);
const marketSearch = { locations: marketPlaces.map((w) => ({ city: w.city, state: 'MN' })) };

const faqs = [
  { q: 'How do I find out what my home is worth?', a: 'Request a free home valuation. One of our agents compares your home with recent sales nearby and sends you a price range you can plan around. There is no cost and no obligation to list with us.' },
  { q: 'Can you make a cash offer on my home?', a: 'Yes. If you want speed and certainty more than top dollar, ask about a cash offer: no repairs, no staging and no open houses. We will also show you what a traditional sale could bring so you can compare.' },
  { q: 'What does it mean that you are a Ramsey ELP?', a: 'We have been a Dave Ramsey Endorsed Local Provider for more than 15 years. Ramsey recommends us to listeners in the Twin Cities, and we work the way they expect: plain advice, no pressure and a plan that fits your budget.' },
  { q: 'Which areas do you serve?', a: 'Minneapolis, Saint Paul and every city in the seven-county Twin Cities metro, plus Northfield, Dundas, Faribault, Owatonna and Le Sueur. Our community guides cover each one.' },
  { q: 'Do you work with first-time buyers?', a: 'All the time. We walk you through pre-approval, showings, offers and closing, and we can introduce you to our lender partner, Ken Rife at Mutual of Omaha Mortgage.' },
];
const ld = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ],
});
---
<Base
  title="Huerkamp Home Group | Twin Cities Real Estate Team Since 2002"
  description={`Twin Cities real estate team since 2002: ${google.rating.toFixed(1)} stars across ${google.count} Google reviews, Dave Ramsey Endorsed Local Provider. Buy or sell in Minneapolis, Saint Paul and the metro.`}>
  <script slot="head" type="application/ld+json" set:html={ld} />

  <!-- Hero -->
  <section class="hero">
    <picture>
      <source type="image/webp" srcset="/hero/minneapolis-skyline-640.webp 640w, /hero/minneapolis-skyline-960.webp 960w, /hero/minneapolis-skyline-1280.webp 1280w, /hero/minneapolis-skyline-1920.webp 1920w, /hero/minneapolis-skyline-2560.webp 2560w" sizes="100vw" />
      <img class="hero__bg" src="/hero/minneapolis-skyline-1920.jpg" alt="" width="1920" height="1280" fetchpriority="high" />
    </picture>
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="eyebrow hero__eyebrow">Huerkamp Home Group<br />Minneapolis · Saint Paul · Twin Cities</p>
        <h1>Twin Cities real estate, <em>since&nbsp;2002.</em></h1>
        <p class="hero__lede">A family-led Keller Williams team of {members.length} agents and staff, rated {google.rating.toFixed(1)} stars across {google.count} Google reviews, and a Dave Ramsey Endorsed Local Provider for more than 15 years.</p>
        <blockquote class="hero__quote">
          <p>“They exceeded our expectations for sale price and service.”</p>
          <cite>{featured.reviewer}, Google review</cite>
        </blockquote>
        <div class="hero__ctas">
          <a class="btn" href="/sell#value">Get Your Home's Value</a>
          <a class="btn" href="/sell">Sell Your Home</a>
          <a class="btn" href={mapSearchHref} rel="noopener">Find a Home</a>
        </div>
        <dl class="hero__stats">
          <div><dt>{google.count} Google reviews</dt><dd><span class="star" aria-hidden="true">★</span> {google.rating.toFixed(1)} / 5</dd></div>
          <div><dt>Founded</dt><dd>2002</dd></div>
          <div><dt>Ramsey ELP</dt><dd>15+ years</dd></div>
        </dl>
      </div>
      <figure class="hero__people">
        <div class="hero__cutouts">
          {founders.map((m) => {
            const n = m.photo.split('/').pop()!.replace(/\.(png|jpg)$/, '');
            return (
              <picture class={`cut cut--${n.split('-')[0]}`}>
                <source type="image/webp" srcset={`/people/${n}-cutout-560.webp 560w, /people/${n}-cutout-900.webp 900w`} sizes="(max-width: 960px) 45vw, 22rem" />
                <img src={`/people/${n}-cutout-560.png`} alt={m.name} width="560" height="560" fetchpriority="high" />
              </picture>
            );
          })}
        </div>
        <figcaption><strong>Jason &amp; Brooke Huerkamp</strong><span>Founders · {site.brokerage}</span></figcaption>
      </figure>
    </div>
  </section>

  <!-- Red facts strip -->
  <div class="strip" aria-label="Huerkamp Home Group at a glance">
    <ul class="strip__track">
      {[0, 1].map((copy) => (
        <>
          {[`${google.rating.toFixed(1)}★ on Google · ${google.count} reviews`, 'Dave Ramsey Endorsed Local Provider · 15+ years', 'Serving the Twin Cities since 2002', `${members.length} agents and staff`, site.brokerage, `${communities.length} community guides`].map((t) => (
            <li aria-hidden={copy === 1 ? 'true' : undefined}>{t}</li>
          ))}
        </>
      ))}
    </ul>
  </div>

  <!-- The record -->
  <section class="section record" aria-labelledby="record-title">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">The record</p>
        <h2 id="record-title">Numbers you can <em>check.</em></h2>
        <p>Every figure below names its source.</p>
      </div>
      <div class="record__grid">
        {record.map((r) => (
          <article class="rcard">
            <p class="rcard__badge"><span aria-hidden="true">✓</span> Verified</p>
            <p class="rcard__value">{r.value}{r.unit && <sup>{r.unit}</sup>}</p>
            <h3>{r.label}</h3>
            <p class="rcard__note">{r.note}</p>
            <p class="rcard__source">Source · <strong>{r.source}</strong></p>
          </article>
        ))}
        <a class="rcard rcard--cta" href="/sell#value">
          <p class="rcard__badge">Your home next</p>
          <p class="rcard__cta">What is your home worth today?</p>
          <span class="link-arrow">Get your free valuation →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Featured listings: the team's own -->
  <section class="section section--paper" aria-labelledby="featured-title">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">Featured properties</p>
        <h2 id="featured-title">Homes we're proud <em>to represent.</em></h2>
        <p>Our team's current listings.</p>
      </div>
      <YlopoListings layout="scroll" search={{ featured: 't', limit: 24 }}
        moreHref={`${site.searchUrl}/search?s[featured]=t`} moreLabel="See every team listing" own={{ team: true }} />
    </div>
  </section>

  <!-- Where we work -->
  <section class="section" aria-labelledby="where-title">
    <div class="wrap where">
      <div class="where__copy">
        <p class="eyebrow">Where we work</p>
        <h2 id="where-title">Seven counties. {communities.length} communities. <em>Your backyard.</em></h2>
        <p>From Minneapolis and Saint Paul to the suburbs and southern Minnesota, every community has its own guide with local facts, schools and commute times.</p>
        <ul class="areas">
          {regionCounts.map((r) => <li><a href="/communities"><strong>{r.name}</strong><span>{r.count} {r.count === 1 ? 'community' : 'communities'}</span></a></li>)}
        </ul>
      </div>
      <div class="where__map">
        <AreaMap src={communityGeoUrl} info={communityInfo} label="Hover a community" height="520px" />
      </div>
    </div>
  </section>

  <!-- Homes for sale -->
  <section class="section section--paper" aria-labelledby="find-title">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">Homes for sale</p>
        <h2 id="find-title">Homes for sale <em>in our markets.</em></h2>
        <p>The newest listings in {popular.map((c) => c.name).join(', ')}, updated several times a day.</p>
      </div>
      <YlopoListings search={marketSearch}
        moreHref={searchUrl(marketPlaces)} moreLabel="Search all Twin Cities homes" />
      <a class="search-cta" href={homeSearchHref} rel="noopener">
        <span>City, neighborhood, ZIP or address</span>
        <strong>Search homes →</strong>
      </a>
      <p class="subhead">Popular places to look</p>
      <ul class="chips">
        {popular.map((c) => <li><a href={`/communities/${c.slug}`}>{c.name}</a></li>)}
        <li><a href="/lake-homes">Lake homes</a></li>
        <li><a href="/communities">All {communities.length} communities</a></li>
      </ul>
    </div>
  </section>

  <!-- Sell with confidence -->
  <section class="section" aria-labelledby="sell-title">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">Sell with confidence</p>
        <h2 id="sell-title">Three ways to <em>start your sale.</em></h2>
        <p>Pick the path that fits your timeline. We'll show you the numbers for each before you decide.</p>
      </div>
      <div class="programs">
        <article class="program">
          <p class="eyebrow">Start here</p>
          <h3>Free Home Valuation</h3>
          <p>An agent compares your home with recent sales nearby and sends you a price range you can plan around.</p>
          <a class="link-arrow" href="/sell#value">Get your value</a>
        </article>
        <article class="program">
          <p class="eyebrow">Skip the showings</p>
          <h3>Cash Offer</h3>
          <p>Sell your home fast and hassle-free. No repairs, no staging, no open houses. Just a fair, all-cash offer.</p>
          <a class="link-arrow" href="/sell#cash">How it works</a>
        </article>
        <article class="program">
          <p class="eyebrow">Top dollar</p>
          <h3>Full Marketing Plan</h3>
          <p>Professional photography, targeted online advertising and an agent who keeps you posted at every step.</p>
          <a class="link-arrow" href="/sell">See the plan</a>
        </article>
      </div>
    </div>
  </section>

  <!-- Marketing -->
  <section class="section section--dark" aria-labelledby="market-title">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">Marketing</p>
        <h2 id="market-title">Your listing isn't just posted. <em>It's marketed.</em></h2>
        <p>Buyers are on their phones and laptops, not reading bench ads. That's where we put your home.</p>
      </div>
      <ul class="pillars">
        <li><strong>Aggressive marketing and re-marketing</strong><span>across the entire digital landscape</span></li>
        <li><strong>Precise demographic targeting</strong><span>so your home reaches likely buyers</span></li>
        <li><strong>Proactive customer support</strong><span>from lead to closing, you're kept informed</span></li>
      </ul>
    </div>
  </section>

  <!-- Reviews -->
  <section class="section" id="reviews" aria-labelledby="reviews-title">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">Client stories</p>
        <h2 id="reviews-title">{google.rating.toFixed(1)} stars on Google across <em>{google.count} reviews.</em></h2>
        <p>Quoted word for word from Google and Zillow.</p>
      </div>
      <figure class="feature-quote">
        <blockquote>“{featured.text}”</blockquote>
        <figcaption><strong>{featured.reviewer}</strong> · Google review</figcaption>
      </figure>
      <div class="quotes">
        {cards.map((r: any) => (
          <figure class="quote">
            <p class="quote__stars" aria-label={`${r.rating} out of 5 stars`}>{'★'.repeat(r.rating)}</p>
            <blockquote>{r.text}</blockquote>
            <figcaption><strong>{r.reviewer}</strong><span>{r.source === 'Zillow' ? `Zillow review · worked with ${r.agent}` : 'Google review'}</span></figcaption>
          </figure>
        ))}
      </div>
      <p class="more"><a class="link-arrow" href={google.url} rel="noopener">Read all {google.count} reviews on Google</a></p>
    </div>
  </section>

  <!-- Team -->
  <section class="section section--paper" aria-labelledby="team-title">
    <div class="wrap team-teaser">
      <div class="head">
        <p class="eyebrow">Meet the team</p>
        <h2 id="team-title">{members.length} people. <em>One team.</em></h2>
        <p>Licensed agents and client-care staff at {site.brokerage} in Burnsville.</p>
        <a class="btn btn--dark" href="/team">Meet the whole team</a>
      </div>
      <ul class="faces">
        {members.slice(0, 12).map((m) => (
          <li><TeamPhoto photo={m.photo} alt={m.name} size={160} /><span>{m.name}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Ramsey -->
  <section class="section section--dark" aria-labelledby="ramsey-title">
    <div class="wrap ramsey">
      <div>
        <p class="eyebrow">Dave Ramsey Endorsed Local Provider</p>
        <h2 id="ramsey-title">Buy or sell <em>the Ramsey way.</em></h2>
      </div>
      <div class="ramsey__body">
        <p>We have been a Ramsey ELP for more than 15 years. Our agents follow the principles Ramsey listeners expect: plain advice, no pressure, and a plan that fits your budget.</p>
        <a class="btn" href="/ramsey">About the ELP program</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" aria-labelledby="faq-title">
    <div class="wrap faq-wrap">
      <div class="head">
        <p class="eyebrow">Questions</p>
        <h2 id="faq-title">What buyers and sellers <em>ask us first.</em></h2>
      </div>
      <div class="faq">
        {faqs.map((f, i) => <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </div>
    </div>
  </section>

  <!-- Videos -->
  <section class="section section--dark" aria-labelledby="videos-title">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">Living in Minneapolis on YouTube</p>
        <h2 id="videos-title">New videos <em>every week.</em></h2>
        <p>Jason and Brooke break down the Twin Cities housing market, suburbs and neighborhoods, {longVideos.length} videos and counting.</p>
      </div>
      <ul class="vgrid">{longVideos.slice(0, 3).map((v) => <li><VideoCard video={v} /></li>)}</ul>
      <div class="vshorts"><ShortsRow shorts={shorts.slice(0, 10)} /></div>
      <p class="vmore"><a class="btn" href="/videos">Watch all videos</a> <a class="btn btn--ghost" href={`${channel.url}?sub_confirmation=1`} rel="noopener">Subscribe</a></p>
    </div>
  </section>

  <!-- Blog -->
  <section class="section section--paper" aria-labelledby="blog-title">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">From the blog</p>
        <h2 id="blog-title">Advice for buyers, sellers <em>and homeowners.</em></h2>
      </div>
      <ul class="latest">{latest.map((p) => <li><PostCard post={p} /></li>)}</ul>
      <p class="latest__more"><a class="link-arrow" href="/blog">All articles</a></p>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--dark" aria-labelledby="cta-title">
    <div class="wrap cta">
      <div class="cta__copy">
        <p class="eyebrow">Ready to make a move?</p>
        <h2 id="cta-title">Let's talk about <em>your next home.</em></h2>
        <p>Buying, selling or both, tell us where you're headed and we'll match you with the right agent.</p>
        <a class="cta__phone" href={site.phoneHref}>{site.phone}</a>
        <p class="cta__addr">{site.street}, {site.cityStateZip}</p>
      </div>
      <form class="form" data-lead="home">
        <div class="form__row">
          <div class="field"><label for="h-first">First name</label><input id="h-first" name="firstName" autocomplete="given-name" required /></div>
          <div class="field"><label for="h-last">Last name</label><input id="h-last" name="lastName" autocomplete="family-name" required /></div>
        </div>
        <div class="form__row">
          <div class="field"><label for="h-email">Email</label><input id="h-email" name="email" type="email" autocomplete="email" required /></div>
          <div class="field"><label for="h-phone">Phone</label><input id="h-phone" name="phone" type="tel" autocomplete="tel" /></div>
        </div>
        <div class="field">
          <label for="h-goal">I want to</label>
          <select id="h-goal" name="goal"><option value="">Choose one</option><option>Sell my home</option><option>Buy a home</option><option>Buy and sell</option><option>Invest</option></select>
        </div>
        <button class="btn" type="submit">Request my free consultation</button>
        <p class="form__status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</Base>

<style>
  .vgrid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr)); gap: 2rem 1.5rem; }
  .section--dark .vgrid :global(h3 a) { color: #fff; }
  .section--dark .vgrid :global(.vcard__meta) { color: var(--on-dark-soft); }
  .vshorts { margin-top: 2.5rem; }
  .vmore { margin-top: 2rem; display: flex; flex-wrap: wrap; gap: .75rem; }
  .strip { background: var(--crimson); color: #fff; overflow: hidden; }
  .strip__track { list-style: none; margin: 0; padding: .85rem 0; display: flex; width: max-content; animation: strip 50s linear infinite; }
  .strip__track li { font: 700 .78rem/1 var(--ui); letter-spacing: .16em; text-transform: uppercase; white-space: nowrap; padding-inline: 2rem; position: relative; }
  .strip__track li::after { content: "★"; position: absolute; right: -.35rem; opacity: .7; }
  @keyframes strip { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .strip__track { animation: none; flex-wrap: wrap; width: auto; justify-content: center; } .strip__track li[aria-hidden] { display: none; } }
  .search-cta { margin-top: 2.5rem; }
  .latest { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); gap: 1.5rem; }
  .latest__more { margin-top: 2rem; }
  /* Hero */
  .hero { position: relative; overflow: hidden; background: var(--night-deep); color: #fff; padding-block: clamp(3.5rem, 7vw, 6rem) clamp(2.5rem, 5vw, 4rem); }
  .hero__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; }
  /* Shade behind the words on the left only; the skyline and its lights stay bright on the right. */
  .hero__shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(21,18,19,.8) 0%, rgba(21,18,19,.5) 42%, rgba(21,18,19,.1) 100%), linear-gradient(0deg, rgba(21,18,19,.7) 0%, transparent 28%); }
  @media (max-width: 960px) { .hero__shade { background: linear-gradient(180deg, rgba(21,18,19,.42) 0%, rgba(21,18,19,.68) 100%); } }
  .hero__grid { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(1.5rem, 3vw, 2.5rem); align-items: center; }
  @media (max-width: 960px) { .hero__grid { grid-template-columns: 1fr; } }
  .hero__copy { display: grid; gap: 1.4rem; justify-items: start; text-shadow: 0 1px 14px rgba(0, 0, 0, .5); }
  .hero__eyebrow { color: var(--rose); line-height: 1.7; }
  .hero h1 { font: 500 clamp(2.8rem, 6.4vw, 5.2rem)/1.02 var(--serif-display); letter-spacing: -.015em; max-width: 14ch; }
  .hero__lede { max-width: 36rem; font-size: 1.12rem; color: #e9e1da; }
  .hero__quote { margin: 0; display: grid; gap: .3rem; }
  .hero__quote p { font: italic 500 clamp(1.3rem, 2.2vw, 1.7rem)/1.3 var(--serif); }
  .hero__quote cite { font: 600 .75rem/1 var(--ui); letter-spacing: .14em; text-transform: uppercase; font-style: normal; color: var(--on-dark-soft); }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: .75rem; }
  .hero__stats { display: flex; flex-wrap: wrap; gap: 2.5rem; margin: .5rem 0 0; padding-top: 1.4rem; border-top: 1px solid rgba(255,255,255,.18); width: 100%; }
  .hero__stats div { display: flex; flex-direction: column-reverse; gap: .35rem; }
  .hero__stats dd { margin: 0; font: 500 1.7rem/1 var(--serif); }
  .hero__stats dt { font: 600 .7rem/1 var(--ui); letter-spacing: .16em; text-transform: uppercase; color: var(--on-dark-soft); }
  .star { color: #c99a2e; }
  .hero__people { position: relative; margin: 0; align-self: stretch; min-height: 34rem; margin-bottom: calc(-1 * clamp(2.5rem, 5vw, 4rem)); }
  .hero__cutouts { position: absolute; inset: 0; }
  .cut img { position: absolute; bottom: 0; width: auto; max-width: none;
    -webkit-mask-image: linear-gradient(to bottom, #000 78%, transparent 100%); mask-image: linear-gradient(to bottom, #000 78%, transparent 100%);
    filter: drop-shadow(0 20px 40px rgba(0,0,0,.45)); }
  /* Side by side with a small overlap so both faces stay clear; Jason a touch larger, standing behind. */
  /* Jason runs to the bottom of the banner like Brooke (his coat fills the space under him), sized so his
     head sits where it did when he stood higher, left of and above Brooke's. */
