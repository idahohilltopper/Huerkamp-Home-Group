---
import '../styles/global.css';
import team from '../data/team.json';
import reviewData from '../data/reviews.json';

const phone = '(612) 502-7653';
const phoneHref = 'tel:+16125027653';
const members = team.members;
const googleSummary = reviewData.summary.google;

// Home page shows a few complete 5-star reviews that fit a card without cutting text.
const fits = (r: any) => r.textComplete && r.rating === 5 && r.text.length >= 150 && r.text.length <= 420;
const featured = [
  ...reviewData.reviews.filter((r: any) => r.source === 'Google' && fits(r)).slice(0, 4),
  ...reviewData.reviews.filter((r: any) => r.source === 'Zillow' && fits(r)).slice(0, 2),
];

const initials = (name: string) =>
  name.split(/[\s-]+/).filter(Boolean).map((w) => w[0]).slice(0, 2).join('');

// Communities listed in the current site's navigation, plus the two core cities.
const communities = [
  'Minneapolis', 'Saint Paul', 'Apple Valley', 'Burnsville', 'Eagan', 'Farmington',
  'Inver Grove Heights', 'Lakeville', 'Mendota Heights', 'Northfield', 'Rosemount',
];

// Figures below come from docs/site-plan.md and the team page; confirm before launch.
const stats = [
  { value: '2002', label: 'Founded by Jason & Brooke Huerkamp' },
  { value: String(members.length), label: 'Agents and staff on the team' },
  { value: googleSummary.rating.toFixed(1), label: `Stars from ${googleSummary.count} Google reviews` },
  { value: '15+', label: 'Years as a Ramsey ELP' },
];

const paths = [
  { eyebrow: 'Buy', title: 'Find the right home', body: 'Search every NorthstarMLS listing, get pre-approved, and tour with an agent who knows the neighborhood.', cta: 'Start your search', href: '/buy' },
  { eyebrow: 'Sell', title: 'Sell for top dollar', body: 'Pricing backed by local data, professional photography and targeted marketing for your listing.', cta: 'What is my home worth?', href: '/sell' },
  { eyebrow: 'Invest', title: 'Build a portfolio', body: 'Rental and fix-and-flip guidance from a team with its own background in real estate investing.', cta: 'Talk investing', href: '/invest' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Huerkamp Home Group</title>
  <meta name="description" content="Huerkamp Home Group helps buyers and sellers across Minneapolis, St. Paul and the Twin Cities metro. Keller Williams Preferred Realty, Burnsville, MN." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600&family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;1,9..144,400&family=Mulish:wght@600;700&display=swap" />
</head>
<body>
  <header class="nav">
    <div class="nav__inner">
      <a class="brand" href="/" aria-label="Huerkamp Home Group home">
        <span class="brand__mark">HHG</span>
        <span class="brand__name">Huerkamp<br />Home Group</span>
      </a>
      <nav class="nav__links" aria-label="Main">
        <a href="/buy">Buy</a>
        <a href="/sell">Sell</a>
        <a href="/invest">Invest</a>
        <a href="#communities">Communities</a>
        <a href="#team">Team</a>
        <a href="/ramsey">Ramsey ELP</a>
      </nav>
      <a class="nav__phone" href={phoneHref}>{phone}</a>
      <a class="btn nav__cta" href="/contact">Contact</a>
    </div>
  </header>

  <main>
    <section class="hero">
      <img class="hero__photo" src="/hero/minneapolis-skyline-1920.jpg"
        srcset="/hero/minneapolis-skyline-1920.jpg 1920w, /hero/minneapolis-skyline-3840.jpg 3840w"
        sizes="100vw" alt="Downtown Minneapolis skyline at dusk, reflected in the Mississippi River" fetchpriority="high" />
      <div class="hero__shade" aria-hidden="true"></div>
      <div class="wrap hero__content">
        <p class="hero__kicker"><span>Huerkamp Home Group</span></p>
        <div class="hero__badges">
          <div class="badge"><strong>Est. 2002</strong><span>Twin Cities real estate team</span></div>
          <div class="badge"><strong>Ramsey</strong><span>Endorsed Local Provider</span></div>
        </div>
        <h1>Twin Cities Real Estate, From Minneapolis to St.&nbsp;Paul</h1>
        <p class="hero__lede">Helping buyers and sellers across Minneapolis, St. Paul, the 13-county metro and Western Wisconsin.</p>

        <form class="search" action="/search" method="get" role="search" data-pending="Home search launches with the NorthstarMLS feed in step 7.">
          <label class="visually-hidden" for="hero-search">City, neighborhood, ZIP or address</label>
          <input id="hero-search" name="q" type="search" placeholder="City, neighborhood, ZIP or address" autocomplete="off" />
          <button class="btn" type="submit">Search homes</button>
        </form>
        <p class="search__status" role="status" aria-live="polite"></p>

        <div class="split">
          <a class="split__card" href="/search">
            <span class="split__eyebrow">Buying</span>
            <span class="split__title">Search All Twin Cities Homes</span>
            <span class="split__sub">Minneapolis · St. Paul · South Metro · Western Wisconsin</span>
          </a>
          <a class="split__card" href="/sell">
            <span class="split__eyebrow">Selling</span>
            <span class="split__title">What Is My Home Worth?</span>
            <span class="split__sub">A free, local pricing report from our listing team</span>
          </a>
        </div>
      </div>
    </section>

    <section class="section section--dark stats" aria-labelledby="why-title">
      <div class="wrap">
        <div class="head">
          <p class="eyebrow">Why work with us</p>
          <h2 id="why-title">A Minnesota team since <em>2002.</em></h2>
        </div>
        <dl class="stats__grid">
          {stats.map((s) => (
            <div class="stat"><dt>{s.label}</dt><dd>{s.value}</dd></div>
          ))}
        </dl>
      </div>
    </section>

    <section class="section" aria-labelledby="paths-title">
      <div class="wrap">
        <div class="head">
          <p class="eyebrow">How we help</p>
          <h2 id="paths-title">Buy, sell or invest, <em>with a plan.</em></h2>
        </div>
        <div class="paths">
          {paths.map((p) => (
            <article class="path">
              <p class="eyebrow">{p.eyebrow}</p>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
              <a class="path__link" href={p.href}>{p.cta} <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--paper" id="communities" aria-labelledby="comm-title">
      <div class="wrap">
        <div class="head">
          <p class="eyebrow">Jump to a city</p>
          <h2 id="comm-title">Homes across the <em>Twin Cities.</em></h2>
          <p>Local guides and live listings for the cities our agents work in every week.</p>
        </div>
        <ul class="cities">
          {communities.map((c) => (
            <li><a href={`/communities/${c.toLowerCase().replace(/\s+/g, '-')}`}>{c}<span aria-hidden="true">→</span></a></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section" id="reviews" aria-labelledby="reviews-title">
      <div class="wrap">
        <div class="head">
          <p class="eyebrow">Client reviews</p>
          <h2 id="reviews-title">Trusted by <em>Minnesota families.</em></h2>
        </div>
        <div class="reviews">
          {featured.map((r: any) => (
            <figure class="review">
              <p class="review__stars" aria-label={`${r.rating} out of 5 stars`}>{'★'.repeat(r.rating)}</p>
              <blockquote>{r.text}</blockquote>
              <figcaption>
                <strong>{r.reviewer}</strong>
                <span>{r.source === 'Zillow' ? `Zillow review · worked with ${r.agent}` : 'Google review'}</span>
              </figcaption>
            </figure>
          ))}
        </div>
        <p class="reviews__summary">
          <a href={googleSummary.url}>{googleSummary.rating.toFixed(1)} stars from {googleSummary.count} reviews on Google</a>
        </p>
      </div>
    </section>

    <section class="section section--paper" id="team" aria-labelledby="team-title">
      <div class="wrap">
        <div class="head">
          <p class="eyebrow">Meet the team</p>
          <h2 id="team-title">{members.length} people, <em>one team.</em></h2>
          <p>Licensed agents and client care staff at Keller Williams Preferred Realty in Burnsville.</p>
        </div>
        <ul class="team">
          {members.map((m) => (
            <li class="agent">
              <div class="agent__photo">
                <span aria-hidden="true">{initials(m.name)}</span>
                {m.photo && <img src={m.photo} alt={m.name} loading="lazy" width="320" height="320" onerror="this.remove()" />}
              </div>
              <h3>{m.name}</h3>
              {m.title && <p class="agent__title">{m.title}</p>}
              <p class="agent__contact">{m.phone}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section section--dark ramsey" aria-labelledby="ramsey-title">
      <div class="wrap ramsey__inner">
        <div>
          <p class="eyebrow">Dave Ramsey Endorsed Local Provider</p>
          <h2 id="ramsey-title">Buy or sell the <em>Ramsey way.</em></h2>
        </div>
        <div class="ramsey__body">
          <p>We have been a Ramsey ELP for more than 15 years. Our agents follow the principles Ramsey listeners expect: plain advice, no pressure, and a plan that fits your budget.</p>
          <a class="btn" href="/ramsey">About the ELP program</a>
        </div>
      </div>
    </section>

    <section class="section cta" aria-labelledby="cta-title">
      <div class="wrap head">
        <h2 id="cta-title">Ready to make <em>your move?</em></h2>
        <p>Talk with a Huerkamp Home Group agent about buying or selling in the Twin Cities.</p>
        <a class="btn btn--dark" href={phoneHref}>Call {phone}</a>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap footer__inner">
      <div>
        <p class="footer__name">Huerkamp Home Group</p>
        <p>Keller Williams Preferred Realty</p>
      </div>
      <address>
        14300 Nicollet Ct, Ste 208<br />Burnsville, MN 55306<br />{phone}
      </address>
      <p class="footer__legal">Each office independently owned and operated. Equal Housing Opportunity.<br />
        Skyline photo: <a href="https://www.flickr.com/photos/diversey/15674738158/">Tony Webster</a>,
        <a href="https://creativecommons.org/licenses/by/2.0/">CC BY 2.0</a></p>
    </div>
  </footer>

  <script>
    // Home search is not live yet; show a note instead of loading a missing page.
    document.querySelectorAll<HTMLFormElement>('form[data-pending]').forEach((form) => {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const status = form.nextElementSibling;
        if (status) status.textContent = form.dataset.pending ?? '';
      });
    });
  </script>
</body>
</html>

<style>
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* Header */
  .nav { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 10; background: var(--espresso); color: var(--on-dark); }
  .nav__inner { max-width: 84rem; margin-inline: auto; padding: .85rem var(--gutter); display: flex; align-items: center; gap: 1.75rem; }
  .brand { display: flex; align-items: center; gap: .6rem; text-decoration: none; }
  .brand__mark { display: grid; place-items: center; width: 2.6rem; height: 2.6rem; border: 1px solid var(--gold); color: var(--gold); font: 500 .95rem/1 var(--serif); letter-spacing: .06em; }
  .brand__name { font: 500 .95rem/1.1 var(--serif-display); letter-spacing: .12em; text-transform: uppercase; }
  .nav__links { display: flex; gap: 1.6rem; margin-left: auto; }
  .nav__links a, .nav__phone { text-decoration: none; font-size: 1rem; color: var(--on-dark); }
  .nav__links a:hover, .nav__phone:hover { color: var(--gold); }
  .nav__cta { padding: .65rem 1.25rem; font-size: .85rem; }
  @media (max-width: 1060px) { .nav__links { display: none; } .nav__phone { margin-left: auto; } }
  @media (max-width: 520px) { .nav__phone { display: none; } .nav__cta { margin-left: auto; } }

  /* Hero */
  .hero { position: relative; overflow: hidden; color: #fff; background: var(--espresso-deep); padding-block: clamp(4rem, 9vw, 6.5rem) clamp(3rem, 6vw, 4.5rem); }
  .hero__photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 55% 70%; }
  .hero__shade { position: absolute; inset: 0; background:
      linear-gradient(180deg, rgba(26,20,16,.55) 0%, rgba(26,20,16,.35) 45%, rgba(26,20,16,.8) 100%); }
  .hero__content { position: relative; z-index: 1; display: grid; justify-items: center; text-align: center; gap: 1.5rem; }
  .hero__kicker { display: flex; align-items: center; gap: 1.25rem; font: 500 clamp(1rem, 2.4vw, 1.9rem)/1 var(--serif-display); letter-spacing: .3em; text-transform: uppercase; color: var(--gold); }
  .hero__kicker::before, .hero__kicker::after { content: ""; width: clamp(1.5rem, 5vw, 3.5rem); height: 1px; background: var(--gold); opacity: .7; }
  .hero__badges { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem; }
  .badge { display: grid; gap: .35rem; min-width: 13rem; padding: .8rem 1.4rem; border: 1px solid rgba(212,178,124,.55); border-radius: 4px; background: rgba(26,20,16,.35); }
  .badge strong { font: 400 1.9rem/1 var(--serif-display); color: var(--gold); }
  .badge span { font: 600 .72rem/1.2 var(--ui); letter-spacing: .14em; text-transform: uppercase; }
  .hero h1 { font: 400 clamp(2.5rem, 6.4vw, 5rem)/1.02 var(--serif-display); letter-spacing: -.015em; max-width: 24ch; text-shadow: 0 2px 24px rgba(0,0,0,.35); }
  .hero__lede { max-width: 36rem; font-size: 1.125rem; color: #eee5d7; }

  .search { display: flex; gap: .5rem; width: min(100%, 40rem); padding: .45rem; border-radius: 999px; background: rgba(255,255,255,.96); box-shadow: 0 12px 40px rgba(0,0,0,.3); }
  .search input { flex: 1; min-width: 0; border: 0; background: transparent; padding: .6rem 1rem; font: 500 1rem var(--sans); color: #1d1813; }
  .search input:focus { outline: none; }
  .search:focus-within { outline: 2px solid var(--gold); outline-offset: 3px; }
  .search__status { min-height: 1.4em; font-size: .95rem; color: var(--gold); }

  .split { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); width: min(100%, 65rem); border: 1px solid rgba(212,178,124,.35); border-radius: 12px; overflow: hidden; background: rgba(26,20,16,.72); backdrop-filter: blur(6px); }
  .split__card { display: grid; gap: .5rem; padding: 1.75rem 2rem; text-decoration: none; color: #fff; transition: background .2s; }
  .split__card + .split__card { border-left: 1px solid rgba(212,178,124,.35); }
  .split__card:hover { background: rgba(212,178,124,.12); }
  .split__eyebrow { font: 700 .72rem/1 var(--ui); letter-spacing: .22em; text-transform: uppercase; color: var(--gold); }
  .split__title { font: 400 clamp(1.5rem, 2.6vw, 2rem)/1.1 var(--serif-display); }
  .split__sub { font-size: .9rem; color: #cfc4b2; }
  @media (max-width: 700px) {
    .split { grid-template-columns: 1fr; }
    .split__card + .split__card { border-left: 0; border-top: 1px solid rgba(212,178,124,.35); }
    .search { flex-direction: column; border-radius: 16px; }
    .search .btn { justify-content: center; }
  }

  /* Stats */
  .stats__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.25rem; margin: 0; }
  .stat { display: flex; flex-direction: column-reverse; gap: .6rem; padding: 2rem 1rem; text-align: center; background: var(--espresso-raised); border: 1px solid rgba(212,178,124,.18); }
  .stat dd { margin: 0; font: 400 clamp(2.6rem, 5vw, 3.6rem)/1 var(--serif-display); color: #f0dfc2; font-variant-numeric: tabular-nums; }
  .stat dt { font: 600 .72rem/1.3 var(--ui); letter-spacing: .16em; text-transform: uppercase; color: var(--on-dark-soft); }
  @media (max-width: 800px) { .stats__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  /* Paths */
  .paths { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  .path { display: flex; flex-direction: column; gap: .85rem; padding: 2rem; background: var(--surface); border: 1px solid var(--line); }
  .path p:not(.eyebrow) { color: var(--text-soft); }
  .path__link { margin-top: auto; padding-top: .5rem; font: 700 .95rem/1 var(--ui); color: var(--eyebrow); text-decoration: none; }
  .path__link:hover { text-decoration: underline; }
  @media (max-width: 860px) { .paths { grid-template-columns: 1fr; } }

  /* Communities */
  .cities { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 0 2rem; }
  .cities a { display: flex; justify-content: space-between; align-items: baseline; padding: 1rem 0; border-bottom: 1px solid var(--line); text-decoration: none; font: 400 1.35rem/1.2 var(--serif); }
  .cities a span { color: var(--eyebrow); transition: transform .2s; }
  .cities a:hover span { transform: translateX(4px); }

  /* Reviews */
  .reviews { display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 1.5rem; }
  .review { margin: 0; padding: 2rem; background: var(--surface); border: 1px solid var(--line); display: grid; grid-template-rows: auto 1fr auto; gap: 1rem; }
  .review__stars { color: var(--gold); letter-spacing: .2em; }
  .review blockquote { margin: 0; font: italic 400 1.1rem/1.55 var(--serif); white-space: pre-line; }
  .review figcaption { font-size: .9rem; color: var(--text-soft); }
  .review figcaption { display: grid; gap: .15rem; }
  .review figcaption strong { color: var(--text); font-weight: 600; }
  .reviews__summary { margin-top: 2rem; text-align: center; font: 700 .95rem/1.4 var(--ui); }
  .reviews__summary a { color: var(--eyebrow); }

  /* Team */
  .team { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr)); gap: 2rem 1.5rem; }
  .agent { display: grid; gap: .3rem; text-align: center; }
  .agent__photo { position: relative; aspect-ratio: 1; max-width: 100%; margin-bottom: .6rem; overflow: hidden; background: var(--espresso); display: grid; place-items: center; }
  .agent__photo span { font: 400 2.6rem/1 var(--serif-display); color: var(--gold); letter-spacing: .04em; }
  .agent__photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .agent h3 { font-size: 1.1rem; }
  .agent__title { font: 600 .72rem/1.3 var(--ui); letter-spacing: .12em; text-transform: uppercase; color: var(--eyebrow); }
  .agent__contact { font-size: .92rem; color: var(--text-soft); font-variant-numeric: tabular-nums; }

  /* Ramsey */
  .ramsey__inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 2.5rem; align-items: center; }
  .ramsey__inner > div:first-child { display: grid; gap: 1rem; }
  .ramsey__body { display: grid; gap: 1.5rem; justify-items: start; color: var(--on-dark-soft); font-size: 1.1rem; }
  @media (max-width: 800px) { .ramsey__inner { grid-template-columns: 1fr; } }

  .cta .head { margin-bottom: 0; }

  /* Footer */
  .footer { background: var(--espresso-deep); color: var(--on-dark-soft); padding-block: 3rem; font-size: .95rem; }
  .footer__inner { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1.5rem; }
  .footer__name { font: 500 1.3rem/1.2 var(--serif); color: var(--on-dark); }
  .footer address { font-style: normal; }
  .footer__legal { font-size: .85rem; }
  .footer a { color: var(--on-dark); }
</style>
