---
// One Minneapolis neighborhood or Saint Paul planning district. Every number is sourced:
//   market: Minneapolis Area REALTORS® Local Market Update for the neighborhood (NorthstarMLS data), monthly
//   people and homes: US Census ACS 2020-2024 for the block groups mostly inside it (scripts/build-neighborhoods.py)
// Sentences only restate those numbers.
import Base from '../../../layouts/Base.astro';
import AreaMap from '../../../components/AreaMap.astro';
import LineChart from '../../../components/LineChart.astro';
import YlopoListings from '../../../components/YlopoListings.astro';
import VideoCard from '../../../components/VideoCard.astro';
import PostCard from '../../../components/PostCard.astro';
import HomesStrip from '../../../components/HomesStrip.astro';
import { pairsFor, other, compareHref } from '../../../data/compare';
import { listingsData, homesHref } from '../../../data/listings';
import {
  hoods, hoodKey, hoodHref, hoodByKey, hoodGroup, hoodSearchUrl, hoodWidgetSearch, hasYlopoHood, hoodInfo, hoodGeoUrl, hoodPattern, hoodSources, CITY_NAME, type Hood,
} from '../../../data/neighborhoods';
import { source, latest, asOf, marketFor, pastMonths, areaIn, hasMarket, history, monthLabel, money, moneyK, count, change, signed, SMALL_SAMPLE, type Metric, type AreaMarket } from '../../../data/market';
import { longVideos } from '../../../data/youtube';
import { getPosts } from '../../../data/blog';
import detailData from '../../../data/community-details.json';
import { business, origin } from '../../../data/schema';
import { site } from '../../../data/site';

export function getStaticPaths() {
  return hoods.map((h) => ({ params: { city: h.city, hood: h.slug }, props: { h } }));
}
const { h } = Astro.props as { h: Hood };
const pastFor = pastMonths.filter((x) => (areaIn(x, hoodKey(h))?.closedSales?.month[1] ?? 0) > 0).reverse();
const homesData = await listingsData;
const homes = homesData.collections.find((k) => k.path === `${h.city}/${h.slug}` && !k.facet);
const cityName = CITY_NAME[h.city];
const key = hoodKey(h);
const url = `${origin}${hoodHref(h)}`;
const ce = h.census;
const cityAcs = (detailData.communities as any)[h.city].acs;
const where = `${h.name}, ${cityName}`;

// Market report (when Minneapolis Area REALTORS® publishes one for this neighborhood).
const mk = hasMarket(key) ? marketFor(key) : undefined;
const cityMk = marketFor(h.city);
const month = monthLabel(latest);
const asOfText = new Date(asOf + 'T12:00:00').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const v = (k: keyof AreaMarket, p: 'month' | 'r12' = 'r12', i = 1, m = mk) => ((m?.[k] as Metric | undefined)?.[p][i] ?? null);
const small = mk && (v('closedSales', 'month') ?? 0) < SMALL_SAMPLE;
const prices = mk ? history(key, 'medianPrice').slice(-24) : [];
const sales = mk ? history(key, 'closedSales').slice(-24) : [];
const rows: [string, keyof AreaMarket, (n: number | null) => string][] = [
  ['Median sale price', 'medianPrice', money], ['Price per square foot', 'pricePerSqft', money], ['Closed sales', 'closedSales', count],
  ['New listings', 'newListings', count], ['Days on market', 'daysOnMarket', count],
  ['% of original list price received', 'pctOfList', (n) => (n == null ? '—' : `${n}%`)],
  ['Homes for sale (end of month)', 'inventory', count], ['Months of supply', 'monthsSupply', (n) => (n == null ? '—' : String(n))],
];

const pct = (n: number | null | undefined) => (n == null ? '—' : `${Math.round(n)}%`);
const dollars = (n: number | null | undefined, top = false) => (n == null ? '—' : `$${Math.round(n).toLocaleString('en-US')}${top ? '+' : ''}`);
const people = ce && [
  ['Residents', count(ce.population), count(cityAcs.population)],
  ['Households', count(ce.households), count(cityAcs.households)],
  ['Homes owned by the people living in them', pct(ce.ownerPct), pct(cityAcs.ownerOccupiedPct)],
  ['Median value of owner-occupied homes', dollars(ce.medianHomeValue, ce.medianHomeValueTop), dollars(cityAcs.medianHomeValue)],
  ['Median household income', dollars(ce.medianIncome, ce.medianIncomeTop), dollars(cityAcs.medianHouseholdIncome)],
  ['Adults 25+ with a bachelor\'s degree or higher', pct(ce.bachelorsPct), pct(cityAcs.bachelorsOrHigherPct)],
  ['Single-family detached homes', pct(ce.housing.singleFamily), pct(cityAcs.singleFamilyPct)],
  ['Workers who drive alone', pct(ce.commute.droveAlone), pct(cityAcs.droveAlonePct)],
  ['Workers who take transit', pct(ce.commute.transit), pct(cityAcs.publicTransitPct)],
  ['Workers who work from home', pct(ce.commute.fromHome), pct(cityAcs.workFromHomePct)],
] as [string, string, string][];
const housingMix = ce && [
  { label: 'Single-family detached', value: ce.housing.singleFamily ?? 0 },
  { label: 'Townhome, duplex, 3-4 units', value: ce.housing.townhomeDuplex ?? 0 },
  { label: 'Apartments, 5-49 units', value: ce.housing.smallApartment ?? 0 },
  { label: 'Large buildings, 50+ units', value: ce.housing.largeApartment ?? 0 },
];
const ages = ce && [
  { label: 'Under 18', value: ce.ages.under18 ?? 0 }, { label: '18 to 34', value: ce.ages['18to34'] ?? 0 },
  { label: '35 to 64', value: ce.ages['35to64'] ?? 0 }, { label: '65 and older', value: ce.ages['65plus'] ?? 0 },
];
const commuteMix = ce && [
  { label: 'Drive alone', value: ce.commute.droveAlone ?? 0 }, { label: 'Work from home', value: ce.commute.fromHome ?? 0 },
  { label: 'Transit', value: ce.commute.transit ?? 0 }, { label: 'Walk', value: ce.commute.walk ?? 0 }, { label: 'Bike', value: ce.commute.bike ?? 0 },
].sort((a, b) => b.value - a.value);

// Videos and stories that name the neighborhood.
const re = hoodPattern(h);
const videos = longVideos.filter((x) => re.test(x.title) || (x.slug && re.test(x.summary.join(' ')))).slice(0, 6);
const stories = (await getPosts()).filter((p) => re.test(p.data.title) || re.test(p.data.description)).slice(0, 6);
const neighbors = h.neighbors.map(hoodByKey).filter((x): x is Hood => !!x);

const summary = [
  mk && v('medianPrice') != null && `Over the 12 months through ${month}, the median sale price in ${h.name} was ${money(v('medianPrice'))}, ${change(v('medianPrice', 'r12', 2))} from the 12 months before, with ${count(v('closedSales'))} homes sold.`,
  mk && cityMk && v('medianPrice') != null && `${cityName} as a whole had a median sale price of ${money(v('medianPrice', 'r12', 1, cityMk))} over the same 12 months.`,
  ce && `About ${count(ce.population)} people live in ${h.name}, in roughly ${count(ce.households)} households; ${pct(ce.ownerPct)} of homes are owned by the people living in them${cityAcs.ownerOccupiedPct ? `, compared with ${pct(cityAcs.ownerOccupiedPct)} citywide` : ''}.`,
  ce?.builtBefore1940Pct != null && ce.builtBefore1940Pct >= 30 && `${pct(ce.builtBefore1940Pct)} of its homes were built before 1940.`,
  ce?.built2000onPct != null && ce.built2000onPct >= 30 && `${pct(ce.built2000onPct)} of its homes were built in 2000 or later.`,
].filter(Boolean) as string[];

const faq = [
  mk && v('medianPrice') != null && { q: `What is the median home price in ${where}?`, a: `${money(v('medianPrice'))} over the 12 months through ${month} (${change(v('medianPrice', 'r12', 2))} from a year earlier), from the Minneapolis Area REALTORS® Local Market Update for ${h.name} (NorthstarMLS data).` },
  mk && v('daysOnMarket') != null && { q: `How fast do homes sell in ${h.name}?`, a: `Homes that sold in the 12 months through ${month} spent ${count(v('daysOnMarket'))} days on market, and sellers received ${v('pctOfList') ?? '—'}% of their original list price.` },
  ce && { q: `What kinds of homes are in ${h.name}?`, a: `By Census estimates, ${pct(ce.housing.singleFamily)} of homes are single-family detached, ${pct(ce.housing.townhomeDuplex)} are townhomes, duplexes or small buildings of 3-4 units, and ${pct((ce.housing.smallApartment ?? 0) + (ce.housing.largeApartment ?? 0))} are in apartment buildings of 5 or more units. ${pct(ce.ownerPct)} are owner-occupied.` },
  ce && ce.commute.droveAlone != null && { q: `How do people in ${h.name} get to work?`, a: `${pct(ce.commute.droveAlone)} drive alone, ${pct(ce.commute.fromHome)} work from home, ${pct(ce.commute.transit)} take transit, ${pct(ce.commute.walk)} walk and ${pct(ce.commute.bike)} bike (Census estimates).` },
].filter(Boolean) as { q: string; a: string }[];

const description = summary.slice(0, 2).join(' ').slice(0, 155).replace(/\s+\S*$/, '') + '…';
const ld = JSON.stringify([
  {
    '@context': 'https://schema.org', '@type': 'Place', '@id': `${url}#place`, name: `${h.name}, ${cityName}, Minnesota`, url,
    geo: { '@type': 'GeoCoordinates', latitude: h.center[1], longitude: h.center[0] },
    containedInPlace: { '@type': 'City', name: `${cityName}, Minnesota`, url: `${origin}/communities/${h.city}` },
  },
  ...(faq.length ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : []),
  ...(mk ? [{
    '@context': 'https://schema.org', '@type': 'Dataset', name: `${where} housing market, ${month}`, url: `${url}#market`, dateModified: asOf,
    description: `Monthly and 12-month home sales, prices, days on market and inventory for ${where}.`,
    spatialCoverage: { '@type': 'Place', name: `${where}, Minnesota` }, creator: { '@type': 'Organization', name: source.publisher },
    publisher: { '@id': business['@id'] }, isBasedOn: mk.url, citation: `${source.name}, ${h.name}, ${month}. Data from ${source.data}.`,
  }] : []),
]);
---
<Base
  breadcrumbs={[{ name: 'Communities', href: '/communities' }, { name: cityName, href: `/communities/${h.city}` }, { name: h.name, href: hoodHref(h) }]}
  title={`${h.name}, ${cityName} Homes & Neighborhood Guide | ${site.name}`}
  description={description}>
  <script slot="head" type="application/ld+json" set:html={ld} />

  <section class="nhead">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/communities">Communities</a><span aria-hidden="true">/</span><a href={`/communities/${h.city}`}>{cityName}</a><span aria-hidden="true">/</span><span>{h.name}</span></nav>
      <h1>{h.name}<span>, {cityName}</span></h1>
      <p class="lede">{h.community
        ? `A Minneapolis neighborhood in the city's ${h.community} community, ${count(h.acres)} acres.`
        : `Saint Paul's Planning District ${h.district}, ${count(h.acres)} acres, represented by the ${h.councilName}.`}</p>
      <ul class="kpis">
        <li><span>Median sale price</span><strong>{mk ? moneyK(v('medianPrice')) : '—'}</strong><em>{mk ? `past 12 months, ${signed(v('medianPrice', 'r12', 2))}` : 'no market report'}</em></li>
        <li><span>Homes sold</span><strong>{mk ? count(v('closedSales')) : '—'}</strong><em>past 12 months</em></li>
        <li><span>Homeowners</span><strong>{ce ? pct(ce.ownerPct) : '—'}</strong><em>of occupied homes</em></li>
        <li><span>Residents</span><strong>{ce ? count(ce.population) : '—'}</strong><em>Census estimate</em></li>
      </ul>
      <div class="actions">
        <a class="btn" href={hoodSearchUrl(h)} rel="noopener">{h.name} homes for sale</a>
        <a class="btn btn--ghost" href="#contact">Talk to a {cityName} agent</a>
      </div>
    </div>
  </section>

  {summary.length > 0 && (
    <section class="section" aria-labelledby="sum-title">
      <div class="wrap split">
        <div class="prose">
          <p class="eyebrow">The short version</p>
          <h2 id="sum-title">Living in {h.name}</h2>
          {summary.map((s) => <p>{s}</p>)}
          <p><a class="link-arrow" href={`/communities/${h.city}`}>{cityName} community guide</a></p>
        </div>
        <AreaMap src={hoodGeoUrl} info={hoodInfo(h.city)} mode="focus" focus={key} label={`Hover a ${cityName} neighborhood`} height="420px" />
      </div>
    </section>
  )}

  {(homes || hasYlopoHood(h)) && (
    <section class="section section--paper" id="listings" aria-labelledby="listings-title">
      <div class="wrap">
        <div class="head"><p class="eyebrow">Homes for sale</p><h2 id="listings-title">Homes for sale in {h.name}</h2></div>
        {homes ? <HomesStrip listings={homes.listings} allHref={homesHref(homes.path)} allLabel={`See all ${homes.listings.length} ${h.name} homes for sale`} collections={homesData.collections} area={homes.path} at={homesData.at} /> : <YlopoListings search={hoodWidgetSearch(h)} layout="scroll" moreHref={hoodSearchUrl(h)} moreLabel={`See every ${h.name} listing`} />}
      </div>
    </section>
  )}

  {mk && (
    <section class="section" id="market" aria-labelledby="market-title">
      <div class="wrap">
        <div class="head">
          <p class="eyebrow">Housing market · {month}</p>
          <h2 id="market-title">{h.name} home prices and sales</h2>
          {small && <p class="warn">Only {count(v('closedSales', 'month'))} {v('closedSales', 'month') === 1 ? 'home' : 'homes'} sold here in {month}, so single months swing a lot. The 12-month figures are steadier.</p>}
        </div>
        <div class="charts">
          {prices.length > 3 && <LineChart points={prices.map((p) => ({ label: monthLabel(p.month, true), value: p.value, display: money(p.value) }))} title={`Median sale price by month, ${h.name}`} valueName="Median price" caption="Single months can swing when few homes sell." />}
          {sales.length > 3 && <LineChart points={sales.map((p) => ({ label: monthLabel(p.month, true), value: p.value, display: count(p.value) }))} title={`Homes sold by month, ${h.name}`} valueName="Closed sales" />}
        </div>
        <div class="table-scroll">
          <table class="data">
            <thead>
              <tr><th scope="col"></th><th scope="col" colspan="3">{month}</th><th scope="col" colspan="3">12 months through {month}</th><th scope="col">{cityName}</th></tr>
              <tr><th scope="col">Measure</th><th scope="col" class="num">Year before</th><th scope="col" class="num">This year</th><th scope="col" class="num">Change</th><th scope="col" class="num">Year before</th><th scope="col" class="num">This year</th><th scope="col" class="num">Change</th><th scope="col" class="num">12 months</th></tr>
            </thead>
            <tbody>
              {rows.map(([label, k, f]) => (
                <tr><th scope="row">{label}</th>
                  <td class="num">{f(v(k, 'month', 0))}</td><td class="num">{f(v(k, 'month', 1))}</td><td class="num">{signed(v(k, 'month', 2))}</td>
                  <td class="num">{f(v(k, 'r12', 0))}</td><td class="num">{f(v(k, 'r12', 1))}</td><td class="num">{signed(v(k, 'r12', 2))}</td>
                  <td class="num">{f(k === 'inventory' || k === 'monthsSupply' ? v(k, 'month', 1, cityMk) : v(k, 'r12', 1, cityMk))}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="source">Source: <a href={mk.url} rel="noopener">{source.name}, {h.name}, {month}</a>. Data from {source.data}; current as of {asOfText}. {source.note} <a href={`/market/${h.city}`}>{cityName} market report</a></p>
        {pastFor.length > 0 && <p class="compare">Past months: {pastFor.map((x, i) => <>{i > 0 && ' · '}<a href={`/market/${key}/${x}`}>{monthLabel(x)}</a></>)}</p>}
      </div>
    </section>
  )}

  {ce && (
    <section class="section section--paper" aria-labelledby="people-title">
      <div class="wrap">
        <div class="head"><p class="eyebrow">People and homes</p><h2 id="people-title">{h.name} by the numbers</h2>
          <p>US Census Bureau estimates for the {h.blockGroups} block {h.blockGroups === 1 ? 'group' : 'groups'} mostly inside {h.name}, compared with all of {cityName}.</p></div>
        <div class="people">
          <div class="table-scroll">
            <table class="data">
              <thead><tr><th scope="col"></th><th scope="col" class="num">{h.name}</th><th scope="col" class="num">{cityName}</th></tr></thead>
              <tbody>{people!.map(([label, a, b]) => <tr><th scope="row">{label}</th><td class="num">{a}</td><td class="num">{b}</td></tr>)}</tbody>
            </table>
          </div>
          <div class="mixes">
            {[{ t: 'Types of homes', rows: housingMix! }, { t: 'Ages', rows: ages! }, { t: 'Getting to work', rows: commuteMix! }].map((g) => (
              <figure class="mix"><figcaption>{g.t}</figcaption>
                <ol>{g.rows.map((r) => <li><span>{r.label}</span><span class="bar" aria-hidden="true"><i style={`width:${r.value}%`}></i></span><b>{r.value}%</b></li>)}</ol>
              </figure>
            ))}
          </div>
        </div>
        <p class="source">Source: US Census Bureau, American Community Survey 2020–2024 5-year estimates for block groups (each block group counted in the neighborhood holding most of its area; medians estimated from ranges). Boundaries: {hoodSources.boundaries}. Block-group estimates have wide margins of error, so treat them as approximate.</p>
      </div>
    </section>
  )}

  {videos.length > 0 && (
    <section class="section" aria-labelledby="videos-title">
      <div class="wrap">
        <div class="head"><p class="eyebrow">Living in Minneapolis on YouTube</p><h2 id="videos-title">Watch: <em>{h.name}</em></h2></div>
        <ul class="grid">{videos.map((x) => <li><VideoCard video={x} /></li>)}</ul>
      </div>
    </section>
  )}

  {stories.length > 0 && (
    <section class="section section--paper" aria-labelledby="stories-title">
      <div class="wrap">
        <div class="head"><p class="eyebrow">Local stories</p><h2 id="stories-title">Reading about {h.name}</h2></div>
        <ul class="grid">{stories.map((p) => <li><PostCard post={p} /></li>)}</ul>
      </div>
    </section>
  )}

  {faq.length > 0 && (
    <section class="section" aria-labelledby="faq-title">
      <div class="wrap faq">
        <div class="head"><p class="eyebrow">Quick answers</p><h2 id="faq-title">{h.name} questions</h2></div>
        {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </div>
    </section>
  )}

  <section class="section section--dark" id="contact" aria-labelledby="contact-title">
    <div class="wrap contact">
      <div class="prose">
        <p class="eyebrow">Buying or selling in {h.name}?</p>
        <h2 id="contact-title">Talk with a {cityName} <em>neighborhood expert.</em></h2>
        <p>Ask us about specific blocks, recent sales nearby or what your home would sell for. There's no cost and no pressure.</p>
        <p><a href={site.phoneHref}>{site.phone}</a></p>
      </div>
      <form class="form" data-lead="community-contact">
        <h3>Ask about {h.name}</h3>
        <div class="form__row">
          <div class="field"><label for="n-first">First name</label><input id="n-first" name="firstName" autocomplete="given-name" required /></div>
          <div class="field"><label for="n-last">Last name</label><input id="n-last" name="lastName" autocomplete="family-name" required /></div>
        </div>
        <div class="form__row">
          <div class="field"><label for="n-email">Email</label><input id="n-email" name="email" type="email" autocomplete="email" required /></div>
          <div class="field"><label for="n-phone">Phone</label><input id="n-phone" name="phone" type="tel" autocomplete="tel" /></div>
        </div>
        <div class="field">
          <label for="n-goal">I want to</label>
          <select id="n-goal" name="goal"><option value="">Choose one</option><option>Buy in {h.name}</option><option>Sell in {h.name}</option><option>Buy and sell</option></select>
        </div>
        <div class="field"><label for="n-msg">Anything else?</label><textarea id="n-msg" name="message"></textarea></div>
        <input type="hidden" name="community" value={where} />
        <button class="btn" type="submit">Send</button>
        <p class="form__status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="near-title">
    <div class="wrap">
      <div class="head"><p class="eyebrow">Next door</p><h2 id="near-title">Neighborhoods around {h.name}</h2></div>
      <ul class="near">
        {neighbors.map((x) => <li><a href={hoodHref(x)}><strong>{x.name}</strong><span>{x.city !== h.city ? `${CITY_NAME[x.city]} · ` : ''}{hasMarket(hoodKey(x)) ? `${moneyK(marketFor(hoodKey(x))?.medianPrice?.r12[1])} median sale` : hoodGroup(x)}</span></a></li>)}
      </ul>
      {pairsFor(hoodKey(h)).length > 0 && (
        <p class="compare">Compare side by side: {pairsFor(hoodKey(h)).map((p, i) => <>{i > 0 && ' · '}<a href={compareHref(p)}>{h.name} vs. {other(p, hoodKey(h)).short}</a></>)}</p>
      )}
      <p class="more"><a class="link-arrow" href={`/communities/${h.city}#neighborhoods`}>All {cityName} neighborhoods</a></p>
    </div>
  </section>
</Base>

<style>
  .nhead { padding-block: clamp(2rem, 5vw, 3.5rem); background: var(--night); color: #fff; }
  .nhead .wrap { display: grid; gap: .9rem; }
  .crumbs { display: flex; flex-wrap: wrap; gap: .5rem; font: 700 .72rem/1.3 var(--ui); letter-spacing: .14em; text-transform: uppercase; color: var(--on-dark); }
  .crumbs a { color: var(--rose); text-decoration: none; }
  .nhead h1 { font: 500 clamp(2.4rem, 5.5vw, 4rem)/1.05 var(--serif-display); }
  .nhead h1 span { color: var(--on-dark); font-size: .6em; }
  .lede { color: var(--on-dark); max-width: 46rem; }
  .kpis { list-style: none; margin: .5rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; background: rgba(255,255,255,.14); }
  @media (max-width: 760px) { .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .kpis li { display: grid; gap: .3rem; padding: 1.1rem 1.2rem; background: var(--night); }
  .kpis span { font: 700 .7rem/1.2 var(--ui); letter-spacing: .12em; text-transform: uppercase; color: var(--rose); }
  .kpis strong { font: 500 clamp(1.8rem, 4vw, 2.6rem)/1 var(--serif-display); }
  .kpis em { font-style: normal; font-size: .85rem; color: var(--on-dark); }
  .actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: .5rem; }
  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  @media (max-width: 900px) { .split { grid-template-columns: 1fr; } }
  .prose p:not(.eyebrow) { font-size: 1.05rem; line-height: 1.7; }
  .warn { padding: .9rem 1rem; background: var(--sand); border-left: 4px solid var(--crimson); font-size: .95rem; margin-top: .75rem; }
  .charts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; margin-bottom: 2rem; }
  @media (max-width: 900px) { .charts { grid-template-columns: 1fr; } }
  .table-scroll { position: relative; overflow-x: auto; }
  .data { width: 100%; border-collapse: collapse; font-size: .95rem; background: var(--paper); }
  .data th, .data td { padding: .55rem .75rem; border-bottom: 1px solid var(--line); text-align: left; white-space: nowrap; }
  .data thead th { font: 700 .72rem/1.3 var(--ui); letter-spacing: .1em; text-transform: uppercase; color: var(--text-soft); }
