---
// Community page, modeled section by section on nevadarealestategroup.com's city pages.
// Every figure comes from src/data (Census, TIGER, OSRM); MLS-based figures show a
// pending state until the NorthstarMLS feed is connected (build step 7).
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import AreaMap from '../../components/AreaMap.astro';
import LineChart from '../../components/LineChart.astro';
import BarList from '../../components/BarList.astro';
import { communities, communityGeo, communityInfo, lakes, fmt, type Community } from '../../data/areas';
import detailData from '../../data/community-details.json';
import reviewData from '../../data/reviews.json';
import team from '../../data/team.json';
import { site } from '../../data/site';

export function getStaticPaths() {
  return communities.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props as { c: Community };
const d = (detailData.communities as any)[c.slug];
const a = d.acs;
const county = (detailData.baselines.counties as any)[d.primaryCounty.fips];
const mn = detailData.baselines.minnesota;
const dests = detailData.driveDestinations as Record<string, string>;
const bySlug = Object.fromEntries(communities.map((x) => [x.slug, x]));

// ---------- formatting ----------
const money = (n: number | null) => (n == null ? '—' : `$${fmt(Math.round(n))}`);
const moneyK = (n: number | null) => (n == null ? '—' : `$${fmt(Math.round(n / 1000))}K`);
const pctS = (n: number | null) => (n == null ? '—' : `${n}%`);
const vs = (city: number | null, other: number | null, higher = 'higher', lower = 'lower') => {
  if (city == null || other == null) return '';
  const diff = Math.round((100 * (city - other)) / other);
  return Math.abs(diff) < 2 ? 'about the same as' : `${Math.abs(diff)}% ${diff > 0 ? higher : lower} than`;
};
const list = (items: string[]) => items.length < 2 ? items.join('') : `${items.slice(0, -1).join(', ')} and ${items.at(-1)}`;
const countyName = `${d.primaryCounty.name} County`;
const regionPhrase = c.region === 'Minneapolis & Saint Paul' ? "one of the Twin Cities' two core cities" : `a ${c.region.toLowerCase()} city`;
const distancePhrase = c.slug === 'minneapolis' ? `downtown Saint Paul is about ${d.driveMinutes.downtownSaintPaul} minutes away`
  : c.slug === 'saint-paul' ? `downtown Minneapolis is about ${d.driveMinutes.downtownMinneapolis} minutes away`
  : `it's about ${d.driveMinutes.downtownMinneapolis} minutes from downtown Minneapolis and ${d.driveMinutes.downtownSaintPaul} minutes from downtown Saint Paul`;
const updated = new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

// ---------- derived content ----------
const mainDistrict = d.schoolDistricts[0];
const cityLakes = lakes.filter((l) => l.shorelineCities.includes(c.censusName));
const nearest = Object.entries(d.driveMinutesToCommunities as Record<string, number>)
  .sort((x, y) => x[1] - y[1]).slice(0, 4)
  .map(([slug, min]) => ({ ...bySlug[slug], min, value: (detailData.communities as any)[slug].acs.medianHomeValue }));
const compareSet = [
  { name: c.name, acs: a, pop: c.population2024, growth: c.growthPct, drive: d.driveMinutes.downtownMinneapolis, href: '' },
  ...nearest.slice(0, 3).map((n) => {
    const nd = (detailData.communities as any)[n.slug];
    return { name: n.name, acs: nd.acs, pop: n.population2024, growth: n.growthPct, drive: nd.driveMinutes.downtownMinneapolis, href: `/communities/${n.slug}` };
  }),
];
const years = Object.entries(c.populationByYear).map(([y, v]) => ({ label: y, value: v as number, display: fmt(v as number) }));
const industries = a.industries.slice(0, 6).map((i: any) => ({ label: i.name, value: i.pct, display: `${i.pct}%` }));
const growthWord = c.growthPct > 0.5 ? 'grew' : c.growthPct < -0.5 ? 'shrank' : 'held steady';

const nameRe = new RegExp(`\\b(${[c.name, c.censusName].map((n) => n.replace('.', '\\.')).join('|')})\\b`, 'i');
const cityReviews = reviewData.reviews.filter((r: any) => r.textComplete && r.rating === 5 && nameRe.test(r.text)).slice(0, 3);
const jason = team.members.find((m) => m.name === 'Jason Huerkamp')!;
const googleSummary = reviewData.summary.google;

const takeaways = [
  `Population: ${fmt(c.population2024)} (Census 2024 estimate; ${c.growthPct > 0 ? '+' : ''}${c.growthPct}% since 2020)`,
  `Median home value: ${money(a.medianHomeValue)}, ${vs(a.medianHomeValue, county.medianHomeValue)} the ${countyName} median (owner estimates, Census ACS)`,
  `Median household income: ${money(a.medianHouseholdIncome)}, ${vs(a.medianHouseholdIncome, county.medianHouseholdIncome)} ${countyName}`,
  `Homeownership: ${pctS(a.ownerOccupiedPct)} of households own their home (Minnesota: ${pctS(mn.ownerOccupiedPct)})`,
  `Getting around: about ${d.driveMinutes.downtownMinneapolis} minutes to downtown Minneapolis and ${d.driveMinutes.mspAirport} minutes to MSP Airport in light traffic`,
  ...(mainDistrict ? [`Schools: ${mainDistrict.name} covers about ${mainDistrict.pctOfCity}% of the city`] : []),
];

const faqs = [
  { q: `What is the median home value in ${c.name}?`,
    a: `The Census Bureau's 2020–2024 American Community Survey puts the median value of owner-occupied homes in ${c.name} at ${money(a.medianHomeValue)}, ${vs(a.medianHomeValue, county.medianHomeValue)} the ${countyName} median of ${money(county.medianHomeValue)}. These are owner estimates; current list prices come from the MLS and will appear on this page once our listing feed is connected.` },
  { q: `How many people live in ${c.name}, MN?`,
    a: `About ${fmt(c.population2024)} people, according to the Census Bureau's 2024 estimate. The city ${growthWord} ${c.growthPct === 0 ? '' : `by ${Math.abs(c.growthPct)}% `}between 2020 and 2024.` },
  { q: `Which school district serves ${c.name}?`,
    a: d.schoolDistricts.length
      ? `${list(d.schoolDistricts.map((s: any) => `${s.name} (about ${s.pctOfCity}% of the city)`))}. School assignment depends on the exact address, so confirm it with the district before you buy.`
      : `Confirm the school district for the exact address with the Minnesota Department of Education.` },
  { q: `How far is ${c.name} from downtown Minneapolis?`,
    a: `About ${d.driveMinutes.downtownMinneapolis} minutes by car in light traffic, and about ${d.driveMinutes.downtownSaintPaul} minutes to downtown Saint Paul. Residents' average one-way commute is ${a.meanCommuteMinutes} minutes (Census ACS).` },
  { q: `Is ${c.name} a good place to live?`,
    a: `It depends on what you need. ${c.name} has a median household income of ${money(a.medianHouseholdIncome)}, ${pctS(a.ownerOccupiedPct)} homeownership and a ${a.meanCommuteMinutes}-minute average commute. Visit at the times you'd normally drive, check the school assignment for the address, and compare total ownership costs before you decide.` },
  { q: `What does it cost to rent in ${c.name}?`,
    a: `The median gross rent (rent plus utilities) is ${money(a.medianGrossRent)} a month, compared with ${money(county.medianGrossRent)} in ${countyName} (Census ACS 2020–2024).` },
  { q: `What ZIP codes are in ${c.name}?`,
    a: `${list(d.zips.map((z: any) => z.zip))}${d.zips.length ? '' : 'See the ZIP code table above'} cover most of the city. ZIP code areas and city limits don't match exactly, so check the city on the property record.` },
  ...(d.lakes.length ? [{ q: `What lakes are in ${c.name}?`,
    a: `The largest named lakes inside the city are ${list(d.lakes.slice(0, 4).map((l: any) => `${l.name} (about ${fmt(l.acresInCity)} acres)`))}, based on Census water maps.` }] : []),
  { q: `How long does it take to close on a home in ${c.name}?`,
    a: `Most financed purchases close about 30 to 45 days after an accepted offer, and cash purchases can close sooner. Your lender, the appraisal and the title company set the actual timeline.` },
];
const faqLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});

const priceBands = ['Under $300K', '$300K – $450K', '$450K – $650K', '$650K – $1M', 'Over $1M'];
const browse = ['Single-family homes', 'Townhomes', 'Condos', 'New construction', 'Lake homes', 'One-level living', 'Under $400K', 'Luxury', 'Open houses', 'Price reduced'];
const pending = `Thanks! Online forms are still being connected. For now, call ${site.phone} or email ${site.email}.`;
const priceDefault = a.medianHomeValue ? Math.round(a.medianHomeValue / 1000) * 1000 : 400000;
---
<Base
  title={`${c.name}, MN Real Estate & Homes for Sale | Huerkamp Home Group`}
  description={`${c.name}, Minnesota real estate guide: homes for sale, median home values, schools, commute times, ZIP codes and neighborhoods near ${c.name}, from Huerkamp Home Group.`}>
  <script type="application/ld+json" set:html={faqLd} />

  <PageHero eyebrow={`${c.name}, Minnesota`} title={`${c.name} Real Estate`}
    lede={`Homes for sale, local facts and advice for buying or selling in ${c.name}, ${countyName}, from Huerkamp Home Group.`}>
    <p class="hero-meta">Updated {updated} · By {jason.name}, {jason.title}</p>
    <div class="hero-actions">
      <a class="btn" href="#listings">Browse {c.name} homes</a>
      <a class="btn btn--ghost" href="#contact">Talk to an expert</a>
    </div>
  </PageHero>

  <!-- 1. Key takeaways -->
  <section class="section section--paper" aria-labelledby="glance-title">
    <div class="wrap narrow">
      <p class="eyebrow">Key takeaways</p>
      <h2 id="glance-title">What should you know about <em>{c.name} at a glance?</em></h2>
      <p class="lede">{c.name} is {regionPhrase} in {countyName}, home to {fmt(c.population2024)} people. Here's what the public numbers say.</p>
      <ul class="takeaways">{takeaways.map((t) => <li>{t}</li>)}</ul>
      <p class="source">Sources: US Census Bureau 2024 population estimates and 2020–2024 American Community Survey; drive times from OpenStreetMap routing.</p>
    </div>
  </section>

  <!-- 2. Homes for sale (MLS) -->
  <section class="section" id="listings" aria-labelledby="listings-title">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">For sale now</p>
        <h2 id="listings-title">Where can I find <em>{c.name} homes for sale?</em></h2>
        <p>The newest {c.name} listings, with photos, prices and monthly payment estimates, appear here once our NorthstarMLS feed is connected.</p>
      </div>
      <div class="mls-pending" role="note"><strong>Live listings coming soon.</strong> Until then, <a href="#alerts">sign up for alerts</a> or <a href={site.phoneHref}>call {site.phone}</a> and we'll send you every new {c.name} listing.</div>

      <h3 class="subhead">How many {c.name} homes are for sale in each price range?</h3>
      <div class="bands">
        {priceBands.map((b) => <div class="band"><span>{b}</span><strong>—</strong><span>active listings</span></div>)}
      </div>

      <h3 class="subhead">Find a {c.name} home by type, lifestyle and price</h3>
      <ul class="chips">{browse.map((b) => <li><span class="chip" aria-disabled="true">{b}</span></li>)}</ul>
      <p class="source">Counts and search links go live with the MLS feed.</p>
    </div>
  </section>

  <!-- 3. Listing alerts -->
  <section class="section section--dark" id="alerts" aria-labelledby="alerts-title">
    <div class="wrap split-2">
      <div class="prose">
        <p class="eyebrow">Stay ahead of the market</p>
        <h2 id="alerts-title">How can you get new {c.name} <em>listings first?</em></h2>
        <p>Tell us your price range and we'll email new {c.name} listings that match. No spam, and you can unsubscribe anytime.</p>
        <ul class="ticks"><li>Pick your price, beds and home type</li><li>New listings emailed as they come on the market</li><li>Questions answered by a local agent</li></ul>
      </div>
      <form class="form" data-pending={pending}>
        <div class="form__row">
          <div class="field"><label for="al-first">First name</label><input id="al-first" name="firstName" autocomplete="given-name" required /></div>
          <div class="field"><label for="al-last">Last name</label><input id="al-last" name="lastName" autocomplete="family-name" /></div>
        </div>
        <div class="form__row">
          <div class="field"><label for="al-email">Email</label><input id="al-email" name="email" type="email" autocomplete="email" required /></div>
          <div class="field"><label for="al-phone">Phone</label><input id="al-phone" name="phone" type="tel" autocomplete="tel" /></div>
        </div>
        <div class="field">
          <label for="al-price">Max price</label>
          <select id="al-price" name="maxPrice"><option value="">Any</option>{priceBands.map((b) => <option>{b}</option>)}</select>
        </div>
        <input type="hidden" name="community" value={c.name} />
        <button class="btn" type="submit">Create my alert</button>
        <p class="form__status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <!-- 4. Living in: answer, map, at a glance -->
  <section class="section section--paper" aria-labelledby="living-title">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">Living in</p>
        <h2 id="living-title">What's it like living in <em>{c.name}, MN?</em></h2>
      </div>
      <div class="answer">
        <p class="eyebrow">The answer</p>
        <p>{c.name} is {regionPhrase}, and {distancePhrase} in light traffic. {a.singleFamilyPct}% of its homes are single-family houses, the typical home was built around {a.medianYearBuilt}, and {pctS(a.ownerOccupiedPct)} of households own their home.</p>
      </div>
      <div class="tiles">
        {Object.entries(d.driveMinutes as Record<string, number>).map(([k, m]) => (
          <div class="tile"><span>{dests[k]}</span><strong>{m}</strong><span>min</span></div>
        ))}
      </div>
      <div class="glance-grid">
        <AreaMap geojson={communityGeo} info={communityInfo} mode="focus" focus={c.slug} label="Hover a community" height="560px" />
        <aside class="glance" aria-labelledby="glance-panel">
          <h3 id="glance-panel">{c.name} <span>at a glance</span></h3>
          <div class="glance__market">
            <div><strong>—</strong><span>Median list price</span></div>
            <div><strong>—</strong><span>Active listings</span></div>
            <div><strong>—</strong><span>Price / sq ft</span></div>
            <div><strong>—</strong><span>Days on market</span></div>
          </div>
          <p class="glance__note">Market figures appear when MLS data is connected.</p>
          <dl class="glance__facts">
            <div><dt>Population (2024)</dt><dd>{fmt(c.population2024)}</dd></div>
            <div><dt>Median home value</dt><dd>{money(a.medianHomeValue)}</dd></div>
            <div><dt>Median household income</dt><dd>{money(a.medianHouseholdIncome)}</dd></div>
            <div><dt>Median age</dt><dd>{a.medianAge}</dd></div>
            <div><dt>County</dt><dd>{c.counties.join(', ')}</dd></div>
            <div><dt>Land area</dt><dd>{c.landSqMi} sq mi</dd></div>
            <div><dt>Water area</dt><dd>{c.waterSqMi} sq mi</dd></div>
            {mainDistrict && <div><dt>Main school district</dt><dd>{mainDistrict.name}</dd></div>}
          </dl>
          <p class="source">Census 2024 estimates, ACS 2020–2024 and 2024 boundaries. Drive times: OpenStreetMap routing, light traffic.</p>
        </aside>
      </div>
    </div>
  </section>

  <!-- 5. Who lives here -->
  <section class="section" aria-labelledby="who-title">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">Demographics · {c.name}, MN</p>
        <h2 id="who-title">Who lives in <em>{c.name}?</em></h2>
        <p>According to the Census Bureau, {c.name}'s median household income of {money(a.medianHouseholdIncome)} is {vs(a.medianHouseholdIncome, county.medianHouseholdIncome)} the {countyName} median of {money(county.medianHouseholdIncome)}. The median age is {a.medianAge}, {pctS(a.ownerOccupiedPct)} of households own their home and {pctS(a.bachelorsOrHigherPct)} of adults hold a bachelor's degree or higher.</p>
      </div>
      <div class="stats">
        {[
          ['Population', fmt(c.population2024), `${fmt(Math.round(a.households))} households`],
          ['Median household income', money(a.medianHouseholdIncome), `${d.primaryCounty.name} Co. ${money(county.medianHouseholdIncome)} · MN ${money(mn.medianHouseholdIncome)}`],
          ['Median home value', money(a.medianHomeValue), `${d.primaryCounty.name} Co. ${money(county.medianHomeValue)} · MN ${money(mn.medianHomeValue)}`],
          ['Median gross rent', money(a.medianGrossRent), `${d.primaryCounty.name} Co. ${money(county.medianGrossRent)} · MN ${money(mn.medianGrossRent)}`],
          ['Homeowners', pctS(a.ownerOccupiedPct), `${d.primaryCounty.name} Co. ${pctS(county.ownerOccupiedPct)} · MN ${pctS(mn.ownerOccupiedPct)}`],
          ["Bachelor's degree or higher", pctS(a.bachelorsOrHigherPct), `${d.primaryCounty.name} Co. ${pctS(county.bachelorsOrHigherPct)} · MN ${pctS(mn.bachelorsOrHigherPct)}`],
          ['Median age', String(a.medianAge), `${d.primaryCounty.name} Co. ${county.medianAge} · MN ${mn.medianAge}`],
          ['Single-family homes', pctS(a.singleFamilyPct), `Median year built: ${a.medianYearBuilt}`],
        ].map(([label, value, note]) => (
          <div class="stat"><span class="stat__label">{label}</span><strong>{value}</strong><span class="stat__note">{note}</span></div>
        ))}
      </div>
      <p class="source">US Census Bureau, American Community Survey 2020–2024 5-year estimates; population from 2024 estimates. Home values are owner estimates.</p>
    </div>
  </section>

  <!-- 6. Growth -->
  <section class="section section--paper" aria-labelledby="growth-title">
    <div class="wrap split-2">
      <div class="prose">
        <p class="eyebrow">Population trend</p>
        <h2 id="growth-title">How fast is <em>{c.name} growing?</em></h2>
        <p>{c.name}'s population {growthWord}{c.growthPct === 0 ? '' : ` ${Math.abs(c.growthPct)}%`} between 2020 and 2024, from {fmt(c.population2020)} to {fmt(c.population2024)} residents, according to Census Bureau estimates.</p>
      </div>
      <LineChart points={years} title={`${c.name} population, 2020–2024`} valueName="Residents" caption="US Census Bureau Vintage 2024 population estimates." />
    </div>
  </section>

  <!-- 7. Schools and 8. crime -->
  <section class="section" aria-labelledby="schools-title">
    <div class="wrap split-2">
      <div class="prose">
        <p class="eyebrow">School planning</p>
        <h2 id="schools-title">Which schools serve a <em>{c.name} address?</em></h2>
        {d.schoolDistricts.length > 0 && (
          <ul class="districts">{d.schoolDistricts.map((s: any) => <li><strong>{s.name}</strong><span>about {s.pctOfCity}% of the city</span></li>)}</ul>
        )}
        <p>Ask the district for the school assignment of the exact address for the year you'll enroll, since boundaries can change. Being near a school doesn't guarantee a spot, and charter and private schools set their own rules.</p>
        <p><a href="https://rc.education.mn.gov/">Minnesota Report Card (Department of Education)</a></p>
        <p class="source">District coverage: US Census Bureau 2024 school district boundaries.</p>
      </div>
      <div class="prose">
        <p class="eyebrow">Crime data</p>
        <h3>How can you check reported crime near a home?</h3>
        <p>Ask the police department that serves the address for its current reports, and compare places only across the same time period and offense definitions. Missing data doesn't mean zero crime, and a citywide number doesn't describe a particular street.</p>
        <p><a href="https://cde.ucr.cjis.gov/">FBI Crime Data Explorer</a></p>
      </div>
    </div>
  </section>

  <!-- 9. ZIP codes -->
  {d.zips.length > 0 && (
    <section class="section section--paper" aria-labelledby="zip-title">
      <div class="wrap">
        <div class="head">
          <p class="eyebrow">By ZIP code</p>
          <h2 id="zip-title">What does {c.name} look like <em>by ZIP code?</em></h2>
          <p>{d.zips.length === 1 ? `ZIP ${d.zips[0].zip} covers most of ${c.name}.` : `${d.zips.length} ZIP codes cover most of ${c.name}.`} Median list prices and days on market by ZIP will be added from the MLS.</p>
        </div>
        <div class="table-scroll">
          <table class="data">
            <thead><tr><th scope="col">ZIP</th><th scope="col" class="num">Share of city</th><th scope="col" class="num">Median home value</th><th scope="col" class="num">Median household income</th><th scope="col" class="num">Homeowners</th><th scope="col" class="num">Median list price</th><th scope="col" class="num">Days on market</th></tr></thead>
            <tbody>
              {d.zips.map((z: any) => (
                <tr><th scope="row">{z.zip}</th><td class="num">{z.pctOfCityLand}%</td><td class="num">{money(z.medianHomeValue)}</td><td class="num">{money(z.medianHouseholdIncome)}</td><td class="num">{pctS(z.ownerOccupiedPct)}</td><td class="num muted">MLS</td><td class="num muted">MLS</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="source">ZIP code areas (ZCTAs) covering at least 5% of the city; values for the whole ZIP area, Census ACS 2020–2024.</p>
      </div>
    </section>
  )}

  <!-- 10. Outdoors: lakes -->
  <section class="section section--dark" aria-labelledby="outdoors-title">
    <div class="wrap split-2">
      <div class="prose">
        <p class="eyebrow">Outdoor living</p>
        <h2 id="outdoors-title">What lakes and water are in <em>{c.name}?</em></h2>
        <p>{c.waterSqMi >= 0.5 ? `${c.name} has about ${c.waterSqMi} square miles of water inside city limits.` : `${c.name} has little open water inside city limits, but lakes and regional parks are a short drive away.`}{cityLakes.length ? ` It borders ${list(cityLakes.map((l) => l.name))}, one of the lakes on our Lake Homes page.` : ''}</p>
        {cityLakes.length > 0 && <p><a class="btn" href="/lake-homes">See lake homes</a></p>}
      </div>
      {d.lakes.length > 0 ? (
        <ul class="lakes-list">
          {d.lakes.map((l: any) => <li><span>{l.name}</span><strong>{fmt(l.acresInCity)} acres</strong></li>)}
        </ul>
      ) : <p class="prose">No named lakes of 10 acres or more lie inside the city on Census maps.</p>}
    </div>
  </section>

  <!-- 11. Getting around -->
  <section class="section" aria-labelledby="commute-title">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">Commute & transportation</p>
        <h2 id="commute-title">How easy is getting around <em>{c.name}?</em></h2>
        <p>{c.name} residents' average one-way commute is {a.meanCommuteMinutes} minutes (Census ACS). {pctS(a.droveAlonePct)} drive alone, {pctS(a.publicTransitPct)} take public transit and {pctS(a.workFromHomePct)} work from home.</p>
      </div>
      <div class="stats stats--4">
        <div class="stat"><span class="stat__label">Average commute</span><strong>{a.meanCommuteMinutes} min</strong><span class="stat__note">MN average {mn.meanCommuteMinutes} min</span></div>
        <div class="stat"><span class="stat__label">Drive alone</span><strong>{pctS(a.droveAlonePct)}</strong><span class="stat__note">of workers</span></div>
        <div class="stat"><span class="stat__label">Public transit</span><strong>{pctS(a.publicTransitPct)}</strong><span class="stat__note">of workers</span></div>
        <div class="stat"><span class="stat__label">Work from home</span><strong>{pctS(a.workFromHomePct)}</strong><span class="stat__note">of workers</span></div>
      </div>
      <h3 class="subhead">Drive times from {c.name}</h3>
      <ul class="drives">
        {Object.entries(d.driveMinutes as Record<string, number>).map(([k, m]) => <li><strong>{m} min</strong><span>{dests[k]}</span></li>)}
      </ul>
      <p class="source">Drive times: OSRM routing on OpenStreetMap data from the city's Census center point, light traffic. Rush hour takes longer.</p>
    </div>
