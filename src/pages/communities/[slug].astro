<script>
  // Monthly payment illustration: principal & interest plus the costs the visitor enters.
  const form = document.getElementById('calc') as HTMLFormElement | null;
  if (form) {
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
    const out = document.getElementById('calc-out')!;
    const usd = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
    const update = () => {
      const price = +$('calc-price').value || 0;
      const down = Math.min(Math.max(+$('calc-down').value || 0, 0), 100);
      const rate = parseFloat($('calc-rate').value);
      const years = +$('calc-term').value;
      const tax = (+$('calc-tax').value || 0) / 12;
      const ins = (+$('calc-ins').value || 0) / 12;
      const hoa = +$('calc-hoa').value || 0;
      const loan = price * (1 - down / 100);
      if (!(rate >= 0) || !$('calc-rate').value) { out.textContent = 'Enter an interest rate to see a monthly estimate.'; return; }
      const r = rate / 100 / 12, n = years * 12;
      const pi = r === 0 ? loan / n : (loan * r) / (1 - Math.pow(1 + r, -n));
      const total = pi + tax + ins + hoa;
      out.innerHTML = `<strong>${usd(total)} / month</strong><span>Principal &amp; interest ${usd(pi)} · Taxes ${usd(tax)} · Insurance ${usd(ins)} · HOA ${usd(hoa)}</span><span>Loan amount ${usd(loan)}. Mortgage insurance may apply below 20% down.</span>`;
    };
    form.addEventListener('input', update);
    form.addEventListener('submit', (e) => e.preventDefault());
    update();
  }
</script>

