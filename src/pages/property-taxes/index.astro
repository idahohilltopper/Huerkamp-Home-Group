---
// /property-taxes: the metro counties' property taxes side by side, each linking to its own page.
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import taxData from '../../data/property-tax.json';
import { COUNTIES, countyHref } from '../../data/counties';
import { site } from '../../data/site';

type Row = { medianTax: number; medianValue: number; rate: number };
const T = taxData as unknown as { counties: Record<string, Row>; stateMedianTax: number; stateRate: number };
const fmt = (n: number) => `$${Math.round(n).toLocaleString('en-US')}`;
const rows = COUNTIES.map((k) => ({ k, ...T.counties[k.fips] })).sort((a, b) => b.medianTax - a.medianTax);
const lede = `Minnesota homeowners pay a median ${fmt(T.stateMedianTax)} a year in property taxes, about ${T.stateRate.toFixed(2)}% of the median home value; in the Twin Cities counties it runs from ${Math.min(...rows.map((r) => r.rate)).toFixed(2)}% to ${Math.max(...rows.map((r) => r.rate)).toFixed(2)}%. Taxes are due May 15 and October 15. Here is each county's rate and where to look up or pay your bill.`;
---
<Base breadcrumbs={[{ name: 'Property taxes', href: '/property-taxes' }]} title={`Minnesota Property Tax Rates by County (Twin Cities) & Due Dates | ${site.name}`} description={lede}>
  <PageHero eyebrow="Property taxes" title="Minnesota property tax rates by county" lede={lede} />
  <section class="section">
    <div class="wrap">
      <div class="table-scroll">
        <table class="data">
          <thead><tr><th scope="col">County</th><th scope="col" class="num">Median tax a year</th><th scope="col" class="num">Median home value</th><th scope="col" class="num">Tax as % of value</th></tr></thead>
          <tbody>{rows.map((r) => <tr><th scope="row"><a href={countyHref(r.k)}>{r.k.name} County</a></th><td class="num">{fmt(r.medianTax)}</td><td class="num">{fmt(r.medianValue)}</td><td class="num">{r.rate.toFixed(2)}%</td></tr>)}</tbody>
        </table>
      </div>
      <p>Homeowners can get part of their property tax back: see the <a href="/property-taxes/minnesota-property-tax-refund">Minnesota property tax refund</a> (Form M1PR, due August 15). Just bought? <a href="/property-taxes/minnesota-homestead">Apply for homestead</a> by December 31 to lower next year's taxes.</p>
      <p class="source">Owner-occupied homes; US Census Bureau, American Community Survey 2020–2024 (5-year). Statewide median: {fmt(T.stateMedianTax)} a year. Due dates: Minnesota Department of Revenue.</p>
    </div>
  </section>
</Base>

<style>
  .source { margin-top: .8rem; font-size: .9rem; color: var(--text-soft); }
</style>
