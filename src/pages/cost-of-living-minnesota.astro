---
// Cost of living in Minnesota and the Twin Cities: housing (sale prices, rent, a mortgage payment at today's rate),
// property tax, and state income and sales tax. Costs only, every figure with its source; no incomes or anything
// about who lives where (fair housing).
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { communities } from '../data/areas';
import { marketFor, hasMarket, REGION, latest, monthLabel, source as mSource } from '../data/market';
import details from '../data/community-details.json';
import tax from '../data/property-tax.json';
import rates from '../data/rates.json';
import { business, origin } from '../data/schema';
import { site } from '../data/site';

const money = (n: number | null | undefined) => (n == null ? '—' : `$${Math.round(n).toLocaleString('en-US')}`);
const month = monthLabel(latest);
const metro = marketFor(REGION)!;
const metroPrice = metro.medianPrice!.r12[1]!;
const mn = (details as any).baselines.minnesota, us = (details as any).baselines.unitedStates;
const acs = (slug: string) => (details as any).communities[slug]?.acs;
const rate30 = rates.latest.rate30;
// Principal and interest on a 30-year loan with 10% down at Freddie Mac's latest average rate.
const pAndI = (price: number) => { const r = rate30 / 100 / 12, n = 360, loan = price * 0.9; return (loan * r) / (1 - (1 + r) ** -n); };
const metroPayment = pAndI(metroPrice);
const taxCity = (slug: string) => (tax as any).cities[slug] as { medianTax: number; rate: number } | undefined;
const rows = communities.filter((c) => hasMarket(c.slug)).map((c) => ({
  c, price: marketFor(c.slug)!.medianPrice!.r12[1]!, rent: acs(c.slug)?.medianGrossRent ?? null, taxRate: taxCity(c.slug)?.rate ?? null,
})).filter((r) => r.price).sort((a, b) => a.price - b.price);
const mpls = rows.find((r) => r.c.slug === 'minneapolis'), stp = rows.find((r) => r.c.slug === 'saint-paul');
const answer = `Housing is the biggest cost: the median Twin Cities home sold for ${money(metroPrice)} over the 12 months through ${month}, which works out to about ${money(metroPayment)} a month in principal and interest with 10% down at today's ${rate30}% average rate, before property taxes and insurance. Minnesota's median rent is ${money(mn.medianGrossRent)} a month with utilities, compared with ${money(us.medianGrossRent)} nationally. State sales tax is 6.875% and income tax runs from 5.35% to 9.85%.`;
const faq = [
  { q: 'Is Minnesota expensive to live in?', a: `Housing in Minnesota costs close to the national middle: the median owner-occupied home value is ${money(mn.medianHomeValue)} in Minnesota against ${money(us.medianHomeValue)} nationally, and median rent is ${money(mn.medianGrossRent)} against ${money(us.medianGrossRent)} (Census ACS 2020–2024). Taxes are on the higher side: income tax from 5.35% to 9.85% and a 6.875% state sales tax, plus local sales taxes in some cities.` },
  { q: 'How much do you need to buy a home in the Twin Cities?', a: `At the ${money(metroPrice)} metro median sale price (12 months through ${month}), 10% down is ${money(metroPrice * 0.1)}, and principal and interest at ${rate30}% is about ${money(metroPayment)} a month, plus property taxes, insurance and any HOA dues. Prices vary a lot by city; see the table on this page.` },
  ...(mpls && stp ? [{ q: 'What does a home cost in Minneapolis and Saint Paul?', a: `Over the 12 months through ${month}, the median sale price was ${money(mpls.price)} in Minneapolis and ${money(stp.price)} in Saint Paul (Minneapolis Area REALTORS®). Median rent with utilities is ${money(mpls.rent)} in Minneapolis and ${money(stp.rent)} in Saint Paul (Census ACS 2020–2024).` }] : []),
  { q: 'What are Minnesota’s income tax rates in 2026?', a: 'For 2026, Minnesota taxes income at 5.35%, 6.80%, 7.85% and 9.85%. For a single filer, the brackets break at $33,310, $109,430 and $203,150; for married couples filing jointly, at $48,700, $193,480 and $337,930 (Minnesota Department of Revenue).' },
  { q: 'What is the sales tax in Minnesota?', a: 'The state general sales tax is 6.875%. Many cities and counties add a local sales tax on top; the Minnesota Department of Revenue publishes the combined rate for each place.' },
];
const ld = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
const SOURCES = [
  { name: `${mSource.name} (sale prices), ${month}`, url: mSource.url },
  { name: 'US Census Bureau, American Community Survey 2020–2024 (home values, rent with utilities, property taxes paid)', url: 'https://data.census.gov/' },
  { name: `Freddie Mac Primary Mortgage Market Survey, ${rates.latest.date} (30-year average rate)`, url: 'https://www.freddiemac.com/pmms' },
  { name: 'Minnesota Department of Revenue, 2026 income tax rates and brackets', url: 'https://www.revenue.state.mn.us/minnesota-income-tax-rates-and-brackets' },
  { name: 'Minnesota Department of Revenue, sales tax (6.875% state rate) and local rate guide', url: 'https://www.revenue.state.mn.us/guide/taxes-and-rates' },
];
---
<Base breadcrumbs={[{ name: 'Buy', href: '/buy' }, { name: 'Cost of living in Minnesota', href: '/cost-of-living-minnesota' }]}
  title={`Cost of Living in Minnesota & the Twin Cities (2026) | ${site.name}`}
  description={answer.slice(0, 300)}>
  <script slot="head" type="application/ld+json" set:html={ld} />
  <PageHero eyebrow="Moving to Minnesota" title="Cost of living in Minnesota and the Twin Cities" lede={answer} />

  <section class="section">
    <div class="wrap">
      <div class="head"><p class="eyebrow">At a glance</p><h2>Minnesota compared with the U.S.</h2></div>
      <div class="table-scroll">
        <table class="data">
          <thead><tr><th scope="col">Cost</th><th scope="col" class="num">Minnesota</th><th scope="col" class="num">United States</th></tr></thead>
          <tbody>
            <tr><th scope="row">Median home value (owner estimate)</th><td class="num">{money(mn.medianHomeValue)}</td><td class="num">{money(us.medianHomeValue)}</td></tr>
            <tr><th scope="row">Median rent, with utilities</th><td class="num">{money(mn.medianGrossRent)}/mo</td><td class="num">{money(us.medianGrossRent)}/mo</td></tr>
            <tr><th scope="row">Median property tax paid (owners)</th><td class="num">{money((tax as any).stateMedianTax)}/yr</td><td class="num">—</td></tr>
            <tr><th scope="row">State sales tax</th><td class="num">6.875% + local</td><td class="num">varies by state</td></tr>
            <tr><th scope="row">State income tax (2026)</th><td class="num">5.35% to 9.85%</td><td class="num">varies by state</td></tr>
          </tbody>
        </table>
      </div>
      <p class="source">Home value, rent and property tax: Census ACS 2020–2024. Taxes: Minnesota Department of Revenue.</p>
    </div>
  </section>

  <section class="section section--paper">
    <div class="wrap">
      <div class="head"><p class="eyebrow">By city</p><h2>Housing costs across the Twin Cities</h2>
        <p>Median sale price over the 12 months through {month}, the monthly principal and interest on that price with 10% down at {rate30}%, median rent and the property tax rate, from the least to the most expensive.</p></div>
      <div class="table-scroll">
        <table class="data">
          <thead><tr><th scope="col">City</th><th scope="col" class="num">Median sale price</th><th scope="col" class="num">P&amp;I per month</th><th scope="col" class="num">Median rent</th><th scope="col" class="num">Property tax rate</th></tr></thead>
          <tbody>{rows.map((r) => <tr><th scope="row"><a href={`/market/${r.c.slug}`}>{r.c.name}</a></th><td class="num">{money(r.price)}</td><td class="num">{money(pAndI(r.price))}</td><td class="num">{r.rent ? money(r.rent) : '—'}</td><td class="num">{r.taxRate != null ? `${r.taxRate}%` : '—'}</td></tr>)}</tbody>
        </table>
      </div>
      <p class="source">Sale prices: {mSource.name}. Rent (with utilities): Census ACS 2020–2024. Property tax rate: median taxes paid ÷ median home value, Census ACS 2020–2024. Payment: principal and interest only, 30-year loan, 10% down, Freddie Mac average rate of {rate30}% ({rates.latest.date}).</p>
      <p class="links"><a class="link-arrow" href="/calculators/affordability">How much house can I afford?</a> <a class="link-arrow" href="/calculators/rent-vs-buy">Rent vs. buy calculator</a> <a class="link-arrow" href="/first-time-home-buyer-minnesota">First-time buyer programs</a> <a class="link-arrow" href="/commute">Commute times</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="wrap faq">
      <div class="head"><p class="eyebrow">Quick answers</p><h2 id="faq-title">Cost of living questions</h2></div>
      {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      <div class="sources"><h3>Sources</h3><ul>{SOURCES.map((s) => <li><a href={s.url} rel="noopener">{s.name}</a></li>)}</ul></div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="wrap prose cta">
      <h2>Moving to the Twin Cities?</h2>
      <p>Tell us where you'll work and what you want to spend, and we'll show you the cities and homes that fit, with real numbers. Call or text <a href={site.phoneHref}>{site.phone}</a>, or <a href="/contact">send us a note</a>.</p>
    </div>
  </section>
</Base>

<style>
  .head { margin-bottom: 1.25rem; }
  .table-scroll { overflow-x: auto; }
  table.data { width: 100%; border-collapse: collapse; font-size: .98rem; }
  table.data th, table.data td { padding: .55rem .7rem; border-bottom: 1px solid var(--line); text-align: left; }
  table.data .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .source { margin-top: 1rem; font-size: .9rem; color: var(--text-soft); }
  .links { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; margin-top: 1rem; }
  .faq { display: grid; gap: .75rem; max-width: 52rem; }
  .faq details { padding: 1rem 1.2rem; background: var(--paper); border: 1px solid var(--line); }
  .faq summary { cursor: pointer; font: 600 1.15rem/1.3 var(--serif); }
  .sources { margin-top: 1.5rem; font-size: .92rem; color: var(--text-soft); }
  .sources h3 { font: 700 .8rem/1.3 var(--ui); letter-spacing: .1em; text-transform: uppercase; margin-bottom: .4rem; }
  .sources ul { display: grid; gap: .3rem; padding-left: 1.1rem; }
  .cta a { color: #fff; font-weight: 700; }
</style>
