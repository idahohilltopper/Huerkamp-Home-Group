---
// One blog post. Addresses match the old Squarespace blog exactly (e.g. /blog/2022/10/27/slug).
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import TeamPhoto from '../../components/TeamPhoto.astro';
import { getPosts, postUrl, catUrl, formatDate, readingMinutes, related, type Post } from '../../data/blog';
import { youtubeId, youtubeHtml } from '../../lib/youtube.mjs';
import { business, origin } from '../../data/schema';
import { communities } from '../../data/areas';
import team from '../../data/team.json';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { path: post.data.path }, props: { post, posts } }));
}
const { post, posts } = Astro.props as { post: Post; posts: Post[] };
const { title, description, date, updated, author, categories, tags, cover, youtube } = post.data;
const { Content } = await render(post);
const minutes = readingMinutes(post.body);
const url = new URL(postUrl(post), origin).href;
const videoId = youtube ? youtubeId(youtube) : null;
// Tall covers are infographics; they still appear on cards and shares, but not as a page banner.
const showCover = cover && cover.height / cover.width <= 1;
const jason = team.members.find((m) => m.name === 'Jason Huerkamp')!;
const byJason = author === 'Jason Huerkamp';
const more = related(post, posts);
// Community guides this post is about (local stories link back to their town's page).
const places = post.data.communities.map((slug: string) => communities.find((c) => c.slug === slug)).filter((c) => c != null);

const ld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${url}#post`,
  headline: title,
  description,
  url,
  mainEntityOfPage: url,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  image: cover ? new URL(cover.src, origin).href : `${origin}/brand/og-default.jpg`,
  author: byJason
    ? { '@type': 'Person', name: jason.name, jobTitle: 'Founder', url: `${origin}/team`, worksFor: { '@id': business['@id'] } }
    : { '@id': business['@id'] },
  publisher: { '@id': business['@id'] },
  articleSection: categories.length ? categories : undefined,
  ...(places.length && { about: places.map((c) => ({ '@type': 'City', name: `${c.name}, Minnesota`, url: `${origin}/communities/${c.slug}` })) }),
  keywords: tags.length ? tags.join(', ') : undefined,
  wordCount: post.body?.split(/\s+/).length,
  ...(videoId && {
    video: {
      '@type': 'VideoObject', name: title, description, uploadDate: date.toISOString(),
      thumbnailUrl: `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`, embedUrl: `https://www.youtube-nocookie.com/embed/${videoId}`,
      contentUrl: `https://www.youtube.com/watch?v=${videoId}`,
    },
  }),
});
---
<Base
  breadcrumbs={[{ name: 'Blog', href: '/blog' }, ...(categories[0] ? [{ name: categories[0], href: catUrl(categories[0]) }] : []), { name: title, href: postUrl(post) }]}
  title={`${title} | Huerkamp Home Group`}
  description={description}
  image={cover?.src}
  article={{ published: date, modified: updated }}>
  <script slot="head" type="application/ld+json" set:html={ld} />

  <article class="post">
    <header class="post__head wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/blog">Blog</a>
        {categories.map((c) => <><span aria-hidden="true">/</span><a href={catUrl(c)}>{c}</a></>)}
      </nav>
      <h1>{title}</h1>
      <p class="post__meta">
        <span>By {byJason ? <a href="/team">{author}</a> : author}</span>
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span>{minutes} min read</span>
      </p>
    </header>

    {videoId
      ? <div class="post__media wrap" set:html={youtubeHtml(videoId, title)} />
      : showCover && (
        <div class="post__media wrap">
          <img src={cover.src} alt={cover.alt ?? ''} width={cover.width} height={cover.height} fetchpriority="high" decoding="async" />
        </div>
      )}

    <div class="post__body wrap">
      <Content />
    </div>

    <aside class="wrap post__aside" aria-label="About the author and next steps">
      {places.length > 0 && (
        <div class="guides">
          <p class="eyebrow">Community guide{places.length > 1 ? 's' : ''}</p>
          {places.map((c) => (
            <a class="guides__link" href={`/communities/${c.slug}`}>
              <strong>{c.name}, MN</strong>
              <span>Homes for sale, home values, schools, commutes and more local stories</span>
            </a>
          ))}
        </div>
      )}
      <div class="author">
        {byJason
          ? <TeamPhoto photo={jason.photo} alt={jason.name} size={96} />
          : <img src="/brand/hhg-mark.webp" alt="" width="96" height="65" />}
        <div>
          <p class="eyebrow">Written by</p>
          <p class="author__name">{byJason ? `${jason.name}, Founder` : site.name}</p>
          <p>{byJason
            ? `Jason Huerkamp founded Huerkamp Home Group with Brooke Huerkamp in 2002. The team helps Twin Cities families buy and sell homes with ${site.brokerage}.`
            : `A Twin Cities real estate team with ${site.brokerage}, led by Jason and Brooke Huerkamp since 2002.`}</p>
        </div>
      </div>
      <div class="cta">
        <h2>Thinking about a move?</h2>
        <p>Talk with a local agent about your plans. There's no cost and no pressure.</p>
        <div class="cta__actions">
          <a class="btn" href="/sell#value">Get your home's value</a>
          <a class="btn btn--ghost" href={site.searchUrl}>Search homes</a>
          <a class="btn btn--ghost" href={site.phoneHref}>Call {site.phone}</a>
        </div>
      </div>
    </aside>
  </article>

  {more.length > 0 && (
    <section class="section section--paper" aria-labelledby="more-title">
      <div class="wrap">
        <div class="head"><p class="eyebrow">Keep reading</p><h2 id="more-title">Related articles</h2></div>
        <ul class="more">{more.map((p) => <li><PostCard post={p} /></li>)}</ul>
      </div>
    </section>
  )}
</Base>

<style>
  .post { padding-block: clamp(2.5rem, 6vw, 4.5rem); }
  .post .wrap { max-width: 46rem; }
  .post__head { display: grid; gap: 1rem; margin-bottom: 2rem; }
  .crumbs { display: flex; flex-wrap: wrap; gap: .5rem; font: 700 .72rem/1.3 var(--ui); letter-spacing: .14em; text-transform: uppercase; }
  .crumbs a { color: var(--crimson); text-decoration: none; }
  .crumbs span { color: var(--text-soft); }
  .post h1 { font: 500 clamp(2.2rem, 5vw, 3.4rem)/1.08 var(--serif-display); letter-spacing: -.01em; }
  .post__meta { display: flex; flex-wrap: wrap; gap: .4rem 1.4rem; font-size: .95rem; color: var(--text-soft); }
  .post__meta a { color: var(--text); }
  .post__media { margin-bottom: 2.25rem; }
  .post__media img { width: 100%; height: auto; }

  .post__body { display: grid; gap: 1.15rem; font-size: 1.1rem; line-height: 1.75; color: var(--text); }
  .post__body :global(h2) { font: 500 clamp(1.7rem, 3.4vw, 2.2rem)/1.15 var(--serif); margin-top: 1.25rem; }
  .post__body :global(h3) { font: 600 1.45rem/1.25 var(--serif); margin-top: .75rem; }
  .post__body :global(h4) { font: 700 1.05rem/1.3 var(--ui); margin-top: .5rem; }
  .post__body :global(a) { color: var(--crimson-deep); text-underline-offset: .15em; }
  .post__body :global(ul), .post__body :global(ol) { margin: 0; padding-left: 1.35rem; display: grid; gap: .45rem; }
  .post__body :global(li > p) { margin: 0; }
  .post__body :global(blockquote) { margin: 0; padding-left: 1.25rem; border-left: 3px solid var(--crimson); font: italic 400 1.3rem/1.5 var(--serif); }
  .post__body :global(hr) { border: 0; border-top: 1px solid var(--line); width: 100%; }
  .post__body :global(.post-figure) { margin: .5rem 0; }
  .post__body :global(.post-figure img) { height: auto; margin-inline: auto; }
  .post__body :global(table) { width: 100%; border-collapse: collapse; font-size: .95rem; display: block; overflow-x: auto; }
  .post__body :global(th), .post__body :global(td) { border: 1px solid var(--line); padding: .6rem .8rem; text-align: left; vertical-align: top; }
  .post__body :global(th) { background: var(--sand); }
  .post__body :global(.post-embed) { position: relative; aspect-ratio: 1; max-width: 30rem; }
  .post__body :global(.post-embed iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

  .post__aside { display: grid; gap: 1.5rem; margin-top: 3rem; }
  .guides { display: grid; gap: .75rem; padding: 1.5rem; border: 1px solid var(--line); border-left: 4px solid var(--crimson); background: var(--paper); }
  .guides__link { display: grid; gap: .15rem; text-decoration: none; color: var(--text); }
  .guides__link strong { font: 600 1.3rem/1.2 var(--serif); }
  .guides__link span { color: var(--text-soft); font-size: .95rem; }
  .guides__link:hover strong { color: var(--crimson); }
  .author { display: grid; grid-template-columns: 6rem 1fr; gap: 1.25rem; align-items: center; padding: 1.5rem; background: var(--sand); }
  .author :global(img) { width: 6rem; height: 6rem; object-fit: cover; border-radius: 50%; }
  .author img[src$='hhg-mark.webp'] { object-fit: contain; border-radius: 0; }
  .author p { font-size: .95rem; color: var(--text-soft); }
  .author .author__name { font: 600 1.3rem/1.2 var(--serif); color: var(--text); margin-bottom: .25rem; }
  @media (max-width: 480px) { .author { grid-template-columns: 1fr; } }
  .cta { display: grid; gap: .75rem; padding: 2rem; background: var(--night); color: #fff; }
  .cta h2 { font-size: 2rem; color: #fff; }
  .cta p { color: #e9e1da; }
  .cta__actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: .5rem; }
  .more { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); gap: 1.5rem; }
</style>
