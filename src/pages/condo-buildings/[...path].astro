---
// Condo buildings with units for sale: /condo-buildings (every building with a condo listed now) and
// /condo-buildings/<building> (its units for sale). Data: src/data/condo-buildings.ts. Only buildings with a unit for sale
// get a page (Jason, Nov 17, 2026), so the list follows the MLS feed at every build.
import FeedTopicPage from '../../components/FeedTopicPage.astro';
import SellerAsk from '../../components/SellerAsk.astro';
import SoldHomes from '../../components/SoldHomes.astro';
import { buildingsData, type Building } from '../../data/condo-buildings';
import { homesHref, money, median, listingsData } from '../../data/listings';
import { hoodByKey, CITY_NAME } from '../../data/neighborhoods';
import { communities } from '../../data/areas';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const { list, mode } = await buildingsData;
  if (mode === 'off') return [];
  return [{ params: { path: undefined }, props: { b: null } }, ...list.map((b) => ({ params: { path: b.slug }, props: { b } }))];
}
const { b } = Astro.props as { b: Building | null };
const { list, at, preview } = await buildingsData;
const feed = await listingsData;
const day = at ? new Date(at).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'America/Chicago' }) : '';
const cityName = (slug: string) => CITY_NAME[slug] ?? communities.find((x) => x.slug === slug)?.name ?? slug;
const page = (path: string) => (feed.collections.some((k) => k.path === path) ? homesHref(path) : null);
const base = '/condo-buildings';
const n = (k: number) => `${k} ${k === 1 ? 'condo' : 'condos'}`;
const label = (x: Building) => (x.named ? `${x.name} (${x.addresses.join(' & ')})` : x.name);

// One building
const hood = b?.hood ? hoodByKey(b.hood) : undefined;
const beds = b ? [...new Set(b.units.map((u) => u.beds ?? 0))].sort((x, y) => x - y).map((k) => { const l = b.units.filter((u) => (u.beds ?? 0) === k); return { label: k ? `${k} bedroom${k > 1 ? 's' : ''}` : 'Studio', n: l.length, med: median(l.map((u) => u.price)) }; }) : [];
const nearby = b ? list.filter((x) => x.slug !== b.slug).map((x) => ({ x, d: Math.hypot(x.lat - b.lat, (x.lng - b.lng) * 0.71) })).sort((p, q) => p.d - q.d).slice(0, 8).map(({ x }) => ({ label: x.name, n: x.units.length, med: x.median, href: `${base}/${x.slug}` })) : [];
const answer = b ? `${n(b.units.length)} ${b.units.length === 1 ? 'is' : 'are'} for sale at ${b.name}${b.named ? `, ${b.addresses.join(' and ')}` : ''} in ${b.city}, MN as of ${day}${b.units.length > 1 ? `, from ${money(b.units[0].price)} to ${money(b.units[b.units.length - 1].price)}, median ${money(b.median)}` : `, listed at ${money(b.units[0].price)}`}.${b.hoa ? ` Median association fee: ${money(b.hoa)} a month, as listed.` : ''}` : '';
const faq = b ? [
  { q: `How many condos are for sale at ${b.name}?`, a: answer },
  ...(b.hoa ? [{ q: `What are the association fees at ${b.name}?`, a: `The units listed now show a median association fee of ${money(b.hoa)} a month. What the fee covers (heat, water, parking, amenities) is in each listing and the association's documents; ask us and we'll pull them.` }] : []),
  { q: 'What should I check before buying a condo?', a: "The association's budget and reserves, any special assessments, rental and pet rules, and whether the building is FHA or VA approved if you're using one of those loans. Read the association's resale disclosure certificate before you close." },
  { q: `How do I hear about new listings at ${b.name} first?`, a: `Tell us below and we'll email you the moment a unit at ${b.name} hits the MLS. Or call or text ${site.phone}.` },
] : [];

// Hub
const all = list.flatMap((x) => x.units);
const byCity = [...new Set(list.map((x) => x.community))].map((c) => { const l = list.filter((x) => x.community === c).flatMap((x) => x.units); return { label: cityName(c), n: l.length, med: median(l.map((u) => u.price)), href: page(`${c}/condos`) }; }).sort((p, q) => q.n - p.n);
const hubAnswer = `${list.length} Twin Cities condo buildings have units for sale as of ${day}: ${n(all.length)} in all${all.length ? `, median list price ${money(median(all.map((u) => u.price)))}` : ''}, from NorthstarMLS.`;
---
{b ? (
  <FeedTopicPage path={`${base}/${b.slug}`} crumb={b.name} at={at} noindex={!!preview}
    title={`${b.name} Condos for Sale (${b.units.length}), ${b.city} MN | ${site.name}`}
    description={answer}
    eyebrow={`Condo building · ${hood ? `${hood.name}, ` : ''}${b.city}`} h1={`${b.name} condos for sale`} answer={answer}
    lede={`Every unit for sale at ${b.name}, from NorthstarMLS, updated ${day}.${hood ? ` In the <a href="${page(b.hood!) ?? homesHref(b.community)}">${hood.name}</a> neighborhood.` : ''}${b.url ? ` Building website: <a href="${b.url}" rel="noopener" target="_blank">${new URL(b.url).hostname.replace(/^www\./, '')}</a>.` : ''}`}
    tables={[{ h: 'By bedrooms', col: 'Size', rows: beds }, { h: 'Condo buildings nearby with units for sale', col: 'Building', rows: nearby }]}
    note={`Units listed in NorthstarMLS at ${b.addresses.join(' and ')}. Updated ${day}.`}
    shown={b.units.slice(0, 48)} shownH={`Condos for sale at ${b.name}`}
    ask={{ eyebrow: `Watching ${b.name}?`, h2: `Get ${b.name} listings <em>first.</em>`, p: `We'll email you new units at ${b.name} the moment they're listed.`, interest: `Condo building: ${b.name}`, msg: 'Bedrooms, price range, timing (optional)' }}
    faq={faq} faqH={`${b.name} condos`}
    links={[['All condo buildings', base], ...(page(`${b.community}/condos`) ? [[`${cityName(b.community)} condos for sale`, page(`${b.community}/condos`)!] as [string, string]] : []), ['Condos for sale in the Twin Cities', '/condos-for-sale-mn'], ['What is my condo worth?', '/home-estimate']]} >
    <SellerAsk eyebrow={`Own at ${b.name}?`} title={`What's your condo at ${b.name} <em>worth?</em>`} text={`${n(b.units.length)} ${b.units.length === 1 ? 'is' : 'are'} listed here now${b.units.length > 1 ? `, asking ${money(b.units[0].price)} to ${money(b.units[b.units.length - 1].price)}` : `, asking ${money(b.units[0].price)}`}. Asking prices aren't sale prices: tell us your unit and we'll show you what similar units actually sold for.`} address={`${b.addresses[0]}, ${b.city}`} />
    {b.named && <SoldHomes place={`condo:${b.slug}`} name={b.name} months={36} />}
  </FeedTopicPage>
) : (
  <FeedTopicPage path={base} crumb="Condo buildings" at={at} noindex={!!preview}
    title={`Twin Cities Condo Buildings With Units for Sale (${list.length}) | ${site.name}`}
    description={hubAnswer}
    eyebrow="Condo buildings" h1="Condo buildings with units for sale" answer={hubAnswer}
    lede={`Only buildings with a condo listed for sale right now, updated ${day}. Pick a building to see its units, prices and association fees.`}
    tables={[{ h: 'Buildings with units for sale', col: 'Building', rows: list.map((x) => ({ label: label(x), n: x.units.length, med: x.median, href: `${base}/${x.slug}` })) }, { h: 'By city', col: 'City', rows: byCity }]}
    note={`Building names from their Google Business Profiles; other buildings are shown by address. Listings from NorthstarMLS, updated ${day}.`}
    shown={all.slice().sort((p, q) => String(q.listed ?? '').localeCompare(String(p.listed ?? ''))).slice(0, 48)} shownH="Newest condos for sale in these buildings"
    ask={{ eyebrow: 'Looking for a condo?', h2: 'Get condo listings <em>first.</em>', p: "Tell us the buildings or neighborhoods you like and we'll email new units the moment they're listed.", interest: 'Condo building', msg: 'Buildings, bedrooms, price range (optional)' }}
    faq={[{ q: 'How many condo buildings have units for sale?', a: hubAnswer }, { q: 'Which buildings have the most condos for sale?', a: list.slice(0, 3).map((x) => `${x.name}: ${x.units.length}`).join('; ') + `, from NorthstarMLS on ${day}.` }, { q: 'Why is a building missing?', a: "A building appears only while it has a condo listed for sale, and rental apartment buildings aren't included. Tell us the building and we'll let you know when a unit comes up." }]}
    faqH="Condo buildings"
    links={[['Condos for sale in the Twin Cities', '/condos-for-sale-mn'], ...(page('minneapolis/condos') ? [['Minneapolis condos', page('minneapolis/condos')!] as [string, string]] : []), ...(page('saint-paul/condos') ? [['Saint Paul condos', page('saint-paul/condos')!] as [string, string]] : []), ['Downsizing', '/downsizing']]} />
)}
