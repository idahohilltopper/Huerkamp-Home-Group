---
// Team page: everyone on huerkamphomegroup.com/team-page, titles and bios verbatim from their profiles.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import TeamPhoto from '../components/TeamPhoto.astro';
import team from '../data/team.json';
import { site } from '../data/site';

const members = team.members;
const founders = members.filter((m) => m.name === 'Jason Huerkamp' || m.name === 'Brooke Huerkamp');
const rest = members.filter((m) => !founders.includes(m));
const isAgent = (t: string | null) => !!t && /realtor|broker/i.test(t);
const agents = rest.filter((m) => isAgent(m.title));
const staff = rest.filter((m) => !isAgent(m.title));
const big = (m: { photo: string }) => `/people/${m.photo.split('/').pop()!.replace(/\.(png|jpg)$/, '')}-720`;

const ld = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': members.map((m) => ({
    '@type': 'RealEstateAgent', name: m.name, jobTitle: m.title, telephone: m.phone, email: m.email,
    image: new URL(m.photo, 'https://www.huerkamphomegroup.com').href,
    worksFor: { '@id': 'https://www.huerkamphomegroup.com/#business' },
  })),
});
---
<Base
  breadcrumbs={[{ name: 'Our team', href: '/team' }]} title="Our Team | Huerkamp Home Group" description={`Meet the ${members.length} agents and staff of Huerkamp Home Group, a Twin Cities real estate team at ${site.brokerage} since 2002.`}>
  <script slot="head" type="application/ld+json" set:html={ld} />
  <PageHero eyebrow="Meet the team" title={`${members.length} people. One team.`}
    lede={`Licensed REALTORS® and client-care staff at ${site.brokerage} in Burnsville, led by founders Jason and Brooke Huerkamp since 2002.`} />

  <section class="section" aria-labelledby="founders-title">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">Founders</p>
        <h2 id="founders-title">Jason &amp; Brooke <em>Huerkamp.</em></h2>
      </div>
      <div class="founders">
        {founders.map((m) => (
          <article class="founder">
            <picture>
              <source srcset={`${big(m)}.webp`} type="image/webp" />
              <img src={`${big(m)}.jpg`} alt={m.name} width="360" height="360" loading="lazy" />
            </picture>
            <div class="founder__body">
              <h3>{m.name}</h3>
              <p class="role">{m.title}{m.license && ` · MN license ${m.license}`}</p>
              <p class="contact"><a href={`tel:+1${m.phone.replace(/\D/g, '')}`}>{m.phone}</a> · <a href={`mailto:${m.email}`}>{m.email}</a></p>
              {m.bio && <details><summary>Read bio</summary><p>{m.bio}</p></details>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {[{ title: 'Our agents', id: 'agents', list: agents }, { title: 'Leadership and client care', id: 'staff', list: staff }].map((group) => (
    <section class="section section--paper" aria-labelledby={`${group.id}-title`}>
      <div class="wrap">
        <div class="head">
          <p class="eyebrow">{group.list.length} people</p>
          <h2 id={`${group.id}-title`}>{group.title}</h2>
        </div>
        <ul class="people">
          {group.list.map((m) => (
            <li class="person">
              <TeamPhoto photo={m.photo} alt={m.name} size={320} sizes="(max-width: 480px) 45vw, 16rem" />
              <h3>{m.name}</h3>
              <p class="role">{m.title}</p>
              <p class="contact"><a href={`tel:+1${m.phone.replace(/\D/g, '')}`}>{m.phone}</a></p>
              {m.bio && <details><summary>Read bio</summary><p>{m.bio}</p></details>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <section class="section section--dark" id="careers">
    <div class="wrap join">
      <div class="prose">
        <p class="eyebrow">Careers</p>
        <h2>Want to <em>join the team?</em></h2>
        <p>We're always talking with agents who want leads, coaching and a team that has your back.</p>
      </div>
      <a class="btn" href="/contact">Talk to us about joining</a>
    </div>
  </section>
</Base>

<style>
  .founders { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; }
  @media (max-width: 860px) { .founders { grid-template-columns: 1fr; } }
  .founder { display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: 1.5rem; align-items: start; padding: 1.5rem; background: var(--paper); border-top: 3px solid var(--crimson); }
  @media (max-width: 480px) { .founder { grid-template-columns: 1fr; } }
  .founder img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; }
  .founder__body { display: grid; gap: .5rem; }
  .role { font: 700 .72rem/1.3 var(--ui); letter-spacing: .14em; text-transform: uppercase; color: var(--crimson); }
  .contact { font-size: .95rem; color: var(--text-soft); }
  .contact a { color: var(--text); text-decoration: none; }
  .contact a:hover { color: var(--crimson); }
  details summary { cursor: pointer; font: 700 .8rem/1 var(--ui); letter-spacing: .12em; text-transform: uppercase; color: var(--ink); margin-top: .25rem; }
  details p { margin-top: .75rem; color: var(--text-soft); font-size: .95rem; }

  .people { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr)); gap: 2rem 1.5rem; }
  .person { display: grid; gap: .35rem; align-content: start; }
  .person :global(img) { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; margin-bottom: .5rem; background: var(--night); }
  .person h3 { font-size: 1.35rem; }

  .join { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 2rem; }
</style>
