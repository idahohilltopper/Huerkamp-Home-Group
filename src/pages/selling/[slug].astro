---
// One selling or buying guide (src/data/sellguides.ts): direct answer first, the details, quick answers, sources,
// and a lead form (seller guides: a seller lead with the guide as its topic; buyer guides: a buyer lead).
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { sguides, sguideHref, type SGuide } from '../../data/sellguides';
import { business, origin } from '../../data/schema';
import { site } from '../../data/site';

export function getStaticPaths() {
  return sguides.map((g) => ({ params: { slug: g.slug }, props: { g } }));
}
const { g } = Astro.props as { g: SGuide };
const others = sguides.filter((x) => x !== g);
const url = `${origin}${sguideHref(g)}`;
const seller = g.lead === 'seller-guide';
const ld = JSON.stringify([
  { '@context': 'https://schema.org', '@type': 'Article', '@id': `${url}#article`, headline: g.title, description: g.description, url,
    author: { '@type': 'Person', name: 'Jason Huerkamp' }, publisher: { '@id': business['@id'] }, dateModified: '2026-11-08', citation: g.sources.map((s) => s.url) },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: g.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
]);
---
<Base breadcrumbs={[{ name: seller ? 'Sell' : 'Buy', href: seller ? '/sell' : '/buy' }, { name: g.title, href: sguideHref(g) }]}
  title={`${g.seo} | ${site.name}`} description={g.description} article={{ published: new Date('2026-11-08') }}>
  <script slot="head" type="application/ld+json" set:html={ld} />
  <PageHero eyebrow={g.eyebrow} title={g.title} lede={g.answer} />

  <section class="section">
    <div class="wrap sguide">
      <article class="prose big">
        <nav class="toc" aria-label="On this page"><strong>On this page</strong><ol>{g.sections.map((s, i) => <li><a href={`#s${i + 1}`}>{s.h}</a></li>)}</ol></nav>
        {g.sections.map((s, i) => (<><h2 id={`s${i + 1}`}>{s.h}</h2><Fragment set:html={s.html} /></>))}
        <div class="ssources"><h2>Sources</h2><ul>{g.sources.map((s) => <li><a href={s.url} rel="noopener">{s.name}</a></li>)}</ul>
          <p>General information, not legal or tax advice. Checked November 8, 2026.</p></div>
      </article>
      <aside class="sside">
        <div class="scard">
          <h2>{seller ? 'What would you net?' : 'Watching a home?'}</h2>
          <p>{seller ? 'Get a free valuation and a net sheet: what you would walk away with by listing, next to a cash offer.' : 'We’ll tell you the moment a home you like changes status, and help you write a back-up offer.'} Or call <a href={site.phoneHref}>{site.phone}</a>.</p>
          <a class="btn" href="#ask">{seller ? 'Get my numbers' : 'Ask us about a home'}</a>
          {seller && <a class="scard__alt" href="/calculators/seller-net-proceeds">Seller net proceeds calculator</a>}
        </div>
        <div class="scard">
          <h2>More guides</h2>
          <ul>{others.map((x) => <li><a href={sguideHref(x)}>{x.title}</a></li>)}<li><a href="/downsizing/selling-a-house-in-probate-minnesota">Selling a house in probate in Minnesota</a></li><li><a href="/selling-in-minnesota">What’s required to sell in Minnesota</a></li></ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="faq-title">
    <div class="wrap faq">
      <div class="head"><p class="eyebrow">Quick answers</p><h2 id="faq-title">Common questions</h2></div>
      {g.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </div>
  </section>

  <section class="section section--dark" id="ask" aria-labelledby="ask-title">
    <div class="wrap split">
      <div class="prose">
        <p class="eyebrow">{seller ? 'No pressure, just numbers' : 'Buying in the Twin Cities'}</p>
        <h2 id="ask-title">{seller ? <>See your numbers <em>before you decide.</em></> : <>Have a home in mind? <em>Ask us.</em></>}</h2>
        <p>{seller ? 'Tell us about your home. We’ll show you what it would likely sell for, what you’d net after every cost, and how that compares with a cash offer.' : 'Tell us which home or area. We’ll check its status with the listing agent, tell you what it would take to win it, and watch for anything new.'}</p>
        <p>Call or text <a href={site.phoneHref}>{site.phone}</a>.</p>
      </div>
      <form class="form" data-lead={g.lead}>
        <input type="hidden" name="topic" value={g.topic} />
        <div class="form__row">
          <div class="field"><label for="sg-first">First name</label><input id="sg-first" name="firstName" autocomplete="given-name" required /></div>
          <div class="field"><label for="sg-last">Last name</label><input id="sg-last" name="lastName" autocomplete="family-name" required /></div>
        </div>
        <div class="form__row">
          <div class="field"><label for="sg-email">Email</label><input id="sg-email" name="email" type="email" autocomplete="email" required /></div>
          <div class="field"><label for="sg-phone">Phone</label><input id="sg-phone" name="phone" type="tel" autocomplete="tel" required pattern="[^0-9]*([0-9][^0-9]*){10,}" title="Please enter your phone number, including area code." /></div>
        </div>
        {seller
          ? <div class="field"><label for="sg-address">Home address (optional)</label><input id="sg-address" name="address" autocomplete="street-address" /></div>
          : <div class="field"><label for="sg-msg">Which home or area? (optional)</label><textarea id="sg-msg" name="message" rows="3"></textarea></div>}
        <button class="btn" type="submit">{seller ? 'Send me my numbers' : 'Send'}</button>
        <p class="form__status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</Base>

<style>
  .sguide { display: grid; grid-template-columns: minmax(0, 1fr) minmax(16rem, 21rem); gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  @media (max-width: 900px) { .sguide { grid-template-columns: 1fr; } }
  .big { font-size: 1.12rem; line-height: 1.75; }
  .big h2 { margin-top: 2.25rem; font: 500 clamp(1.5rem, 3vw, 1.9rem)/1.2 var(--serif); }
  .big li { margin-bottom: .45rem; }
  .toc { margin-bottom: 1.5rem; padding: 1rem 1.25rem; border: 1px solid var(--line); background: var(--paper); font-size: 1rem; }
  .toc ol { margin: .5rem 0 0; padding-left: 1.25rem; }
  .ssources { margin-top: 2rem; font-size: .95rem; }
  .sside { position: sticky; top: 6rem; display: grid; gap: 1.25rem; }
  @media (max-width: 900px) { .sside { position: static; } }
  .scard { padding: 1.25rem 1.4rem; border: 1px solid var(--line); background: var(--paper); }
  .scard h2 { margin: 0 0 .6rem; font: 500 1.35rem/1.2 var(--serif); }
  .scard p { font-size: 1rem; }
  .scard ul { margin: 0; padding-left: 1.1rem; display: grid; gap: .45rem; font-size: .98rem; }
  .scard__alt { display: block; margin-top: .85rem; font-weight: 600; color: var(--crimson); }
  .head { margin-bottom: 1.5rem; }
  .faq { display: grid; gap: .75rem; max-width: 52rem; }
  .faq details { padding: 1rem 1.2rem; background: var(--paper); border: 1px solid var(--line); }
  .faq summary { cursor: pointer; font: 600 1.2rem/1.3 var(--serif); }
  .faq details p { margin-top: .6rem; font-size: 1.05rem; }
  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  @media (max-width: 900px) { .split { grid-template-columns: 1fr; } }
  .split .prose a { color: #fff; font-weight: 700; }
</style>
