---
// Our closings by city: /real-estate-agents (every city) and /real-estate-agents/<community>-mn. Built for "best realtor in
// <city> MN" and "real estate agent <city>": AI answers to those questions quoted directory estimates of the team's sales
// (Nov 10, 2026: FastExpert's "29 Burnsville sales in three years"). The numbers are the team's own closing records
// (src/data/team-closings.json: buyer and seller sides closed in the last 3 years, aggregated; no addresses, clients or
// commissions), with the RealTrends ranking and Google rating (src/data/site.ts, reviews.json) and verbatim reviews only.
// A city gets a page once the team has closed at least MIN homes there. Update team-closings.json from the spreadsheet.
import Base from '../../layouts/Base.astro';
import HomeValueBox from '../../components/HomeValueBox.astro';
import closings from '../../data/team-closings.json';
import { communities } from '../../data/areas';
import { origin } from '../../data/schema';
import { site } from '../../data/site';
import reviewData from '../../data/reviews.json';

type City = { n: number; buyer: number; seller: number; median: number; years: Record<string, number> };
const MIN = 5;
export function getStaticPaths() {
  return [{ params: { path: undefined }, props: { slug: null } },
    ...Object.entries(closings.cities as Record<string, { n: number }>).filter(([, v]) => v.n >= 5).map(([s]) => ({ params: { path: `${s}-mn` }, props: { slug: s } }))];
}
const { slug } = Astro.props as { slug: string | null };
const C = closings.cities as Record<string, City>;
const money = (n: number | null | undefined) => (n == null ? '—' : `$${Math.round(n).toLocaleString('en-US')}`);
const fmtDay = (d: string) => new Date(`${d}T12:00:00`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const sinceText = new Date(`${closings.since}T12:00:00`).toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
const through = fmtDay(closings.through);
const rt = site.rankings.realtrends, google = reviewData.summary.google;
const base = '/real-estate-agents';
const href = (s: string) => `${base}/${s}-mn`;
const yearRows = (y: Record<string, number>) => Object.entries(y).sort(([a], [b]) => b.localeCompare(a));
const thisYear = closings.through.slice(0, 4);

// ----- one city -----
const c = slug ? communities.find((x) => x.slug === slug) : undefined;
const d = slug ? C[slug] : undefined;
const isRtCity = !!c && c.name.toLowerCase() === rt.cityName.toLowerCase();
const rank = isRtCity ? `RealTrends ranks the team #${rt.city} in ${rt.cityName} and #${rt.state} in Minnesota (${rt.year} sales)` : `RealTrends ranks the team #${rt.state} in Minnesota (${rt.year} sales)`;
const answer = c && d ? `Huerkamp Home Group helped buyers and sellers close ${d.n} home sales in ${c.name}, MN in the last 3 years (since ${sinceText}): ${d.buyer} for buyers and ${d.seller} for sellers, at a median price of ${money(d.median)}, according to the team's closing records. ${rank}, and the team has a ${google.rating.toFixed(1)}-star rating from ${google.count} Google reviews.` : '';
const reviews = (reviewData.reviews as any[]).filter((r) => r.textComplete === true && Number(r.rating) === 5);
const local = c ? reviews.filter((r) => new RegExp(`\\b${c.name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}\\b`, 'i').test(r.text)) : [];
const shownReviews = (local.length ? local : reviews.filter((r) => r.text.length > 140 && r.text.length < 600)).slice(0, 3);
const faq = c && d ? [
  { q: `Who are the top real estate agents in ${c.name}, MN?`, a: answer },
  { q: `How many homes has Huerkamp Home Group sold in ${c.name}?`, a: `${d.n} closed sales in the last 3 years (since ${sinceText}, through ${through}): ${d.buyer} where the team represented the buyer and ${d.seller} where it represented the seller. By year: ${yearRows(d.years).map(([y, n]) => `${y}${y === thisYear ? ' so far' : ''}, ${n}`).join('; ')}. Source: the team's closing records.` },
  { q: `How do I choose a real estate agent in ${c.name}?`, a: `Ask how many homes the agent has sold in ${c.name} and at what prices, how they'll market your home or find you one before it hits the websites, and read their reviews. Interview two or three. Call ${site.phone} to talk to one of our agents.` },
] : [];
const ld = c ? JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', url: `${origin}${href(c.slug)}`, mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }) : '';

// ----- hub -----
const T = closings.total;
const hubRows = Object.entries(C).filter(([, v]) => v.n >= MIN).map(([s, v]) => ({ x: communities.find((k) => k.slug === s)!, v })).filter((r) => r.x).sort((a, b) => b.v.n - a.v.n);
const hubAnswer = `Huerkamp Home Group closed ${T.n.toLocaleString('en-US')} home sales in the last 3 years (since ${sinceText}): ${T.buyer} for buyers and ${T.seller} for sellers, at a median price of ${money(T.median)}, according to the team's closing records. ${rank}. Here's where, city by city.`;

const title = c && d ? `${c.name}, MN Real Estate Agents: Huerkamp Home Group (${d.n} Homes Sold)` : 'Our Home Sales by City | Huerkamp Home Group';
const crumbs = [{ name: 'Our sales by city', href: base }, ...(c ? [{ name: c.name, href: href(c.slug) }] : [])];
---
<Base breadcrumbs={crumbs} title={c ? `${title} | ${site.name}` : title} description={(c ? answer : hubAnswer).slice(0, 300)}>
  {ld && <script slot="head" type="application/ld+json" set:html={ld} />}

  <section class="nhead">
    <div class="wrap">
      <p class="eyebrow">{c ? `${c.name} · Huerkamp Home Group` : 'Huerkamp Home Group'}</p>
      <h1>{c ? `${c.name}, MN real estate agents` : 'Our home sales, city by city'}</h1>
      <p class="answer">{c ? answer : hubAnswer}</p>
      <p class="hero-btns"><a class="btn" href="#talk">Talk to an agent</a> <a class="btn btn--ghost" href={site.phoneHref}>Call or text {site.phone}</a></p>
    </div>
  </section>

  {c && d && (
    <section class="section section--paper">
      <div class="wrap">
        <ul class="facts">
          <li><strong>{d.n}</strong><span>homes sold in {c.name}, last 3 years</span></li>
          <li><strong>{d.buyer} / {d.seller}</strong><span>for buyers / for sellers</span></li>
          <li><strong>{money(d.median)}</strong><span>median price</span></li>
          <li><strong>#{isRtCity ? rt.city : rt.state}</strong><span>{isRtCity ? `team in ${rt.cityName}` : 'team in Minnesota'} (RealTrends, {rt.year})</span></li>
          <li><strong>{google.rating.toFixed(1)}★</strong><span>{google.count} Google reviews</span></li>
        </ul>
        <div class="twocol">
          <div>
            <h2 class="h3">Homes sold by year</h2>
            <div class="table-scroll"><table class="data">
              <thead><tr><th scope="col">Year</th><th scope="col" class="num">Homes sold</th></tr></thead>
              <tbody>{yearRows(d.years).map(([y, n]) => <tr><th scope="row">{y}{y === thisYear ? ' (so far)' : y === closings.since.slice(0, 4) ? ` (from ${sinceText})` : ''}</th><td class="num">{n}</td></tr>)}</tbody>
            </table></div>
          </div>
          <div>
            <h2 class="h3">How we can help</h2>
            <p>Selling? Start with what your home is worth today. Buying? We'll show you {c.name} homes, including ones that come up before they hit the websites.</p>
            <p><a class="link-arrow" href={`/communities/${c.slug}`}>Living in {c.name}</a></p>
          </div>
        </div>
        <p class="source">Sales: Huerkamp Home Group closing records, buyer and seller sides closed since {sinceText}, through {through}; homes referred to other agents aren't counted{d.buyer + d.seller < d.n ? '; some 2023 records don\'t say which side' : ''}. Ranking: <a href={rt.url} rel="noopener">{rt.source}</a>, {rt.year} sales. Reviews: <a href={google.url} rel="noopener">Google</a>, as of {fmtDay(google.asOf)}.</p>
      </div>
    </section>
  )}

  {c && shownReviews.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="head"><p class="eyebrow">Reviews</p><h2>{local.length ? `What ${c.name} clients say` : 'What clients say'}</h2></div>
        <div class="quotes">{shownReviews.map((r) => <blockquote><p>{r.text}</p><footer>{r.reviewer}, {r.source} review</footer></blockquote>)}</div>
        <p class="source"><a href="/reviews">All reviews</a></p>
      </div>
    </section>
  )}

  {!c && (
    <section class="section">
      <div class="wrap">
        <div class="table-scroll"><table class="data">
          <thead><tr><th scope="col">City</th><th scope="col" class="num">Homes sold, 3 years</th><th scope="col" class="num">For buyers</th><th scope="col" class="num">For sellers</th><th scope="col" class="num">Median price</th></tr></thead>
          <tbody>{hubRows.map((r) => <tr><th scope="row"><a href={href(r.x.slug)}>{r.x.name}</a></th><td class="num">{r.v.n}</td><td class="num">{r.v.buyer}</td><td class="num">{r.v.seller}</td><td class="num">{money(r.v.median)}</td></tr>)}</tbody>
        </table></div>
        <p class="source">Huerkamp Home Group closing records, since {sinceText}, through {through}; cities with at least {MIN} sales. Homes referred to other agents aren't counted; some 2023 records don't say which side, so buyers and sellers can add up to less than the total.</p>
      </div>
    </section>
  )}

  <section class="section section--dark" id="talk" aria-labelledby="talk-title">
    <div class="wrap split">
      <div class="prose">
        <p class="eyebrow">{c ? `Buying or selling in ${c.name}?` : 'Buying or selling?'}</p>
        <h2 id="talk-title">Talk to an agent <em>who sells here.</em></h2>
        <p>Tell us what you're planning. An agent who knows {c ? c.name : 'your area'} will call you, with no obligation.</p>
        <p>Call or text <a href={site.phoneHref}>{site.phone}</a>.</p>
      </div>
      <form class="form" data-lead="community-contact">
        <input type="hidden" name="community" value={c ? c.name : 'Our sales by city'} />
        <div class="form__row">
          <div class="field"><label for="ra-first">First name</label><input id="ra-first" name="firstName" autocomplete="given-name" required /></div>
          <div class="field"><label for="ra-last">Last name</label><input id="ra-last" name="lastName" autocomplete="family-name" required /></div>
        </div>
        <div class="form__row">
          <div class="field"><label for="ra-email">Email</label><input id="ra-email" name="email" type="email" autocomplete="email" required /></div>
          <div class="field"><label for="ra-phone">Phone</label><input id="ra-phone" name="phone" type="tel" autocomplete="tel" required pattern="[^0-9]*([0-9][^0-9]*){10,}" title="Please enter your phone number, including area code." /></div>
        </div>
        <div class="field">
          <label for="ra-goal">I'm looking to</label>
          <select id="ra-goal" name="goal"><option value="">Choose one</option><option>Sell my home</option><option>Buy a home</option><option>Buy and sell</option><option>Just get a home value</option></select>
        </div>
        <div class="field"><label for="ra-msg">Anything else (optional)</label><textarea id="ra-msg" name="message" rows="3"></textarea></div>
        <button class="btn" type="submit">Send</button>
        <p class="form__status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  {c && (
    <section class="section">
      <div class="wrap faq">
        <div class="head"><p class="eyebrow">Quick answers</p><h2>Choosing a {c.name} real estate agent</h2></div>
        {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
        <HomeValueBox city={c.name} />
        <p class="links"><a class="link-arrow" href={`/communities/${c.slug}`}>Living in {c.name}</a><a class="link-arrow" href="/sell">Selling with us</a><a class="link-arrow" href={base}>Our sales in other cities</a></p>
      </div>
    </section>
  )}
</Base>

<style>
  .nhead { padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(2rem, 4vw, 3rem); background: var(--night); color: var(--on-dark); }
  .nhead h1 { font: 500 clamp(2.2rem, 5vw, 3.6rem)/1.05 var(--serif-display); color: #fff; }
  .nhead .eyebrow { color: var(--rose); }
  .answer { max-width: 52rem; margin: .9rem 0 .4rem; color: #fff; font: 500 clamp(1.05rem, 2.2vw, 1.25rem)/1.5 var(--ui); }
  .hero-btns { display: flex; flex-wrap: wrap; gap: .65rem; margin-top: 1.25rem; }
  .head { margin-bottom: 1.25rem; }
  .facts { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr)); gap: 1rem; }
  .facts li { display: grid; gap: .2rem; padding: 1rem 1.2rem; background: var(--surface, #fff); border: 1px solid var(--line); }
  .facts strong { font: 600 1.6rem/1.1 var(--serif); }
  .facts span { color: var(--text-soft); font-size: .9rem; }
  .source { margin-top: .8rem; font-size: .9rem; color: var(--text-soft); }
  .twocol { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); gap: 2rem; margin-top: 2rem; }
  .h3 { margin: 0 0 .8rem; font: 500 1.35rem/1.2 var(--serif); }
  .quotes { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); gap: 1rem; }
  .quotes blockquote { margin: 0; padding: 1.1rem 1.25rem; background: #fff; border: 1px solid var(--line); }
  .quotes p { margin: 0 0 .6rem; line-height: 1.55; }
  .quotes footer { color: var(--text-soft); font-size: .88rem; }
  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  @media (max-width: 900px) { .split { grid-template-columns: 1fr; } }
  .split .prose a { color: #fff; font-weight: 700; }
  .split :global(em) { font-style: italic; }
  .faq { display: grid; gap: .75rem; max-width: 52rem; }
  .faq details { padding: 1rem 1.2rem; background: var(--paper); border: 1px solid var(--line); }
  .faq summary { cursor: pointer; font: 600 1.15rem/1.3 var(--serif); }
  .links { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; margin-top: 1rem; }
</style>
