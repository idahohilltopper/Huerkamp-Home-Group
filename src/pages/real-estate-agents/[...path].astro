---
// Our team's sales by city: /real-estate-agents (every city) and /real-estate-agents/<community>-mn. Built for
// "best realtor in <city> MN" and "real estate agent <city>" (Nov 10, 2026: AI answers to those questions quoted
// directory estimates of the team's sales, such as FastExpert's 29 Burnsville sales in three years). Each page states a
// checked number from NorthstarMLS (src/lib/team-sales.mjs: listing-side sales by the team's agents, last 36 months),
// the RealTrends ranking and the Google rating (src/data/site.ts, src/data/reviews.json), and verbatim reviews only.
// A city gets a page once the team has sold at least MIN homes there.
import Base from '../../layouts/Base.astro';
import HomeValueBox from '../../components/HomeValueBox.astro';
import { loadTeamSales, teamAgents, MONTHS } from '../../lib/team-sales.mjs';
import { communities } from '../../data/areas';
import { origin } from '../../data/schema';
import { site } from '../../data/site';
import reviewData from '../../data/reviews.json';

const MIN = 3;
const norm = (s: string) => s.toLowerCase().replace(/\bst\.?\s/g, 'saint ').replace(/[^a-z]+/g, ' ').trim();
type C = (typeof communities)[number];
function cityIndex() {
  const m = new Map<string, C>();
  for (const c of communities) { m.set(norm(c.name), c); if ((c as any).censusName) m.set(norm((c as any).censusName), c); }
  return m;
}
export async function getStaticPaths() {
  const { loadTeamSales: load } = await import('../../lib/team-sales.mjs');
  const { communities: list } = await import('../../data/areas');
  const n = (s: string) => s.toLowerCase().replace(/\bst\.?\s/g, 'saint ').replace(/[^a-z]+/g, ' ').trim();
  const data = await load();
  if (data.mode === 'off') return [];
  const idx = new Map<string, string>();
  for (const c of list) { idx.set(n(c.name), c.slug); if ((c as any).censusName) idx.set(n((c as any).censusName), c.slug); }
  const counts = new Map<string, number>();
  for (const s of data.sales) { const slug = idx.get(n(s.city)); if (slug) counts.set(slug, (counts.get(slug) ?? 0) + 1); }
  // Local previews have no sales: build Burnsville's page anyway so its layout and form can be checked.
  const slugs = data.sales.length ? [...counts].filter(([, k]) => k >= 3).map(([s]) => s) : ['burnsville'];
  return [{ params: { path: undefined }, props: { slug: null } }, ...slugs.map((s) => ({ params: { path: `${s}-mn` }, props: { slug: s } }))];
}
const { slug } = Astro.props as { slug: string | null };
const data = await loadTeamSales();
const idx = cityIndex();
const complete = data.mode !== 'off' && !data.failed.length && data.sales.length > 0;
const money = (n: number | null | undefined) => (n == null ? '—' : `$${Math.round(n).toLocaleString('en-US')}`);
const median = (a: number[]) => { const s = [...a].sort((x, y) => x - y); return s.length ? (s.length % 2 ? s[(s.length - 1) / 2] : Math.round((s[s.length / 2 - 1] + s[s.length / 2]) / 2)) : null; };
const fmtDay = (d: string | null) => (d ? new Date(d).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'America/Chicago' }) : '');
const asOf = fmtDay(data.at);
const sinceText = data.since ? new Date(`${data.since}T12:00:00`).toLocaleDateString('en-US', { month: 'long', year: 'numeric' }) : '';
const salesBy = (s: string) => data.sales.filter((x) => idx.get(norm(x.city))?.slug === s);
const rt = site.rankings.realtrends, google = reviewData.summary.google;
const base = '/real-estate-agents';
const href = (s: string) => `${base}/${s}-mn`;

// ----- one city -----
const c = slug ? communities.find((x) => x.slug === slug) : undefined;
const sales = c ? salesBy(c.slug) : [];
const prices = sales.map((s) => s.price);
const years = [...new Set(sales.map((s) => s.date.slice(0, 4)))].sort().reverse().map((y) => { const l = sales.filter((s) => s.date.startsWith(y)); return { y, n: l.length, med: median(l.map((s) => s.price)) }; });
const BANDS: [string, number, number][] = [['Under $300,000', 0, 300000], ['$300,000 to $450,000', 300000, 450000], ['$450,000 to $700,000', 450000, 700000], ['$700,000 to $1 million', 700000, 1000000], ['$1 million and up', 1000000, Infinity]];
const bands = BANDS.map(([label, lo, hi]) => ({ label, n: sales.filter((s) => s.price >= lo && s.price < hi).length })).filter((b) => b.n);
const agentCounts = teamAgents.map((a) => ({ ...a, n: sales.filter((s) => s.agents.includes(a.slug)).length })).filter((a) => a.n).sort((a, b) => b.n - a.n);
const isRtCity = c && norm(c.name) === norm(rt.cityName);
const rank = isRtCity ? `RealTrends ranks the team #${rt.city} in ${rt.cityName} and #${rt.state} in Minnesota by sales (${rt.year})` : `RealTrends ranks the team #${rt.state} in Minnesota by sales (${rt.year})`;
const answer = c ? (complete && sales.length
  ? `Huerkamp Home Group agents listed and sold ${sales.length} ${sales.length === 1 ? 'home' : 'homes'} in ${c.name}, MN in the last 3 years (since ${sinceText}), at a median sale price of ${money(median(prices))}, according to NorthstarMLS. ${rank}, and the team has a ${google.rating.toFixed(1)}-star rating from ${google.count} Google reviews.`
  : `Huerkamp Home Group is a Twin Cities real estate team of ${teamAgents.length} agents that helps buyers and sellers in ${c.name}, MN. ${rank}, and the team has a ${google.rating.toFixed(1)}-star rating from ${google.count} Google reviews.`) : '';
const reviews = (reviewData.reviews as any[]).filter((r) => r.textComplete === true && Number(r.rating) === 5);
const local = c ? reviews.filter((r) => new RegExp(`\\b${c.name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}\\b`, 'i').test(r.text)) : [];
const shownReviews = (local.length ? local : reviews.filter((r) => r.text.length > 140 && r.text.length < 600)).slice(0, 3);
const faq = c ? [
  { q: `Who are the top real estate agents in ${c.name}, MN?`, a: answer },
  ...(complete && sales.length ? [{ q: `How many homes has Huerkamp Home Group sold in ${c.name}?`, a: `${sales.length} in the last 3 years (since ${sinceText}): homes the team's agents listed that sold, from NorthstarMLS as of ${asOf}.${years.length ? ` By year: ${years.map((y) => `${y.y}, ${y.n}`).join('; ')}.` : ''} Homes the team helped buyers purchase aren't included, so the team's total in ${c.name} is higher.` }] : []),
  ...(agentCounts.length ? [{ q: `Which Huerkamp Home Group agents have sold homes in ${c.name}?`, a: `${agentCounts.slice(0, 6).map((a) => `${a.name} (${a.n})`).join(', ')}, counting homes listed under their own name that sold in the last 3 years (NorthstarMLS). Most team listings are listed under the team name, The Huerkamp Home Group.` }] : []),
  { q: `How do I choose a real estate agent in ${c.name}?`, a: `Ask how many homes the agent has sold in ${c.name} and at what prices, how they'll market your home or find you one before it hits the websites, and read their reviews. Interview two or three. The team's record above comes straight from the MLS, and you can call ${site.phone} to talk to an agent.` },
] : [];
const ld = c ? JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', url: `${origin}${href(c.slug)}`, mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }) : '';

// ----- hub -----
const hubRows = communities.map((x) => ({ x, l: salesBy(x.slug) })).filter((r) => r.l.length >= MIN).sort((a, b) => b.l.length - a.l.length);
const hubAnswer = complete ? `Huerkamp Home Group agents listed and sold ${data.sales.length.toLocaleString('en-US')} homes in the last 3 years (since ${sinceText}), according to NorthstarMLS: here's where, city by city. ${rank}.` : `Where Huerkamp Home Group sells homes, city by city, from NorthstarMLS. ${rank}.`;

const title = c ? `${c.name}, MN Real Estate Agents: Huerkamp Home Group${complete && sales.length ? ` (${sales.length} Homes Sold)` : ''}` : 'Our Home Sales by City | Huerkamp Home Group';
const description = (c ? answer : hubAnswer).slice(0, 300);
const crumbs = [{ name: 'Our sales by city', href: base }, ...(c ? [{ name: c.name, href: href(c.slug) }] : [])];
---
<Base breadcrumbs={crumbs} title={c ? `${title} | ${site.name}` : title} description={description} noindex={data.mode !== 'live' || !complete}>
  {ld && <script slot="head" type="application/ld+json" set:html={ld} />}

  <section class="nhead">
    <div class="wrap">
      <p class="eyebrow">{c ? `${c.name} · Huerkamp Home Group` : 'Huerkamp Home Group'}</p>
      <h1>{c ? `${c.name}, MN real estate agents` : 'Our home sales, city by city'}</h1>
      <p class="answer">{c ? answer : hubAnswer}</p>
      <p class="hero-btns"><a class="btn" href="#talk">Talk to an agent</a> <a class="btn btn--ghost" href={site.phoneHref}>Call or text {site.phone}</a></p>
    </div>
  </section>

  {c && (
    <section class="section section--paper">
      <div class="wrap">
        <ul class="facts">
          {complete && sales.length > 0 && <li><strong>{sales.length}</strong><span>homes listed and sold in {c.name}, last 3 years</span></li>}
          {complete && sales.length > 0 && <li><strong>{money(median(prices))}</strong><span>median sale price</span></li>}
          <li><strong>#{isRtCity ? rt.city : rt.state}</strong><span>{isRtCity ? `team in ${rt.cityName}` : 'team in Minnesota'} (RealTrends, {rt.year})</span></li>
          <li><strong>{google.rating.toFixed(1)}★</strong><span>{google.count} Google reviews</span></li>
        </ul>
        <p class="source">Sales: NorthstarMLS, homes listed by Huerkamp Home Group agents (Keller Williams Preferred Realty) that sold since {sinceText}, as of {asOf}. Buyer-side sales aren't counted. Ranking: <a href={rt.url} rel="noopener">{rt.source}</a>, {rt.year} sales. Reviews: <a href={google.url} rel="noopener">Google</a>, as of {fmtDay(google.asOf)}.</p>

        {complete && sales.length > 0 && (
          <div class="twocol">
            <div>
              <h2 class="h3">By year</h2>
              <div class="table-scroll"><table class="data">
                <thead><tr><th scope="col">Year</th><th scope="col" class="num">Homes sold</th><th scope="col" class="num">Median price</th></tr></thead>
                <tbody>{years.map((y) => <tr><th scope="row">{y.y}{y.y === new Date().getFullYear().toString() ? ' (so far)' : ''}</th><td class="num">{y.n}</td><td class="num">{money(y.med)}</td></tr>)}</tbody>
              </table></div>
            </div>
            <div>
              <h2 class="h3">By sale price</h2>
              <div class="table-scroll"><table class="data">
                <thead><tr><th scope="col">Sale price</th><th scope="col" class="num">Homes sold</th></tr></thead>
                <tbody>{bands.map((b) => <tr><th scope="row">{b.label}</th><td class="num">{b.n}</td></tr>)}</tbody>
              </table></div>
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  {c && agentCounts.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="head"><p class="eyebrow">Our agents in {c.name}</p><h2>Who has sold homes in {c.name}</h2>
          <p>Homes each agent listed under their own name that sold in the last 3 years. Most of the team's listings are listed under the team name, so they're in the total above but not here.</p></div>
        <ul class="chips">{agentCounts.map((a) => <li><a href={`/team/${a.slug}`}>{a.name} <span class="n">{a.n}</span></a></li>)}</ul>
      </div>
    </section>
  )}

  {c && shownReviews.length > 0 && (
    <section class="section section--paper">
      <div class="wrap">
        <div class="head"><p class="eyebrow">Reviews</p><h2>{local.length ? `What ${c.name} clients say` : 'What clients say'}</h2></div>
        <div class="quotes">{shownReviews.map((r) => <blockquote><p>{r.text}</p><footer>{r.reviewer}, {r.source} review</footer></blockquote>)}</div>
        <p class="source"><a href="/reviews">All reviews</a></p>
      </div>
    </section>
  )}

  {!c && (
    <section class="section">
      <div class="wrap">
        {hubRows.length ? (
          <div class="table-scroll"><table class="data">
            <thead><tr><th scope="col">City</th><th scope="col" class="num">Homes listed and sold, 3 years</th><th scope="col" class="num">Median sale price</th></tr></thead>
            <tbody>{hubRows.map((r) => <tr><th scope="row"><a href={href(r.x.slug)}>{r.x.name}</a></th><td class="num">{r.l.length}</td><td class="num">{money(median(r.l.map((s) => s.price)))}</td></tr>)}</tbody>
          </table></div>
        ) : <p>The city-by-city counts will be back with the next update.</p>}
        <p class="source">NorthstarMLS, homes listed by Huerkamp Home Group agents that sold since {sinceText}, as of {asOf}; cities with at least {MIN} sales. Buyer-side sales aren't counted.</p>
      </div>
    </section>
  )}

  <section class="section section--dark" id="talk" aria-labelledby="talk-title">
    <div class="wrap split">
      <div class="prose">
        <p class="eyebrow">{c ? `Buying or selling in ${c.name}?` : 'Buying or selling?'}</p>
        <h2 id="talk-title">Talk to an agent <em>who sells here.</em></h2>
        <p>Tell us what you're planning. An agent who knows {c ? c.name : 'your area'} will call you, with no obligation.</p>
        <p>Call or text <a href={site.phoneHref}>{site.phone}</a>.</p>
      </div>
      <form class="form" data-lead="community-contact">
        <input type="hidden" name="community" value={c ? c.name : 'Our sales by city'} />
        <div class="form__row">
          <div class="field"><label for="ra-first">First name</label><input id="ra-first" name="firstName" autocomplete="given-name" required /></div>
          <div class="field"><label for="ra-last">Last name</label><input id="ra-last" name="lastName" autocomplete="family-name" required /></div>
        </div>
        <div class="form__row">
          <div class="field"><label for="ra-email">Email</label><input id="ra-email" name="email" type="email" autocomplete="email" required /></div>
          <div class="field"><label for="ra-phone">Phone</label><input id="ra-phone" name="phone" type="tel" autocomplete="tel" required pattern="[^0-9]*([0-9][^0-9]*){10,}" title="Please enter your phone number, including area code." /></div>
        </div>
        <div class="field">
          <label for="ra-goal">I'm looking to</label>
          <select id="ra-goal" name="goal"><option value="">Choose one</option><option>Sell my home</option><option>Buy a home</option><option>Buy and sell</option><option>Just get a home value</option></select>
        </div>
        <div class="field"><label for="ra-msg">Anything else (optional)</label><textarea id="ra-msg" name="message" rows="3"></textarea></div>
        <button class="btn" type="submit">Send</button>
        <p class="form__status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  {c && (
    <section class="section">
      <div class="wrap faq">
        <div class="head"><p class="eyebrow">Quick answers</p><h2>Choosing a {c.name} real estate agent</h2></div>
        {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
        <HomeValueBox city={c.name} />
        <p class="links"><a class="link-arrow" href={`/communities/${c.slug}`}>Living in {c.name}</a><a class="link-arrow" href="/sell">Selling with us</a><a class="link-arrow" href={base}>Our sales in other cities</a></p>
      </div>
    </section>
  )}
</Base>

<style>
  .nhead { padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(2rem, 4vw, 3rem); background: var(--night); color: var(--on-dark); }
  .nhead h1 { font: 500 clamp(2.2rem, 5vw, 3.6rem)/1.05 var(--serif-display); color: #fff; }
  .nhead .eyebrow { color: var(--rose); }
  .answer { max-width: 52rem; margin: .9rem 0 .4rem; color: #fff; font: 500 clamp(1.05rem, 2.2vw, 1.25rem)/1.5 var(--ui); }
  .hero-btns { display: flex; flex-wrap: wrap; gap: .65rem; margin-top: 1.25rem; }
  .head { margin-bottom: 1.25rem; }
  .facts { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr)); gap: 1rem; }
  .facts li { display: grid; gap: .2rem; padding: 1rem 1.2rem; background: var(--surface, #fff); border: 1px solid var(--line); }
  .facts strong { font: 600 1.6rem/1.1 var(--serif); }
  .facts span { color: var(--text-soft); font-size: .9rem; }
  .source { margin-top: .8rem; font-size: .9rem; color: var(--text-soft); }
  .twocol { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); gap: 2rem; margin-top: 2rem; }
  .h3 { margin: 0 0 .8rem; font: 500 1.35rem/1.2 var(--serif); }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .5rem; }
  .chips a { display: inline-flex; gap: .4rem; align-items: center; padding: .5rem .8rem; border: 1px solid var(--line); background: #fff; color: var(--text); font: 500 .9rem/1.2 var(--ui); text-decoration: none; }
  .chips a:hover { border-color: var(--crimson); color: var(--crimson); }
  .chips .n { font-weight: 700; color: var(--crimson); }
  .quotes { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); gap: 1rem; }
  .quotes blockquote { margin: 0; padding: 1.1rem 1.25rem; background: #fff; border: 1px solid var(--line); }
  .quotes p { margin: 0 0 .6rem; line-height: 1.55; }
  .quotes footer { color: var(--text-soft); font-size: .88rem; }
  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  @media (max-width: 900px) { .split { grid-template-columns: 1fr; } }
  .split .prose a { color: #fff; font-weight: 700; }
  .split :global(em) { font-style: italic; }
  .faq { display: grid; gap: .75rem; max-width: 52rem; }
  .faq details { padding: 1rem 1.2rem; background: var(--paper); border: 1px solid var(--line); }
  .faq summary { cursor: pointer; font: 600 1.15rem/1.3 var(--serif); }
  .links { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; margin-top: 1rem; }
</style>
