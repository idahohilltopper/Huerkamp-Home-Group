---
// Site shell: utility bar, header with drop-down menus (and a phone menu), footer.
// Layout after markzproperties.com; branding, text and code are Huerkamp Home Group's own.
// Fonts are self-hosted (no request to Google); the ones used at the top of most pages are preloaded
// so headings don't jump when the font arrives.
import { OWN, homeSearchHref, SEARCH_PATH } from '../data/search';
import FavDialog from '../components/FavDialog.astro';
import { LICENSED_IN, EULA_PATH } from '../data/mls';
import '@fontsource-variable/figtree/wght.css';
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-600.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/cormorant-garamond/latin-500-italic.css';
import figtreeFont from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';
import cormorantFont from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-400-normal.woff2?url';
import cormorantItalic from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-italic.woff2?url';
import cormorantMedium from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-normal.woff2?url';
import '../styles/global.css';
import { site } from '../data/site';
import { business, website } from '../data/schema';
import { agentDirectory } from '../data/agents';
import { listingsData } from '../data/listings';
import { consentText, submitNotice } from '../lib/consent.mjs';

interface Crumb { name: string; href: string }
interface Props {
  title: string;
  description: string;
  image?: string;
  /** Trail from the home page to this page, e.g. [{ name: 'Communities', href: '/communities' }, { name: 'Edina', href: '/communities/edina' }] */
  breadcrumbs?: Crumb[];
  noindex?: boolean;
  /** Blog posts: publish/update dates for social and search previews. */
  article?: { published: Date; modified?: Date };
  /** A shared tablet (the open house sign-in): no site menus, no Google Analytics or Meta Pixel (one device, many
   *  people, so nothing can be tied to one person), and the page forgets each visitor after they sign in. */
  kiosk?: boolean;
}
const { title: fullTitle, description: fullDescription, image = '/brand/og-default.jpg', breadcrumbs = [], noindex = false, article, kiosk = false } = Astro.props;
// Google shows about 60–70 characters of a title and 155–160 of a description. A long title drops the
// " | Huerkamp Home Group" ending (the brand is still in the site name Google shows); a long description is cut at a word.
const title = fullTitle.length > 70 ? fullTitle.replace(/ \| Huerkamp Home Group( Blog)?$/, '') : fullTitle;
const description = fullDescription.length > 160 ? `${fullDescription.slice(0, 157).replace(/[\s,;:.]+\S*$/, '')}…` : fullDescription;
const { phone, phoneHref } = site;
const origin = Astro.site ?? 'https://www.huerkamphomes.com';
// Pages build to /team.html but are served at /team, so drop the .html (and /index) from the address.
const canonical = new URL(Astro.url.pathname.replace(/(\/index)?\.html$/, '').replace(/(.)\/$/, '$1') || '/', origin).href;
const ogImage = new URL(image, origin).href;
const siteLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': [website, business] });
const crumbLd = breadcrumbs.length > 0 && JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [{ name: 'Home', href: '/' }, ...breadcrumbs].map((c, i) => ({
    '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.href, origin).href,
  })),
});
const year = new Date().getFullYear();
// "Homes for sale" pages exist only once the MLS feed is switched on (src/data/listings.ts).
const homesData = await listingsData;
const homesForSale = homesData.mode !== 'off' && homesData.listings.length > 0;

// A town in the Communities menu opens the map search for that town (its homes on the map, the town outlined); its
// community guide is one click away from there and from "All community guides". Without the site's own search, the guide.
const town = (slug: string) => (OWN ? `${SEARCH_PATH}?place=${slug}&view=map` : `/communities/${slug}`);
const menu = [
  { label: 'Communities', href: '/communities', items: [
    ['All community guides', '/communities'], ['Minneapolis', town('minneapolis')], ['Saint Paul', town('saint-paul')],
    ['Bloomington', town('bloomington')], ['Burnsville', town('burnsville')], ['Eagan', town('eagan')],
    ['Edina', town('edina')], ['Lakeville', town('lakeville')], ['Plymouth', town('plymouth')],
    ['Woodbury', town('woodbury')], ['Area guides: compare places', '/guides'], ['Compare two cities', '/compare'], ['Commute times', '/commute'], ['Most walkable places', '/walkability'], ['Diners, Drive-Ins and Dives', '/diners-drive-ins-and-dives-minnesota'], ['Lake homes', '/lake-homes'],
  ] },
  { label: 'Homes', href: homesForSale ? '/homes-for-sale' : homeSearchHref, items: [
    ...(homesForSale ? [['Homes for sale by city', '/homes-for-sale'], ['Open houses', '/open-houses']] : []), ['Search all homes', homeSearchHref], ['Buy a home', '/buy'], ['First-time buyer programs', '/first-time-home-buyer-minnesota'], ['Down payment assistance', '/down-payment-assistance-minnesota'], ['Cost of living in Minnesota', '/cost-of-living-minnesota'], ['Minneapolis suburbs compared', '/minneapolis-suburbs'], ['Pending vs. contingent', '/buying/listing-status-meanings'], ['Veterans & VA loans', '/buying/veterans-and-military-home-buyers-minnesota'], ['Lake homes', '/lake-homes'], ['Brainerd lake homes', '/lake-homes/brainerd'], ['Balsam & Bone Lake (WI)', '/lake-homes/polk-county-wi'], ...(homesForSale ? [['Greater Minnesota towns', '/minnesota-homes-for-sale']] : []), ...(homesForSale ? [['New construction', '/new-construction'], ['Land and lots', '/land-for-sale'], ['Hobby farms & acreage', '/hobby-farms-for-sale-mn'], ['Luxury homes ($1M+)', '/luxury-homes-for-sale-mn'], ['Townhomes', '/townhomes-for-sale-mn'], ['Condos', '/condos-for-sale-mn'], ['Duplexes & multi-family', '/duplexes-for-sale-mn'], ['Barndominiums', '/barndominiums-for-sale-mn'], ['Tiny homes', '/tiny-homes-for-sale-mn'], ['Mid-century modern', '/mid-century-modern-homes-for-sale'], ['Historic homes', '/historic-homes-for-sale']] : []), ['Investment property', '/invest'], ['Market reports', '/market'], ['Housing data', '/data'], ['Affordability calculator', '/calculators/affordability'], ['Rent vs. buy', '/calculators/rent-vs-buy'], ['Foreclosures & short sales', '/foreclosure/buying-foreclosures'],
  ] },
  { label: 'Sell', href: '/sell', items: [
    ['Sell your home', '/sell'], ['Free home valuation', '/sell#value'], ['Get a cash offer', '/cash-offer'], ['Listing expired?', '/expired-listing'], ['Sell now or wait for spring?', '/when-to-sell'], ['Net proceeds calculator', '/calculators/seller-net-proceeds'], ['What’s required to sell', '/selling-in-minnesota'], ['Downsizing & 55+', '/downsizing'], ['Selling it yourself (FSBO)', '/for-sale-by-owner'], ['Short sales & foreclosure help', '/foreclosure'],
  ] },
  { label: 'Team', href: '/team' },
  { label: 'Ramsey ELP', href: '/ramsey' },
  { label: 'Reviews', href: '/reviews' },
  { label: 'Videos', href: '/videos', items: [
    ['All videos', '/videos'], ['Market updates', '/videos#market-updates'], ['Suburbs & neighborhoods', '/videos#suburbs-neighborhoods'],
    ['Shorts', '/videos#shorts'], ['Blog', '/blog'], ['YouTube channel', 'https://www.youtube.com/@livinginminneapolis'],
  ] },
  { label: 'Contact', href: '/contact' },
] as { label: string; href: string; items?: [string, string][] }[];

const footerCols = [
  { title: 'Communities', links: [['Minneapolis', '/communities/minneapolis'], ['Saint Paul', '/communities/saint-paul'], ['Burnsville', '/communities/burnsville'], ['Lakeville', '/communities/lakeville'], ['Eagan', '/communities/eagan'], ['Apple Valley', '/communities/apple-valley'], ['Edina', '/communities/edina'], ['Area guides', '/guides'], ['Compare cities', '/compare'], ['Commute times', '/commute'], ['Most walkable places', '/walkability'], ['All communities', '/communities']] },
  { title: 'Homes', links: [...(homesForSale ? [['Homes for sale by city', '/homes-for-sale'], ['Open houses', '/open-houses']] : []), ['Search all homes', homeSearchHref], ['Buy a home', '/buy'], ['Lake homes', '/lake-homes'], ['Investment property', '/invest'], ['Market reports', '/market'], ['Housing data', '/data'], ['Calculators', '/calculators']] },
  { title: 'Sell', links: [['Sell your home', '/sell'], ['Free home valuation', '/sell#value'], ['Get a cash offer', '/cash-offer'], ['Listing expired?', '/expired-listing'], ['Downsizing & 55+', '/downsizing'], ['Selling a parent’s home', '/downsizing/selling-a-parents-home'], ['Sell now or wait for spring?', '/when-to-sell'], ['Cost to sell in Minnesota', '/selling/cost-to-sell-a-house-in-minnesota'], ['Cash offer or list?', '/selling/cash-offer-vs-listing'], ['Selling in probate', '/downsizing/selling-a-house-in-probate-minnesota'], ['What’s required to sell', '/selling-in-minnesota'], ['Sell by owner (FSBO)', '/for-sale-by-owner'], ['Short sales & foreclosure', '/foreclosure']] },
  { title: 'Company', links: [['Our team', '/team'], ['Our sales by city', '/real-estate-agents'], ['Join our team: agent careers', site.joinUrl], ['Ramsey ELP', '/ramsey'], ['Reviews', '/reviews'], ['Videos', '/videos'], ['Blog', '/blog'], ['Contact', '/contact']] },
];
const isExternal = (href: string) => href.startsWith('http');
// Google shows about 60 characters of a title. A longer one drops the " | Huerkamp Home Group" ending (the brand is
// still in the page, the logo and the structured data) so the words that describe the page stay visible.
const brandEnd = ` | ${site.name}`;
const pageTitle = title.length > 60 && title.endsWith(brandEnd) ? title.slice(0, -brandEnd.length) : title;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <!-- A listing opened inside the map search's panel (src/scripts/home-search.ts) shows without the site's header and footer. -->
  <script is:inline>if (/[?&]embed=1\b/.test(location.search) && window.top !== window.self) document.documentElement.classList.add('is-embed');</script>
  <!-- Error reporting (netlify/functions/client-error.mjs): errors visitors' browsers hit on our own scripts are sent
       (message, page path, browser family; nothing personal), at most 5 per page view. A page left open across a deploy
       asks for script files that no longer exist; that page reloads itself once instead of half-working. -->
  <script is:inline>(function(){var n=0,own=location.origin;
    function stale(m){return /dynamically imported module|Importing a module script failed|error loading dynamically imported|Failed to fetch dynamically|Unable to preload CSS/i.test(m||'')}
    function report(kind,msg,src,line){try{if(n++>=5||!msg)return;if(src&&src.indexOf(own)!==0&&src.indexOf('/')!==0)return;if(/ResizeObserver loop|^Script error\.?$|MetaMask|ethereum|web3|due to access control checks|Load failed|AbortError|chrome-extension:|moz-extension:|safari-extension:/i.test(msg))return;
      var b=JSON.stringify({kind:kind,msg:String(msg).slice(0,300),src:src||'',line:line||0,page:location.pathname,width:innerWidth});
      if(navigator.sendBeacon)navigator.sendBeacon('/api/client-error',new Blob([b],{type:'application/json'}));else fetch('/api/client-error',{method:'POST',body:b,keepalive:true});}catch(e){}}
    function reloadOnce(msg){try{var k='hhg-reloaded',t=+sessionStorage.getItem(k)||0;if(Date.now()-t>600000){sessionStorage.setItem(k,String(Date.now()));report('stale',msg,'',0);location.reload();return true}}catch(e){}return false}
    window.hhgReport=report;window.hhgReloadOnce=reloadOnce;
    // A lead form sent before the page's scripts are ready (a slow phone, a listing with many photos) would fall back
    // to the browser's own form handling: the page reloads, the request is lost and the details land in the address.
    // Hold it instead; the form script sends it as soon as it's ready (window.hhgLeadReady).
    document.addEventListener('submit',function(e){var f=e.target;if(!window.hhgLeadReady&&f&&f.matches&&f.matches('form[data-lead]')){e.preventDefault();e.stopImmediatePropagation();var q=window.hhgLeadQueue=window.hhgLeadQueue||[];if(q.indexOf(f)<0)q.push(f);}},true);
    addEventListener('error',function(e){if(e.target&&e.target!==window&&e.target.tagName==='SCRIPT'&&/\/_astro\//.test(e.target.src||'')){if(!reloadOnce('script failed: '+e.target.src))report('script',e.target.src,e.target.src,0);return}
      if(e.message)report('error',e.message,e.filename,e.lineno)},true);
    addEventListener('unhandledrejection',function(e){var r=e.reason,m=r&&(r.message||String(r));if(stale(m)&&reloadOnce(m))return;report('promise',m,r&&r.stack&&(String(r.stack).match(/https?:\/\/[^\s)]+/)||[''])[0],0)});
    addEventListener('vite:preloadError',function(e){if(reloadOnce('preload: '+(e.payload&&e.payload.message)))e.preventDefault()});
  })();</script>
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content={article ? 'article' : 'website'} />
  {article && <meta property="article:published_time" content={article.published.toISOString()} />}
  {article?.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content="en_US" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#1f1b1c" />
  <link rel="icon" type="image/png" sizes="48x48" href="/brand/favicon-48.png" />
  <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preload" href={figtreeFont} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={cormorantFont} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={cormorantItalic} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={cormorantMedium} as="font" type="font/woff2" crossorigin />
  <script type="application/ld+json" set:html={siteLd} />
  {crumbLd && <script type="application/ld+json" set:html={crumbLd} />}
  <script is:inline>try{if(/(?:^|; )idx_eula=1(?:;|$)/.test(document.cookie)||sessionStorage.getItem('idx-eula')==='1')document.documentElement.classList.add('idx-ok')}catch(e){}</script>
  {kiosk && <script is:inline>window.hhgKiosk = true; document.documentElement.classList.add('is-embed', 'is-kiosk');</script>}
  {site.ga4 && <script is:inline define:vars={{ id: site.ga4, kiosk }}>
    // Google Analytics 4, live domains only, and not when the visitor turned analytics off on /cookies or the browser
    // sends a Global Privacy Control signal. The library loads after the page has, so it never slows it down.
    let off = navigator.globalPrivacyControl === true || kiosk;
    try { off = off || localStorage.getItem('hhg-analytics') === 'denied'; } catch (e) {}
    if (!off && /(^|\.)huerkamphome(group|s)\.com$/.test(location.hostname)) {
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { dataLayer.push(arguments); };
      gtag('js', new Date());
      gtag('config', id);
      addEventListener('load', () => setTimeout(() => {
        const s = document.createElement('script'); s.async = true; s.src = 'https://www.googletagmanager.com/gtag/js?id=' + id; document.head.append(s);
      }, 1500));
    }
  </script>}
  {site.metaPixel && <script is:inline define:vars={{ px: site.metaPixel, kiosk }}>
    // Meta Pixel (Facebook/Instagram ads and retargeting, like Ylopo's): page views; ViewContent for each home viewed (its
    // MLS number as the catalog id, so ads can show people the homes they looked at; /feeds/meta-home-listings.csv);
    // Search on the map search; AddToWishlist for a heart; CompleteRegistration for a sign-up; Lead for every other form
    // (with the same event id the server's Conversions API copy uses, src/lib/meta.mjs). A visitor we know (they sent a
    // form) is matched by their email and name, which the pixel hashes in the browser. Same rules as Google Analytics
    // above: live domains only, off when the visitor turned analytics off on /cookies or the browser sends Global
    // Privacy Control (then the server copy is off too: window.hhgAdsOff), loaded after the page.
    let pxOff = navigator.globalPrivacyControl === true || kiosk;
    try { pxOff = pxOff || localStorage.getItem('hhg-analytics') === 'denied'; } catch (e) {}
    window.hhgAdsOff = pxOff;
    if (!pxOff && /(^|\.)huerkamphome(group|s)\.com$/.test(location.hostname)) {
      const n = window.fbq = function () { n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments); };
      if (!window._fbq) window._fbq = n;
      n.push = n; n.loaded = true; n.version = '2.0'; n.queue = [];
      let who = null;
      try { who = JSON.parse(localStorage.getItem('hhg-fav-me') || 'null'); } catch (e) {}
      const match = (w) => (w && w.email ? Object.fromEntries(Object.entries({ em: w.email, fn: w.firstName, ln: w.lastName, ph: (w.phone || '').replace(/\D/g, '') || undefined, st: 'mn', country: 'us' }).filter(([, v]) => v)) : {});
      fbq('init', px, match(who));
      fbq('track', 'PageView');
      const home = (h) => {
        if (!h || !h.mls) return;
        const price = Number(String(h.price || '').replace(/[^0-9.]/g, '')) || undefined;
        fbq('track', 'ViewContent', Object.fromEntries(Object.entries({ content_ids: [String(h.mls)], content_type: 'home_listing', city: h.city, region: 'Minnesota', country: 'United States', postal_code: h.zip, value: price, currency: price ? 'USD' : undefined }).filter(([, v]) => v !== undefined && v !== '')));
      };
      addEventListener('DOMContentLoaded', () => {
        const b = document.querySelector('.fav--big[data-fav]');
        if (b) home({ mls: b.dataset.fav, city: b.dataset.favCity, zip: b.dataset.favZip, price: b.dataset.favPrice });
      });
      addEventListener('home-viewed', (e) => home(e.detail));
      addEventListener('home-saved', (e) => { const d = e.detail || {}; if (d.mls) fbq('track', 'AddToWishlist', { content_ids: [String(d.mls)], content_type: 'home_listing' }, d.eid ? { eventID: d.eid } : undefined); });
      let searchTimer, lastSearch = '';
      addEventListener('home-searched', (e) => {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => { const s = e.detail && e.detail.summary; if (s && s !== lastSearch) { lastSearch = s; fbq('track', 'Search', { search_string: s }); } }, 5000);
      });
      addEventListener('load', () => setTimeout(() => {
        const s = document.createElement('script'); s.async = true; s.src = 'https://connect.facebook.net/en_US/fbevents.js'; document.head.append(s);
      }, 1500));
      addEventListener('lead-sent', (e) => {
        const d = e.detail || {}, f = d.form, fl = d.fields || {};
        if (!f) return;
        if (fl.email && !(who && who.email)) { who = fl; fbq('init', px, match(fl)); } // now we know who this is
        const ev = f === 'register' ? 'CompleteRegistration' : f === 'favorite' ? 'AddToWishlist' : f === 'showing' ? 'Schedule' : 'Lead';
        const params = { content_name: f === 'register' ? 'Buyer Account Registration' : f === 'home-value' ? 'Seller Home Valuation Request' : f };
        if (fl.propMls) Object.assign(params, { content_ids: [String(fl.propMls)], content_type: 'home_listing' });
        fbq('track', ev, params, d.eid ? { eventID: d.eid } : undefined);
      });
    }
  </script>}
  <slot name="head" />
</head>
<body data-privacy={site.privacyUrl} data-consent={consentText()} data-submit-notice={submitNotice}>
  <a class="skip" href="#main">Skip to content</a>
  <div class="utility">
    <div class="utility__inner">
      <p><span aria-hidden="true">★</span> Dave Ramsey Endorsed Local Provider for 15+ years</p>
      <p class="utility__right"><span class="utility__kw">{site.brokerage}</span><a href={phoneHref}>{phone}</a>{OWN && <a href="/account" data-acct>Sign in</a>}<a class="utility__join" href={site.joinUrl} rel="noopener">Join HHG</a></p>
    </div>
  </div>

  <header class="nav">
    <div class="nav__inner">
      <a class="brand" href="/" aria-label="Huerkamp Home Group home">
        <picture>
          <source srcset="/brand/hhg-mark.webp" type="image/webp" />
          <img src="/brand/hhg-mark.png" alt="" width="82" height="56" />
        </picture>
        <span class="brand__name">Huerkamp<br />Home Group</span>
      </a>

      <nav class="menu" aria-label="Main">
        <ul class="menu__list">
          {menu.map((m) => (
            <li class={m.items ? 'menu__item has-sub' : 'menu__item'}>
              <a href={m.href} {...(isExternal(m.href) ? { rel: 'noopener' } : {})}>{m.label}{m.items && <span class="caret" aria-hidden="true">▾</span>}</a>
              {m.items && (
                <ul class="sub">
                  {m.items.map(([l, h]) => <li><a href={h} {...(isExternal(h) ? { rel: 'noopener' } : {})}>{l}</a></li>)}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </nav>

      <a class="btn nav__cta" href="/sell#value">Free Home Valuation</a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="mobile-menu">
        <span class="burger__bars" aria-hidden="true"></span><span class="visually-hidden">Menu</span>
      </button>
    </div>

    <div class="mobile" id="mobile-menu" hidden>
      <nav aria-label="Main (mobile)">
        {menu.map((m) => (
          <div class="mobile__group">
            <a class="mobile__top" href={m.href}>{m.label}</a>
            {m.items && <ul>{m.items.map(([l, h]) => <li><a href={h}>{l}</a></li>)}</ul>}
          </div>
        ))}
        <a class="btn mobile__cta" href="/sell#value">Free Home Valuation</a>
        <a class="mobile__phone" href={phoneHref}>Call {phone}</a>
        {OWN && <a class="mobile__phone" href="/account" data-acct>Sign in</a>}
        <a class="btn btn--ghost mobile__join" href={site.joinUrl} rel="noopener">Join HHG: careers for agents</a>
      </nav>
    </div>
  </header>

  <!-- "Working with" an agent: shown after a visitor arrives through an agent's site (filled in by the script below). -->
  <div class="agentbar" id="agentbar" hidden></div>
  <script type="application/json" id="agent-dir" set:html={JSON.stringify(agentDirectory)} />

  <main id="main">
    <slot />
    {OWN && <FavDialog />}
    <script>
      import { listenForLeads } from '../scripts/register';
      import { signedIn, me } from '../scripts/session';
      import { initHot } from '../scripts/hot';
      listenForLeads();
      initHot();
      // Signed in (email-link sign-in): "Sign in" becomes "My account", and lead forms come filled in.
      if (signedIn()) document.querySelectorAll<HTMLAnchorElement>('[data-acct]').forEach((a) => { a.textContent = 'My account'; a.href = '/profile'; });
      const who = me();
      if (who?.email) document.querySelectorAll<HTMLFormElement>('form[data-lead]').forEach((form) => {
        for (const [name, v] of [['firstName', who.firstName], ['lastName', who.lastName], ['email', who.email], ['phone', who.phone]] as const) {
          const input = form.elements.namedItem(name);
          if (input instanceof HTMLInputElement && !input.value && v) input.value = v;
        }
      });
    </script>
  </main>

  <footer class="footer">
    <div class="wrap footer__top">
      <div class="footer__brand">
        <picture>
          <source srcset="/brand/hhg-logo-reverse.webp" type="image/webp" />
          <img src="/brand/hhg-logo-reverse.png" alt="Huerkamp Home Group" width="206" height="100" loading="lazy" />
        </picture>
        <p>Helping Twin Cities families buy and sell homes since 2002.</p>
        <address>
          {site.street}<br />{site.cityStateZip}<br />
          <a href={phoneHref}>{phone}</a><br />
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </address>
      </div>
      {footerCols.map((col) => (
        <div class="footer__col">
          <p class="footer__title">{col.title}</p>
          <ul>{col.links.map(([l, h]) => <li><a href={h}>{l}</a></li>)}</ul>
        </div>
      ))}
    </div>
    <div class="wrap footer__legal">
      <p>© {year} {site.name}. {site.brokerage}. Each office independently owned and operated. Licensed in {LICENSED_IN}.</p>
      <p><svg class="eho" viewBox="0 0 32 32" width="22" height="22" role="img" aria-label="Equal Housing Opportunity logo"><path d="M16 3 2 13.5h3.5V29h21V13.5H30z" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linejoin="miter"/><path d="M10.5 16.5h11M10.5 22h11" stroke="currentColor" stroke-width="3"/></svg> Equal Housing Opportunity. Skyline photo: <a href="https://commons.wikimedia.org/wiki/File:Downtown_Minneapolis_skyline_across_the_Mississippi_River.jpg">Guywelch2000</a>, <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>, power lines removed. Home page photo: <a href="https://commons.wikimedia.org/wiki/File:Minneapolis_Sunset.jpg">BpA9543</a>, <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>. <a href={site.facebookUrl} rel="noopener">Facebook</a> · <a href={site.youtubeUrl} rel="noopener">YouTube</a> · <a href={site.profiles.instagram} rel="noopener">Instagram</a> · <a href={site.profiles.zillow} rel="noopener">Zillow reviews</a> · <a href={site.profiles.linkedin} rel="noopener">LinkedIn</a> · <a href={site.privacyUrl}>Privacy policy</a> · <a href="/cookies">Manage cookies</a> · <a href="/sms-terms">SMS terms</a>{OWN && <> · <a href={EULA_PATH}>Listing license agreement</a></>}</p>
    </div>
  </footer>

  <script>
    // NorthstarMLS End-User License Agreement (src/pages/license-agreement.astro): before any listing data shows
    // ([data-idx] blocks), the visitor clicks I AGREE once per visit; until then listings stay covered. A "visit" is the
    // browser session: a cookie with no expiry date (shared by every tab, cleared when the browser closes), so links
    // opened in new tabs, such as alert emails, don't ask again. The EULA grants access "for the duration of the
    // current viewing session", so don't give it a longer life without NorthstarMLS's written OK.
    const agree = () => {
      try { sessionStorage.setItem('idx-eula', '1'); document.cookie = 'idx_eula=1; path=/; SameSite=Lax; Secure'; } catch {}
      document.documentElement.classList.add('idx-ok');
      document.querySelectorAll('.idx-lock').forEach((el) => el.remove());
      window.dispatchEvent(new Event('idx-agreed'));
    };
    if (!document.documentElement.classList.contains('idx-ok')) {
      document.querySelectorAll<HTMLElement>('[data-idx]').forEach((box) => {
        const lock = document.createElement('div');
        lock.className = 'idx-lock';
        lock.innerHTML = '<div class="idx-lock__box" role="group" aria-label="Listing license agreement"><p><strong>Homes for sale</strong></p>'
          + '<p>To view listings, please read and agree to the <a href="/license-agreement" target="_blank" rel="noopener">license agreement</a>. We ask once per visit.</p>'
          + '<button type="button" class="btn">I AGREE</button></div>';
        lock.querySelector('button')!.addEventListener('click', agree);
        box.prepend(lock);
      });
    }

    // Phone menu.
    const burger = document.querySelector<HTMLButtonElement>('.burger');
    const panel = document.getElementById('mobile-menu');
    if (burger && panel) {
      const set = (open: boolean) => { burger.setAttribute('aria-expanded', String(open)); panel.hidden = !open; document.body.classList.toggle('menu-open', open); };
      burger.addEventListener('click', () => set(burger.getAttribute('aria-expanded') !== 'true'));
      panel.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) set(false); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
    }

    // Agent sites: a visitor who opens an agent's pages (/team/<slug>…) or a link with ?agent=<slug> is working with
    // that agent for 30 days. Their forms anywhere on the site are assigned to the agent (src/lib/lead.mjs).
    const AGENT_KEY = 'hhg-agent', DAYS30 = 30 * 864e5;
    const dir = JSON.parse(document.getElementById('agent-dir')?.textContent ?? '{}');
    const store = {
      get: () => { try { const v = JSON.parse(localStorage.getItem(AGENT_KEY) ?? 'null'); return v && Date.now() - v.at < DAYS30 && dir[v.slug] ? v.slug : null; } catch { return null; } },
      set: (slug: string | null) => { try { slug ? localStorage.setItem(AGENT_KEY, JSON.stringify({ slug, at: Date.now() })) : localStorage.removeItem(AGENT_KEY); } catch {} },
    };
    const fromUrl = new URLSearchParams(location.search).get('agent') ?? location.pathname.match(/^\/team\/([a-z0-9-]+)/)?.[1];
    if (fromUrl && dir[fromUrl]) store.set(fromUrl);
    const working = store.get();
    const bar = document.getElementById('agentbar');
    if (working && bar) {
      const a = dir[working];
      const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
      bar.innerHTML = `<div class="agentbar__inner"><img src="${esc(a.photo)}" alt="" width="32" height="32" /><span>You're working with <a href="${esc(a.href)}">${esc(a.name)}</a></span><a class="agentbar__tel" href="tel:+1${a.phone.replace(/\D/g, '')}">${esc(a.phone)}</a><button type="button" aria-label="Stop working with ${esc(a.first)}">×</button></div>`;
      bar.hidden = false;
      bar.querySelector('button')?.addEventListener('click', () => { store.set(null); bar.hidden = true; });
    }

    // Forms: send to Follow Up Boss through /api/lead (netlify/functions/lead.mjs).
    // The bot filter (src/lib/lead.mjs) drops a form sent under 2.5 s after the visitor arrived. Count from when the page
    // started loading (performance.now()), not from when this script ran: on a slow phone a person can fill in a form while
    // the page is still loading, and a form held until the scripts are ready (hhgLeadQueue) used to go out at ~0 s and be
    // dropped silently as a bot (found Nov 11, 2026).
    const loadedAt = Date.now();
    document.querySelectorAll<HTMLFormElement>('form[data-lead]').forEach((form) => {
      form.dataset.privacy = document.body.dataset.privacy;
      // Hidden field people never see; bots that fill every field get ignored.
      form.insertAdjacentHTML('beforeend', '<div class="visually-hidden" aria-hidden="true"><label>Leave empty<input name="website_url" tabindex="-1" autocomplete="off"></label></div>');
      // Call/text consent (opt-in, never pre-checked, never required) and what submitting means, just above the
      // submit button. The wording lives in src/lib/consent.mjs; the lead records the same words.
      const linked = (document.body.dataset.consent ?? '')
        .replace('SMS Terms', '<a href="/sms-terms">SMS Terms</a>')
        .replace('Privacy Policy', `<a href="${form.dataset.privacy}">Privacy Policy</a>`);
      form.querySelector('button[type="submit"]')?.insertAdjacentHTML('beforebegin',
        `<label class="consent"><input type="checkbox" name="smsConsent" value="yes"> <span>${linked}</span></label>` +
        `<p class="consent__privacy">${document.body.dataset.submitNotice ?? ''}</p>`);
      const status = form.querySelector<HTMLElement>('[role="status"]') ?? form.nextElementSibling as HTMLElement | null;
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
        const { website_url: hp = '', ...fields } = data;
        const agentNow = store.get();
        if (agentNow && !fields.agentSlug) fields.agentSlug = agentNow;
        if (button) { button.disabled = true; button.dataset.label = button.textContent ?? ''; button.textContent = 'Sending…'; }
        if (status) status.textContent = '';
        // One id for this lead, shared by the browser's Meta Pixel event and the server's copy so Facebook counts it once.
        const eid = (crypto as any).randomUUID?.() ?? `${Date.now()}-${Math.random().toString(36).slice(2)}`;
        try {
          const res = await fetch('/api/lead', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ form: form.dataset.lead, fields, hp, elapsed: Math.max(Date.now() - loadedAt, Math.round(performance.now())), page: location.pathname, title: document.title, eid, ads: !(window as any).hhgAdsOff }),
          });
          if (!res.ok) throw new Error(String(res.status));
          form.reset();
          if (status) status.textContent = "Thank you! We got your message and an agent will reach out shortly.";
          // Other scripts can follow up on a sent lead (favorites: src/scripts/favorites.ts).
          window.dispatchEvent(new CustomEvent('lead-sent', { detail: { form: form.dataset.lead, fields, el: form, eid } }));
          // New-listing alert forms (with the site's own MLS search on) also save the search at Repliers, which then
          // emails matching new homes (netlify/functions/alerts.mjs).
          if (form.dataset.alertQuery) {
            const r = await fetch('/api/alerts/save', { method: 'POST', headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ firstName: fields.firstName, lastName: fields.lastName, email: fields.email, phone: fields.phone,
                frequency: fields.alertFrequency || 'daily', name: form.dataset.alertName ?? '', query: JSON.parse(form.dataset.alertQuery) }) }).catch(() => null);
            const a = r ? await r.json().catch(() => ({})) : {};
            if (status) status.textContent = a.ok
              ? `You're all set! We'll email new homes that match to ${fields.email}${fields.alertFrequency === 'instant' ? ' as soon as they’re listed' : fields.alertFrequency === 'weekly' ? ' once a week' : ' once a day'}. Every email has a link to change or stop your alerts.`
              : `Thank you! An agent got your search, but the automatic emails couldn't be set up${a.error && a.error !== 'mls-error' && a.error !== 'not-configured' ? `: ${a.error}` : ' right now (the listing service didn’t accept it). An agent will set them up for you'}.`;
          }
          // GA4's recommended lead event; mark it as a key event in Google Analytics (Admin > Events) to count leads.
          (window as any).gtag?.('event', 'generate_lead', { form_name: form.dataset.lead, page_path: location.pathname });
        } catch {
          if (status) status.textContent = `Sorry, that didn't go through. Please call or text ${form.dataset.phone ?? '(612) 502-7653'}.`;
        } finally {
          if (button) { button.disabled = false; button.textContent = button.dataset.label ?? 'Send'; }
        }
      });
    });
    // Forms are ready: send anything submitted while the page was still loading (the early guard in the page head).
    (window as any).hhgLeadReady = true;
    for (const f of ((window as any).hhgLeadQueue ?? []) as HTMLFormElement[]) f.requestSubmit ? f.requestSubmit() : f.dispatchEvent(new Event('submit', { cancelable: true }));
    (window as any).hhgLeadQueue = [];

    // YouTube players: swap the thumbnail for the real player on click.
    document.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('.yt__link');
      const box = link?.parentElement;
      if (!link || !box?.dataset.yt) return;
      e.preventDefault();
      const frame = Object.assign(document.createElement('iframe'), {
        src: `https://www.youtube-nocookie.com/embed/${box.dataset.yt}?autoplay=1&rel=0`,
        title: box.dataset.title ?? 'Video',
        allow: 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture',
        allowFullscreen: true,
      });
      box.replaceChildren(frame);
    });
  </script>
<style is:global>
  [data-idx] { position: relative; }
  html:not(.idx-ok) [data-idx] > :not(.idx-lock) { filter: blur(7px); pointer-events: none; user-select: none; }
  .idx-lock { position: absolute; inset: 0; z-index: 5; display: grid; justify-items: center; align-content: start; padding: 2rem 1rem; background: rgba(250, 247, 242, .45); }
  .idx-lock__box { position: sticky; top: 7rem; max-width: 30rem; padding: 1.25rem 1.5rem; border: 1px solid var(--line); background: #fff; text-align: center; box-shadow: 0 10px 30px rgba(0,0,0,.12); }
  .idx-lock__box p { margin: 0 0 .6rem; }
</style>
  <script is:inline>
    // Inside the map search's listing panel: other homes open in the panel; everything else opens in the main window.
    if (document.documentElement.classList.contains('is-embed')) document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a[href]');
      if (!a || a.getAttribute('href').charAt(0) === '#') return;
      if (a.getAttribute('href').indexOf('/homes/') === 0) { a.href = a.getAttribute('href') + (a.getAttribute('href').indexOf('?') < 0 ? '?embed=1' : '&embed=1'); return; }
      a.target = '_top';
    }, true);
  </script>
</body>
</html>

<style>
