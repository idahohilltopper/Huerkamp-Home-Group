  @media (max-width: 900px) { .utility__kw { display: none; } }
  @media (max-width: 560px) { .utility__inner > p:first-child { display: none; } .utility__inner { justify-content: center; } }

  /* Header */
  .nav { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 20; background: var(--cream); border-bottom: 1px solid var(--line); box-shadow: 0 6px 18px rgba(0,0,0,.04); }
  .nav__inner { max-width: 84rem; margin-inline: auto; padding: .6rem var(--gutter); display: flex; align-items: center; gap: 1.5rem; }
