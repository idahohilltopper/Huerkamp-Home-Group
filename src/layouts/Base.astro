  .menu__item { position: relative; }
  .menu__item > a { display: block; padding: .9rem .7rem; font: 500 .92rem/1 var(--ui); color: var(--ink); text-decoration: none; letter-spacing: .02em; }
  .menu__item > a:hover, .menu__item:focus-within > a { color: var(--crimson); }
  .caret { margin-left: .25rem; font-size: .7rem; color: var(--crimson); }
  .sub { list-style: none; margin: 0; padding: .5rem 0; position: absolute; left: 0; top: 100%; min-width: 14rem; background: var(--paper); border: 1px solid var(--line); border-top: 2px solid var(--crimson); box-shadow: 0 16px 32px rgba(0,0,0,.08); opacity: 0; visibility: hidden; transform: translateY(4px); transition: opacity .15s, transform .15s, visibility .15s; }
  .has-sub:hover .sub, .has-sub:focus-within .sub { opacity: 1; visibility: visible; transform: none; }
  .sub a { display: block; padding: .55rem 1.1rem; font: 500 .92rem/1.3 var(--ui); color: var(--ink); text-decoration: none; }
  .sub a:hover { background: var(--sand); color: var(--crimson); }
  .nav__cta { padding: .85rem 1.2rem; font-size: .8rem; flex-shrink: 0; }

  .burger { display: none; margin-left: auto; width: 2.75rem; height: 2.75rem; border: 1px solid var(--line); background: var(--paper); cursor: pointer; }
  .burger__bars, .burger__bars::before, .burger__bars::after { display: block; width: 1.2rem; height: 2px; background: var(--ink); margin: 0 auto; position: relative; transition: transform .2s; }
  .burger__bars::before, .burger__bars::after { content: ""; position: absolute; left: 0; }
  .burger__bars::before { top: -6px; } .burger__bars::after { top: 6px; }
  .burger[aria-expanded="true"] .burger__bars { background: transparent; }
  .burger[aria-expanded="true"] .burger__bars::before { transform: translateY(6px) rotate(45deg); }
  .burger[aria-expanded="true"] .burger__bars::after { transform: translateY(-6px) rotate(-45deg); }

  .mobile { border-top: 1px solid var(--line); background: var(--cream); max-height: calc(100vh - 7rem); overflow-y: auto; }
  .mobile nav { max-width: 40rem; margin-inline: auto; padding: 1rem var(--gutter) 2rem; display: grid; gap: .25rem; }
  .mobile__group { padding: .6rem 0; border-bottom: 1px solid var(--line); }
  .mobile__top { font: 500 1.35rem/1.3 var(--serif); color: var(--ink); text-decoration: none; }
  .mobile__group ul { list-style: none; margin: .4rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: .35rem .9rem; }
  .mobile__group ul a { font-size: .95rem; color: var(--ink-soft); text-decoration: none; }
  .mobile__cta { margin-top: 1rem; }
  .mobile__phone { text-align: center; padding: .75rem; font-weight: 600; color: var(--ink); }

  @media (max-width: 1180px) { .menu, .nav__cta { display: none; } .burger { display: block; } }
  @media (min-width: 1181px) { .mobile { display: none !important; } }

  /* Footer */
  .footer { background: var(--night-deep); color: var(--on-dark-soft); font-size: .95rem; }
  .footer__top { display: grid; grid-template-columns: 1.6fr repeat(4, 1fr); gap: 2rem; padding-block: 4rem 3rem; }
  @media (max-width: 960px) { .footer__top { grid-template-columns: repeat(2, minmax(0, 1fr)); } .footer__brand { grid-column: 1 / -1; } }
  .footer__brand { display: grid; gap: 1rem; align-content: start; }
  .footer__brand img { width: 12.5rem; height: auto; }
  .footer address { font-style: normal; line-height: 1.7; }
  .footer__title { font: 700 .75rem/1 var(--ui); letter-spacing: .2em; text-transform: uppercase; color: var(--on-dark); margin-bottom: 1rem; }
  .footer__col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .55rem; }
  .footer a { color: var(--on-dark-soft); text-decoration: none; }
  .footer a:hover { color: #fff; }
  .footer__legal { display: grid; gap: .4rem; padding-block: 1.5rem 2rem; border-top: 1px solid rgba(255,255,255,.1); font-size: .82rem; }
  .footer__legal a { text-decoration: underline; }
</style>
