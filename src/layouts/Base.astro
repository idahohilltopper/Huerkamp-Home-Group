---
// Site shell: utility bar, header with drop-down menus (and a phone menu), footer.
// Layout after markzproperties.com; branding, text and code are Huerkamp Home Group's own.
// Fonts are self-hosted (no request to Google); the ones used at the top of most pages are preloaded
// so headings don't jump when the font arrives.
import '@fontsource-variable/figtree/wght.css';
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-600.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/cormorant-garamond/latin-500-italic.css';
import figtreeFont from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';
import cormorantFont from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-400-normal.woff2?url';
import cormorantItalic from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-italic.woff2?url';
import cormorantMedium from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-normal.woff2?url';
import '../styles/global.css';
import { site } from '../data/site';
import { business, website } from '../data/schema';

interface Crumb { name: string; href: string }
interface Props {
  title: string;
  description: string;
  image?: string;
  /** Trail from the home page to this page, e.g. [{ name: 'Communities', href: '/communities' }, { name: 'Edina', href: '/communities/edina' }] */
  breadcrumbs?: Crumb[];
  noindex?: boolean;
  /** Blog posts: publish/update dates for social and search previews. */
  article?: { published: Date; modified?: Date };
}
const { title, description, image = '/brand/og-default.jpg', breadcrumbs = [], noindex = false, article } = Astro.props;
const { phone, phoneHref } = site;
const origin = Astro.site ?? 'https://www.huerkamphomegroup.com';
// Pages build to /team.html but are served at /team, so drop the .html (and /index) from the address.
const canonical = new URL(Astro.url.pathname.replace(/(\/index)?\.html$/, '').replace(/(.)\/$/, '$1') || '/', origin).href;
const ogImage = new URL(image, origin).href;
const siteLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': [website, business] });
const crumbLd = breadcrumbs.length > 0 && JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [{ name: 'Home', href: '/' }, ...breadcrumbs].map((c, i) => ({
    '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.href, origin).href,
  })),
});
const year = new Date().getFullYear();

const menu = [
  { label: 'Communities', href: '/communities', items: [
    ['All communities', '/communities'], ['Minneapolis', '/communities/minneapolis'], ['Saint Paul', '/communities/saint-paul'],
    ['Bloomington', '/communities/bloomington'], ['Burnsville', '/communities/burnsville'], ['Eagan', '/communities/eagan'],
    ['Edina', '/communities/edina'], ['Lakeville', '/communities/lakeville'], ['Plymouth', '/communities/plymouth'],
    ['Woodbury', '/communities/woodbury'], ['Lake homes', '/lake-homes'],
  ] },
  { label: 'Homes', href: site.searchUrl, items: [
    ['Search all homes', site.searchUrl], ['Buy a home', '/buy'], ['Lake homes', '/lake-homes'], ['Investment property', '/invest'], ['Market reports', '/market'],
  ] },
  { label: 'Sell', href: '/sell', items: [
    ['Sell your home', '/sell'], ['Free home valuation', '/sell#value'], ['Get a cash offer', '/sell#cash'],
  ] },
  { label: 'Team', href: '/team' },
  { label: 'Ramsey ELP', href: '/ramsey' },
  { label: 'Reviews', href: '/reviews' },
  { label: 'Videos', href: '/videos', items: [
    ['All videos', '/videos'], ['Market updates', '/videos#market-updates'], ['Suburbs & neighborhoods', '/videos#suburbs-neighborhoods'],
    ['Shorts', '/videos#shorts'], ['Blog', '/blog'], ['YouTube channel', 'https://www.youtube.com/@livinginminneapolis'],
  ] },
  { label: 'Contact', href: '/contact' },
] as { label: string; href: string; items?: [string, string][] }[];

const footerCols = [
  { title: 'Communities', links: [['Minneapolis', '/communities/minneapolis'], ['Saint Paul', '/communities/saint-paul'], ['Burnsville', '/communities/burnsville'], ['Lakeville', '/communities/lakeville'], ['Eagan', '/communities/eagan'], ['Apple Valley', '/communities/apple-valley'], ['Edina', '/communities/edina'], ['All communities', '/communities']] },
  { title: 'Homes', links: [['Search all homes', site.searchUrl], ['Buy a home', '/buy'], ['Lake homes', '/lake-homes'], ['Investment property', '/invest'], ['Market reports', '/market']] },
  { title: 'Sell', links: [['Sell your home', '/sell'], ['Free home valuation', '/sell#value'], ['Get a cash offer', '/sell#cash']] },
  { title: 'Company', links: [['Our team', '/team'], ['Ramsey ELP', '/ramsey'], ['Reviews', '/reviews'], ['Videos', '/videos'], ['Blog', '/blog'], ['Contact', '/contact']] },
];
const isExternal = (href: string) => href.startsWith('http');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content={article ? 'article' : 'website'} />
  {article && <meta property="article:published_time" content={article.published.toISOString()} />}
  {article?.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content="en_US" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#1f1b1c" />
  <link rel="icon" type="image/png" sizes="48x48" href="/brand/favicon-48.png" />
  <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preload" href={figtreeFont} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={cormorantFont} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={cormorantItalic} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={cormorantMedium} as="font" type="font/woff2" crossorigin />
  <script type="application/ld+json" set:html={siteLd} />
  {crumbLd && <script type="application/ld+json" set:html={crumbLd} />}
  <slot name="head" />
</head>
<body data-privacy={site.privacyUrl}>
  <a class="skip" href="#main">Skip to content</a>
  <div class="utility">
    <div class="utility__inner">
      <p><span aria-hidden="true">★</span> Dave Ramsey Endorsed Local Provider for 15+ years</p>
      <p class="utility__right"><span class="utility__kw">{site.brokerage}</span><a href={phoneHref}>{phone}</a></p>
    </div>
  </div>

  <header class="nav">
    <div class="nav__inner">
      <a class="brand" href="/" aria-label="Huerkamp Home Group home">
        <picture>
          <source srcset="/brand/hhg-mark.webp" type="image/webp" />
          <img src="/brand/hhg-mark.png" alt="" width="82" height="56" />
        </picture>
        <span class="brand__name">Huerkamp<br />Home Group</span>
      </a>

      <nav class="menu" aria-label="Main">
        <ul class="menu__list">
          {menu.map((m) => (
            <li class={m.items ? 'menu__item has-sub' : 'menu__item'}>
              <a href={m.href} {...(isExternal(m.href) ? { rel: 'noopener' } : {})}>{m.label}{m.items && <span class="caret" aria-hidden="true">▾</span>}</a>
              {m.items && (
                <ul class="sub">
                  {m.items.map(([l, h]) => <li><a href={h} {...(isExternal(h) ? { rel: 'noopener' } : {})}>{l}</a></li>)}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </nav>

      <a class="btn nav__cta" href="/sell#value">Free Home Valuation</a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="mobile-menu">
        <span class="burger__bars" aria-hidden="true"></span><span class="visually-hidden">Menu</span>
      </button>
    </div>

    <div class="mobile" id="mobile-menu" hidden>
      <nav aria-label="Main (mobile)">
        {menu.map((m) => (
          <div class="mobile__group">
            <a class="mobile__top" href={m.href}>{m.label}</a>
            {m.items && <ul>{m.items.map(([l, h]) => <li><a href={h}>{l}</a></li>)}</ul>}
          </div>
        ))}
        <a class="btn mobile__cta" href="/sell#value">Free Home Valuation</a>
        <a class="mobile__phone" href={phoneHref}>Call {phone}</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="footer">
    <div class="wrap footer__top">
      <div class="footer__brand">
        <picture>
          <source srcset="/brand/hhg-logo-reverse.webp" type="image/webp" />
          <img src="/brand/hhg-logo-reverse.png" alt="Huerkamp Home Group" width="206" height="100" loading="lazy" />
        </picture>
        <p>Helping Twin Cities families buy and sell homes since 2002.</p>
        <address>
          {site.street}<br />{site.cityStateZip}<br />
          <a href={phoneHref}>{phone}</a><br />
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </address>
      </div>
      {footerCols.map((col) => (
        <div class="footer__col">
          <p class="footer__title">{col.title}</p>
          <ul>{col.links.map(([l, h]) => <li><a href={h}>{l}</a></li>)}</ul>
        </div>
      ))}
    </div>
    <div class="wrap footer__legal">
      <p>© {year} {site.name}. {site.brokerage}. Each office independently owned and operated.</p>
      <p><span aria-hidden="true">⌂</span> Equal Housing Opportunity. Skyline photo: <a href="https://commons.wikimedia.org/wiki/File:Downtown_Minneapolis_skyline_across_the_Mississippi_River.jpg">Guywelch2000</a>, <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>. <a href={site.facebookUrl} rel="noopener">Facebook</a> · <a href={site.youtubeUrl} rel="noopener">YouTube</a> · <a href={site.privacyUrl} rel="noopener">Privacy policy</a></p>
    </div>
  </footer>

  <script>
    // Phone menu.
    const burger = document.querySelector<HTMLButtonElement>('.burger');
    const panel = document.getElementById('mobile-menu');
    if (burger && panel) {
      const set = (open: boolean) => { burger.setAttribute('aria-expanded', String(open)); panel.hidden = !open; document.body.classList.toggle('menu-open', open); };
      burger.addEventListener('click', () => set(burger.getAttribute('aria-expanded') !== 'true'));
      panel.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) set(false); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
    }

    // Forms: send to Follow Up Boss through /api/lead (netlify/functions/lead.mjs).
    const loadedAt = Date.now();
    document.querySelectorAll<HTMLFormElement>('form[data-lead]').forEach((form) => {
      form.dataset.privacy = document.body.dataset.privacy;
      // Hidden field people never see; bots that fill every field get ignored.
      form.insertAdjacentHTML('beforeend', '<div class="visually-hidden" aria-hidden="true"><label>Leave empty<input name="website_url" tabindex="-1" autocomplete="off"></label></div>');
      // Text-message consent (opt-in) and privacy notice, placed just above the submit button.
      form.querySelector('button[type="submit"]')?.insertAdjacentHTML('beforebegin',
        `<label class="consent"><input type="checkbox" name="smsConsent" value="yes"> <span>Yes, ${form.dataset.brand ?? 'Huerkamp Home Group'} may text me about my real estate questions. Message frequency varies; message and data rates may apply. Reply STOP to opt out. Not required to submit.</span></label>` +
        `<p class="consent__privacy">By submitting, you agree we may contact you about your inquiry. See our <a href="${form.dataset.privacy}" rel="noopener">privacy policy</a>.</p>`);
      const status = form.querySelector<HTMLElement>('[role="status"]') ?? form.nextElementSibling as HTMLElement | null;
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
        const { website_url: hp = '', ...fields } = data;
        if (button) { button.disabled = true; button.dataset.label = button.textContent ?? ''; button.textContent = 'Sending…'; }
        if (status) status.textContent = '';
        try {
          const res = await fetch('/api/lead', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ form: form.dataset.lead, fields, hp, elapsed: Date.now() - loadedAt, page: location.pathname, title: document.title }),
          });
          if (!res.ok) throw new Error(String(res.status));
          form.reset();
          if (status) status.textContent = "Thank you! We got your message and an agent will reach out shortly.";
          (window as any).dataLayer?.push({ event: 'lead_submitted', form: form.dataset.lead });
        } catch {
          if (status) status.textContent = `Sorry, that didn't go through. Please call or text ${form.dataset.phone ?? '(612) 843-9620'}.`;
        } finally {
          if (button) { button.disabled = false; button.textContent = button.dataset.label ?? 'Send'; }
        }
      });
    });

    // YouTube players: swap the thumbnail for the real player on click.
    document.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('.yt__link');
      const box = link?.parentElement;
      if (!link || !box?.dataset.yt) return;
      e.preventDefault();
      const frame = Object.assign(document.createElement('iframe'), {
        src: `https://www.youtube-nocookie.com/embed/${box.dataset.yt}?autoplay=1&rel=0`,
        title: box.dataset.title ?? 'Video',
        allow: 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture',
        allowFullscreen: true,
      });
      box.replaceChildren(frame);
    });
  </script>
</body>
</html>

<style>
  .skip { position: absolute; left: -999px; top: 0; z-index: 50; padding: .75rem 1rem; background: var(--crimson); color: #fff; }
  .skip:focus { left: 8px; top: 8px; }
  [hidden] { display: none !important; }

  /* Utility bar */
  .utility { background: var(--night-deep); color: var(--on-dark); font: 600 .72rem/1.2 var(--ui); letter-spacing: .14em; text-transform: uppercase; }
  .utility__inner { max-width: 84rem; margin-inline: auto; padding: .6rem var(--gutter); display: flex; justify-content: space-between; gap: 1rem; }
  .utility span[aria-hidden] { color: #c99a2e; margin-right: .35rem; }
  .utility__right { display: flex; gap: 1.5rem; }
  .utility a { color: var(--on-dark); text-decoration: none; border-bottom: 1px solid var(--crimson); }
  .utility__kw { color: var(--on-dark-soft); }
  @media (max-width: 900px) { .utility__kw { display: none; } }
  @media (max-width: 560px) { .utility__inner > p:first-child { display: none; } .utility__inner { justify-content: center; } }

  /* Header */
  .nav { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 20; background: var(--cream); border-bottom: 1px solid var(--line); box-shadow: 0 6px 18px rgba(0,0,0,.04); }
  .nav__inner { max-width: 84rem; margin-inline: auto; padding: .6rem var(--gutter); display: flex; align-items: center; gap: 1.5rem; }
  .brand { display: flex; align-items: center; gap: .65rem; text-decoration: none; color: var(--charcoal); flex-shrink: 0; }
  .brand img { height: 3.1rem; width: auto; }
  .brand__name { font: 600 .82rem/1.15 var(--serif); letter-spacing: .16em; text-transform: uppercase; color: var(--charcoal); }

  .menu { margin-left: auto; }
  .menu__list { list-style: none; margin: 0; padding: 0; display: flex; gap: .25rem; }
  .menu__item { position: relative; }
  .menu__item > a { display: block; padding: .9rem .7rem; font: 500 .92rem/1 var(--ui); color: var(--ink); text-decoration: none; letter-spacing: .02em; }
  .menu__item > a:hover, .menu__item:focus-within > a { color: var(--crimson); }
  .caret { margin-left: .25rem; font-size: .7rem; color: var(--crimson); }
  .sub { list-style: none; margin: 0; padding: .5rem 0; position: absolute; left: 0; top: 100%; min-width: 14rem; background: var(--paper); border: 1px solid var(--line); border-top: 2px solid var(--crimson); box-shadow: 0 16px 32px rgba(0,0,0,.08); opacity: 0; visibility: hidden; transform: translateY(4px); transition: opacity .15s, transform .15s, visibility .15s; }
  .has-sub:hover .sub, .has-sub:focus-within .sub { opacity: 1; visibility: visible; transform: none; }
  .sub a { display: block; padding: .55rem 1.1rem; font: 500 .92rem/1.3 var(--ui); color: var(--ink); text-decoration: none; }
  .sub a:hover { background: var(--sand); color: var(--crimson); }
  .nav__cta { padding: .85rem 1.2rem; font-size: .8rem; flex-shrink: 0; }

  .burger { display: none; margin-left: auto; width: 2.75rem; height: 2.75rem; border: 1px solid var(--line); background: var(--paper); cursor: pointer; }
  .burger__bars, .burger__bars::before, .burger__bars::after { display: block; width: 1.2rem; height: 2px; background: var(--ink); margin: 0 auto; position: relative; transition: transform .2s; }
  .burger__bars::before, .burger__bars::after { content: ""; position: absolute; left: 0; }
  .burger__bars::before { top: -6px; } .burger__bars::after { top: 6px; }
  .burger[aria-expanded="true"] .burger__bars { background: transparent; }
  .burger[aria-expanded="true"] .burger__bars::before { transform: translateY(6px) rotate(45deg); }
  .burger[aria-expanded="true"] .burger__bars::after { transform: translateY(-6px) rotate(-45deg); }

  .mobile { border-top: 1px solid var(--line); background: var(--cream); max-height: calc(100vh - 7rem); overflow-y: auto; }
  .mobile nav { max-width: 40rem; margin-inline: auto; padding: 1rem var(--gutter) 2rem; display: grid; gap: .25rem; }
  .mobile__group { padding: .6rem 0; border-bottom: 1px solid var(--line); }
  .mobile__top { font: 500 1.35rem/1.3 var(--serif); color: var(--ink); text-decoration: none; }
  .mobile__group ul { list-style: none; margin: .4rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: .35rem .9rem; }
  .mobile__group ul a { font-size: .95rem; color: var(--ink-soft); text-decoration: none; }
  .mobile__cta { margin-top: 1rem; }
  .mobile__phone { text-align: center; padding: .75rem; font-weight: 600; color: var(--ink); }

  @media (max-width: 1180px) { .menu, .nav__cta { display: none; } .burger { display: block; } }
  @media (min-width: 1181px) { .mobile { display: none !important; } }

  /* Footer */
  .footer { background: var(--night-deep); color: var(--on-dark-soft); font-size: .95rem; }
  .footer__top { display: grid; grid-template-columns: 1.6fr repeat(4, 1fr); gap: 2rem; padding-block: 4rem 3rem; }
  @media (max-width: 960px) { .footer__top { grid-template-columns: repeat(2, minmax(0, 1fr)); } .footer__brand { grid-column: 1 / -1; } }
  .footer__brand { display: grid; gap: 1rem; align-content: start; }
  .footer__brand img { width: 12.5rem; height: auto; }
  .footer address { font-style: normal; line-height: 1.7; }
  .footer__title { font: 700 .75rem/1 var(--ui); letter-spacing: .2em; text-transform: uppercase; color: var(--on-dark); margin-bottom: 1rem; }
  .footer__col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .55rem; }
  .footer a { color: var(--on-dark-soft); text-decoration: none; }
  .footer a:hover { color: #fff; }
  .footer__legal { display: grid; gap: .4rem; padding-block: 1.5rem 2rem; border-top: 1px solid rgba(255,255,255,.1); font-size: .82rem; }
  .footer__legal a { text-decoration: underline; }
</style>
